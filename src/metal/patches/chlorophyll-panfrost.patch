index 4c7d2f6..a0aabf4 100644
--- a/test/bg_render.metal
+++ b/test/bg_render.metal
@@ -3,6 +3,10 @@
 #include <metal_stdlib>
 using namespace metal;
 
+#ifndef BG_PROBE_BASIC
+#define BG_PROBE_BASIC 0
+#endif
+
 struct V { float4 pos [[position]]; float4 color; float2 uv; };
 
 // positions and colours from buffer(0): float4 pos, float4 color per vertex (stride 32)
@@ -15,6 +19,7 @@ vertex V bg_vs(uint vid [[vertex_id]], device const float4 *data [[buffer(0)]])
    return v;
