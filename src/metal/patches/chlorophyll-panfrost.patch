+{
+   float2 a = abs(in.t);
+   float len = sqrt(dot(a, a));
+   float mx = max(a.x, a.y), mn = min(a.x, a.y);
+   float r = mx == 0.0f ? 0.0f : saturate(mn / mx);
+   float p = ((((3.1560099f - r * 0.92605400f) * r - 3.6412201f) * r + 1.2680300f) * r + 0.26853099f) * (r * r);
+   float e1 = len + 1.0f - 1.0f / (1.0f - p);
+   float2 q = max(float2(0.0f), a * 1.5286649f - 0.52866501f);
+   float e2 = sqrt(dot(q, q)) * 0.65416557f + 0.34583443f;
+   float m = mix(e1, e2, a.y > a.x ? u.w.x : u.w.y);
+   float d = float(half(m - 1.0f));
+   float fw = fwidth(d + 1.0f);
+   float cov = saturate(0.5f - d / max(fw, 0.0001f));
+   return float4(cov, d, fw, len);
+}
