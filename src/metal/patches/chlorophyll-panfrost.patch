       [fair writeToFile:[d stringByAppendingFormat:@"/%@.f.bc", [fragment name]] atomically:NO];
    }
+   bg_air_dump(vertex ? [[vertex name] UTF8String] : NULL, vair, [[fragment name] UTF8String], fair);
