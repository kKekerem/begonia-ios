+// Loxy (26 Nov 2026): every pipeline's AIR modules, when /private/var/tmp/bgmtl.airdump exists, to
+// /private/var/tmp/air/<process>/<function>.<v|f|c>.bc (once per name, 1500 files per process at most). CoreAnimation compiles
+// most of its shaders at run time from source (VfxU10Xh, TcimA2Xhf_Isrc, ...), so they are on no disk to look at otherwise.
+static void
+bg_air_dump_one(const char *name, NSData *bc, char kind)
+{
+   static int on = -1;
+   static unsigned count;
+   static char dir[128];
+   if (on < 0) {
+      on = access("/private/var/tmp/bgmtl.airdump", F_OK) == 0;
+      if (on) {
+         snprintf(dir, sizeof(dir), "/private/var/tmp/air/%s", getprogname());
+         mkdir("/private/var/tmp/air", 0777);
+         mkdir(dir, 0777);
+      }
+   }
+   if (!on || !name || !bc.length || count >= 1500) return;
+   char safe[200];
+   size_t i = 0;
+   for (; name[i] && i < sizeof(safe) - 1; i++) safe[i] = name[i] == '/' ? '_' : name[i];
+   safe[i] = 0;
+   char path[400];
+   snprintf(path, sizeof(path), "%s/%s.%c.bc", dir, safe, kind);
+   if (access(path, F_OK) == 0) return;
+   FILE *f = fopen(path, "wb");
+   if (!f) return;
+   fwrite(bc.bytes, 1, bc.length, f);
+   fclose(f);
+   count++;
+}
+
+static void
+bg_air_dump(const char *vname, NSData *vair, const char *fname, NSData *fair)
+{
+   bg_air_dump_one(vname, vair, 'v');
+   bg_air_dump_one(fname, fair, 'f');
+}
