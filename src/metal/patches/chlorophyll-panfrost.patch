@@ -45,3 +50,45 @@ fragment float4 bg_fs_tex3(V in [[stage_in]], texture2d<float> t [[texture(3)]],
 // a fragment stage with the varyings of CoreAnimation's std_vert0_*: color (float4) and texcoord0_0 (float2)
 struct CAV { float4 pos [[position]]; float4 color; float2 texcoord0_0; };
 fragment float4 bg_fs_ca_color(CAV in [[stage_in]]) { return in.color; }
+
+#endif
+
+// Loxy (26 Nov 2026): rounded corners came out square or chamfered. CoreAnimation draws a continuous (superellipse)
+// corner as a quad whose vertices carry a corner coordinate t (-1..1, its texcoord0A) and computes the coverage per
+// pixel from t with an fwidth edge. These stages repeat that computation and write the intermediate values, so the
+// probe can tell which step the translation gets wrong.
+struct CV { float4 pos [[position]]; float2 t; half4 color; };
+
+vertex CV bg_vs_corner(uint vid [[vertex_id]], device const float4 *data [[buffer(0)]])
+{
+   CV v;
+   v.pos = float4(data[vid].xy, 0, 1);
+   v.t = data[vid].zw;
+   v.color = half4(1, 1, 1, 1);
+   return v;
+}
+
+// interpolation and derivatives: t.x, t.y, fwidth(16 t.x), dfdx(16 t.y)
+fragment float4 bg_fs_deriv(CV in [[stage_in]])
+{
+   return float4(in.t.x, in.t.y, fwidth(in.t.x * 16.0f), dfdx(in.t.y * 16.0f));
+}
+
+struct CU { float4 w; };
+// coverage, the signed distance d, fwidth(d + 1), |t|
+fragment float4 bg_fs_sup(CV in [[stage_in]], constant CU &u [[buffer(1)]])
+{
+   float2 a = abs(in.t);
+   float len = sqrt(dot(a, a));
+   float mx = max(a.x, a.y), mn = min(a.x, a.y);
+   float r = mx == 0.0f ? 0.0f : saturate(mn / mx);
+   float p = ((((3.1560099f - r * 0.92605400f) * r - 3.6412201f) * r + 1.2680300f) * r + 0.26853099f) * (r * r);
+   float e1 = len + 1.0f - 1.0f / (1.0f - p);
+   float2 q = max(float2(0.0f), a * 1.5286649f - 0.52866501f);
+   float e2 = sqrt(dot(q, q)) * 0.65416557f + 0.34583443f;
+   float m = mix(e1, e2, a.y > a.x ? u.w.x : u.w.y);
+   float d = float(half(m - 1.0f));
+   float fw = fwidth(d + 1.0f);
+   float cov = saturate(0.5f - d / max(fw, 0.0001f));
+   return float4(cov, d, fw, len);
+}
