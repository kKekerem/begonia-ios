diff --git a/src/gallium/targets/osmesa/sweet_hw.c b/src/gallium/targets/osmesa/sweet_hw.c
new file mode 100644
index 0000000..c1b96ab
--- /dev/null
+++ b/src/gallium/targets/osmesa/sweet_hw.c
@@ -0,0 +1,229 @@
+/*
+ * SPDX-License-Identifier: MIT
+ * Panfrost/Mali hardware pipe_screen and zero-copy IOSurface helpers for OSMesa on begonia.
+ */
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#include <stdint.h>
+#include <pthread.h>
+
+#include "pipe/p_defines.h"
+#include "pipe/p_screen.h"
+#include "pipe/p_state.h"
+#include "frontend/winsys_handle.h"
+#include "util/u_inlines.h"
+#include "util/xmlconfig.h"
+#include "util/driconf.h"
+#include "panfrost/pan_public.h"
+
+extern int drmOpenWithType(const char *name, const char *busid, int type);
+struct sweet_gpu_surface_bo_ext {
+   uint32_t surface_id, handle;
+   uint64_t size, iova;
+   uint32_t offset, bytes_per_row, width, height, pixel_format, planes;
+   uint32_t flags, tiling, ubwc, reserved;
+};
+struct bg_gpu_info_compat {
+   uint32_t abi_version, flags, gpu_id, chip_id;
+   uint64_t va_start, va_size;
+   uint32_t last_fence, abi_minor;
+};
+#define SWEET_SBO_READONLY 0x1u
+#define SWEET_SBO_WRAPPED  0x4u
+extern int sweet_drm_surface_bo_ext(int fd, struct sweet_gpu_surface_bo_ext *io);
+extern int sweet_drm_gem_close(int fd, uint32_t handle);
+extern int sweet_drm_bo_sync(int fd, uint32_t handle, uint64_t offset, uint64_t size);
+extern int sweet_drm_info(int fd, struct bg_gpu_info_compat *out);
+
+struct pipe_screen *sweet_hw_create_screen(void);
+int sweet_hw_active(void);
+struct pipe_resource *sweet_hw_surface_resource(uint32_t surface_id, int opaque, unsigned *w, unsigned *h);
+void sweet_hw_surface_sync(uint32_t surface_id);
+void sweet_hw_surface_forget(uint32_t surface_id);
+struct pipe_resource *sweet_hw_wrapped_resource(uint32_t surface_id, enum pipe_format fmt, unsigned w, unsigned h);
+void sweet_hw_wrapped_sync(uint32_t surface_id);
+int sweet_hw_surface_alias(uint32_t surface_id, void **base, unsigned *bpr, unsigned *w, unsigned *h);
+void sweet_hw_surface_alias_sync(uint32_t surface_id);
+
+static const driOptionDescription sweet_driconf[] = {
+#include "pipe-loader/driinfo_gallium.h"
+#include "panfrost/driinfo_panfrost.h"
+};
+
+static int g_fd = -1;
+static struct pipe_screen *g_hw_screen;
+static int g_zc_wrapped;
+
+struct pipe_screen *
+sweet_hw_create_screen(void)
+{
+   static struct driOptionCache cache, info;
+   static struct pipe_screen_config config;
+   const char *e = getenv("SWEET_GPU");
+   if (e && e[0] == '0')
+      return NULL;
+   g_fd = drmOpenWithType("panfrost", NULL, 0);
+   if (g_fd < 0)
+      return NULL;
+   driParseOptionInfo(&info, sweet_driconf, ARRAY_SIZE(sweet_driconf));
+   driParseConfigFiles(&cache, &info, 0, "panfrost", NULL, NULL, NULL, 0, NULL, 0);
+   config.options = &cache;
+   config.options_info = &info;
+   struct pipe_screen *screen = panfrost_create_screen(g_fd, &config, NULL);
+   if (!screen)
+      return NULL;
+   struct bg_gpu_info_compat inf;
+   memset(&inf, 0, sizeof(inf));
+   if (sweet_drm_info(g_fd, &inf) == 0)
+      g_zc_wrapped = inf.abi_minor >= 1;
+   g_hw_screen = screen;
+   return screen;
+}
+
+int sweet_hw_active(void) { return g_hw_screen != NULL; }
+
+#define MAX_SURF 64
+#define MAX_WRAP 192
+static struct { uint32_t id; int opaque; uint32_t handle; unsigned w, h; struct pipe_resource *res; } g_surf[MAX_SURF];
+static struct { uint32_t id, handle; enum pipe_format fmt; unsigned w, h; struct pipe_resource *res; } g_wrap[MAX_WRAP];
+static pthread_mutex_t g_surf_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static struct pipe_resource *
+import_kms_res(uint32_t handle, enum pipe_format fmt, unsigned w, unsigned h,
+               uint64_t size, uint32_t offset, uint32_t bpr, unsigned bind, unsigned usage)
+{
+   struct pipe_resource templ;
+   memset(&templ, 0, sizeof(templ));
+   templ.target = PIPE_TEXTURE_2D;
+   templ.format = fmt;
+   templ.width0 = w;
+   templ.height0 = h;
+   templ.depth0 = 1;
+   templ.array_size = 1;
+   templ.usage = PIPE_USAGE_DEFAULT;
+   templ.bind = bind;
+   struct winsys_handle wh;
+   memset(&wh, 0, sizeof(wh));
+   wh.type = WINSYS_HANDLE_TYPE_KMS;
+   wh.handle = handle;
+   wh.stride = bpr;
+   wh.offset = offset;
+   wh.size = size;
+   wh.modifier = 0;
+   return g_hw_screen->resource_from_handle(g_hw_screen, &templ, &wh, usage);
+}
+
+struct pipe_resource *
+sweet_hw_surface_resource(uint32_t surface_id, int opaque, unsigned *w, unsigned *h)
+{
+   struct pipe_resource *res = NULL;
+   int free_slot = -1;
+   if (!g_hw_screen) return NULL;
+   pthread_mutex_lock(&g_surf_lock);
+   for (int i = 0; i < MAX_SURF; i++) {
+      if (g_surf[i].res && g_surf[i].id == surface_id && g_surf[i].opaque == opaque) {
+         *w = g_surf[i].w; *h = g_surf[i].h;
+         pthread_mutex_unlock(&g_surf_lock);
+         return g_surf[i].res;
+      }
+      if (!g_surf[i].res && free_slot < 0) free_slot = i;
+   }
+   if (free_slot >= 0) {
+      struct sweet_gpu_surface_bo_ext sb = { .surface_id = surface_id, .handle = 0 };
+      int r = sweet_drm_surface_bo_ext(g_fd, &sb);
+      if (r == 0 && !(sb.flags & (SWEET_SBO_READONLY | SWEET_SBO_WRAPPED)) && sb.planes <= 1 &&
+          ((sb.pixel_format == 0x42475241) || (sb.pixel_format == 0 && sb.bytes_per_row >= sb.width * 4))) {
+         enum pipe_format fmt = opaque ? PIPE_FORMAT_B8G8R8X8_UNORM : PIPE_FORMAT_B8G8R8A8_UNORM;
+         res = import_kms_res(sb.handle, fmt, sb.width, sb.height, sb.size, sb.offset, sb.bytes_per_row,
+             PIPE_BIND_RENDER_TARGET | PIPE_BIND_SAMPLER_VIEW, PIPE_HANDLE_USAGE_FRAMEBUFFER_WRITE);
+         if (res) {
+            sweet_drm_bo_sync(g_fd, sb.handle, 0, 0);
+            g_surf[free_slot].id = surface_id; g_surf[free_slot].opaque = opaque;
+            g_surf[free_slot].handle = sb.handle; g_surf[free_slot].w = sb.width;
+            g_surf[free_slot].h = sb.height; g_surf[free_slot].res = res;
+            *w = sb.width; *h = sb.height;
+         }
+      }
+   }
+   pthread_mutex_unlock(&g_surf_lock);
+   return res;
+}
+
+void
+sweet_hw_surface_sync(uint32_t surface_id)
+{
+   pthread_mutex_lock(&g_surf_lock);
+   for (int i = 0; i < MAX_SURF; i++)
+      if (g_surf[i].res && g_surf[i].id == surface_id) {
+         sweet_drm_bo_sync(g_fd, g_surf[i].handle, 0, 0);
+         break;
+      }
+   pthread_mutex_unlock(&g_surf_lock);
+}
+
+struct pipe_resource *
+sweet_hw_wrapped_resource(uint32_t surface_id, enum pipe_format fmt, unsigned w, unsigned h)
+{
+   struct pipe_resource *res = NULL;
+   int free_slot = -1;
+   if (!g_hw_screen || !g_zc_wrapped || !(w && h)) return NULL;
+   pthread_mutex_lock(&g_surf_lock);
+   for (int i = 0; i < MAX_WRAP; i++) {
+      if (g_wrap[i].res && g_wrap[i].id == surface_id && g_wrap[i].fmt == fmt && g_wrap[i].w == w && g_wrap[i].h == h) {
+         pthread_mutex_unlock(&g_surf_lock);
+         return g_wrap[i].res;
+      }
+      if (!g_wrap[i].res && free_slot < 0) free_slot = i;
+   }
+   if (free_slot >= 0 && g_hw_screen->is_format_supported(g_hw_screen, fmt, PIPE_TEXTURE_2D, 0, 0, PIPE_BIND_SAMPLER_VIEW)) {
+      struct sweet_gpu_surface_bo_ext sb = { .surface_id = surface_id };
+      unsigned bpp = util_format_get_blocksize(fmt);
+      if (sweet_drm_surface_bo_ext(g_fd, &sb) == 0 && sb.planes <= 1 &&
+          sb.bytes_per_row >= w * bpp && (sb.bytes_per_row & 63) == 0) {
+         res = import_kms_res(sb.handle, fmt, w, h, sb.size, sb.offset, sb.bytes_per_row,
+             PIPE_BIND_SAMPLER_VIEW, 0);
+         if (res) {
+            sweet_drm_bo_sync(g_fd, sb.handle, 0, 0);
+            g_wrap[free_slot].id = surface_id; g_wrap[free_slot].handle = sb.handle;
+            g_wrap[free_slot].fmt = fmt; g_wrap[free_slot].w = w; g_wrap[free_slot].h = h;
+            g_wrap[free_slot].res = res;
+         } else {
+            sweet_drm_gem_close(g_fd, sb.handle);
+         }
+      }
+   }
+   pthread_mutex_unlock(&g_surf_lock);
+   return res;
+}
+
+void
+sweet_hw_wrapped_sync(uint32_t surface_id)
+{
+   pthread_mutex_lock(&g_surf_lock);
+   for (int i = 0; i < MAX_WRAP; i++)
+      if (g_wrap[i].res && g_wrap[i].id == surface_id)
+         sweet_drm_bo_sync(g_fd, g_wrap[i].handle, 0, 0);
+   pthread_mutex_unlock(&g_surf_lock);
+}
+
+void
+sweet_hw_surface_forget(uint32_t surface_id)
+{
+   pthread_mutex_lock(&g_surf_lock);
+   for (int i = 0; i < MAX_WRAP; i++)
+      if (g_wrap[i].res && g_wrap[i].id == surface_id) {
+         pipe_resource_reference(&g_wrap[i].res, NULL);
+         memset(&g_wrap[i], 0, sizeof(g_wrap[i]));
+      }
+   for (int i = 0; i < MAX_SURF; i++)
+      if (g_surf[i].res && g_surf[i].id == surface_id) {
+         pipe_resource_reference(&g_surf[i].res, NULL);
+         memset(&g_surf[i], 0, sizeof(g_surf[i]));
+      }
+   pthread_mutex_unlock(&g_surf_lock);
+}
+
+int sweet_hw_surface_alias(uint32_t s, void **b, unsigned *r, unsigned *w, unsigned *h)
+{ (void)s;(void)b;(void)r;(void)w;(void)h; return 0; }
+void sweet_hw_surface_alias_sync(uint32_t s) { (void)s; }
