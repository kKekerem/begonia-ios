+struct panfrost_bo *
+panfrost_bo_import_kms(struct panfrost_device *dev, uint32_t gem_handle,
+                       size_t size)
+{
+   struct panfrost_bo *bo;
+   pthread_mutex_lock(&dev->bo_map_lock);
+   bo = pan_lookup_bo(dev, gem_handle);
+   if (!bo->dev) {
+      bo->dev = dev;
+      bo->kmod_bo = pan_kmod_bo_import_kms(dev->kmod.dev, gem_handle, size, 0);
+      if (!bo->kmod_bo) {
+         bo->dev = NULL;
+         pthread_mutex_unlock(&dev->bo_map_lock);
+         return NULL;
+      }
+      struct pan_kmod_vm_op vm_op = {
+         .type = PAN_KMOD_VM_OP_TYPE_MAP,
+         .va = { .start = PAN_KMOD_VM_MAP_AUTO_VA, .size = bo->kmod_bo->size },
+         .map = { .bo = bo->kmod_bo, .bo_offset = 0 },
+      };
+      ASSERTED int ret = pan_kmod_vm_bind(
+         dev->kmod.vm, PAN_KMOD_VM_OP_MODE_IMMEDIATE, &vm_op, 1);
+      assert(!ret);
+      bo->ptr.gpu = vm_op.va.start;
+      bo->flags = PAN_BO_SHARED;
+      p_atomic_set(&bo->refcnt, 1);
+   } else {
+      if (p_atomic_read(&bo->refcnt) == 0)
+         p_atomic_set(&bo->refcnt, 1);
+      else
+         panfrost_bo_reference(bo);
+   }
+   pthread_mutex_unlock(&dev->bo_map_lock);
+   return bo;
+}
