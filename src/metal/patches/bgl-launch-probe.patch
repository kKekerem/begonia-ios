+/*
+ * begonia (Loxy, 24 Nov 2026): one-shot GPU self-test. When /private/var/tmp/bgmtl.probe exists (the kernel's
+ * begoniabgflags bit 5 creates it), Chlorophyll's bgmtl_render_probe runs once before backboardd starts and its
+ * output stays in /private/var/tmp/bgmtl-probe.txt: compute, textures, samplers, varyings and render targets checked
+ * pixel by pixel on the Mali-G76. The switch is removed first (a hang cannot repeat) and the probe gets 90 s.
+ */
+static void begonia_probe_once(void)
+{
+	const char *sw = "/private/var/tmp/bgmtl.probe";
+	if (access(sw, F_OK) != 0)
+		return;
+	unlink(sw);
+	pid_t pid = fork();
+	if (pid == 0) {
+		int fd = open("/private/var/tmp/bgmtl-probe.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);
+		if (fd >= 0) {
+			dup2(fd, 1);
+			dup2(fd, 2);
+			close(fd);
+		}
+		execl("/usr/local/bin/bgmtl_render_probe", "bgmtl_render_probe", (char *)NULL);
+		_exit(127);
+	}
+	if (pid < 0)
+		return;
+	for (int i = 0; i < 900; i++) {
+		int st = 0;
+		if (waitpid(pid, &st, WNOHANG) == pid)
+			return;
+		usleep(100000);
+	}
+	kill(pid, SIGKILL);
+	(void)waitpid(pid, NULL, 0);
+}
+
 int main(int argc, char **argv)
 {
