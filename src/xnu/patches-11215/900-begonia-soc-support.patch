# begonia (Redmi Note 8 Pro / MediaTek MT6785) SoC support for SWEET xnu-11215.
# Applied as sweet-z-900-begonia-soc-support.patch after upstream Bergamota patches.

diff --git a/bsd/dev/sweet_board.h b/bsd/dev/sweet_board.h
index 3d9c06a..97b7d2c 100644
--- a/bsd/dev/sweet_board.h
+++ b/bsd/dev/sweet_board.h
@@ -76,4 +76,14 @@ sweet_board_beryllium(void)
 	return cached == 1;
 }
 
+static inline bool
+sweet_board_begonia(void)
+{
+	static int cached = -1;
+	if (cached < 0) {
+		cached = sweet_board_is("xiaomi,begonia") ? 1 : 0;
+	}
+	return cached == 1;
+}
+
 #endif /* _SWEET_BOARD_H_ */
diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
