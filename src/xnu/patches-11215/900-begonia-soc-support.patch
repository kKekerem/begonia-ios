diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 3c2a9f7..4da8c4a 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1866,19 +1866,33 @@ init_ptpages(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end, bool
 #define SWEET_EARLY_FB_VA (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
 
 static void
-sweet_early_map_final(void)
+sweet_early_map_final(boot_args *args)
 {
 	const vm_map_address_t va = SWEET_EARLY_FB_VA;
+	uint64_t fb_pa = (args && args->Video.v_baseAddr) ? args->Video.v_baseAddr : 0x9c000000ULL;
+	uint64_t fb_size = (args && args->Video.v_height && args->Video.v_rowBytes) ?
+	    (args->Video.v_height * args->Video.v_rowBytes) : 0x1000000ULL;
+	uint64_t block0 = fb_pa & ~((uint64_t)ARM_TT_L2_SIZE - 1ULL);
+	uint64_t block_last = (fb_pa + fb_size - 1ULL) & ~((uint64_t)ARM_TT_L2_SIZE - 1ULL);
+	unsigned int blocks = (block_last > block0 && va + 2 * ARM_TT_L2_SIZE <= gVirtBase) ? 2u : 1u;
+
 	assert(va + ARM_TT_L2_SIZE <= gVirtBase);
 	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
 	assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
-	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
-	assert(*slot == ARM_TTE_EMPTY);
-	*slot = 0x9c000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
-	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
-	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
-	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	for (unsigned int i = 0; i < blocks; i++) {
+		vm_map_address_t bva = va + i * ARM_TT_L2_SIZE;
+		tt_entry_t *slot = &l2[(bva & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
+		if (i == 0) {
+			assert(*slot == ARM_TTE_EMPTY);
+		} else if (*slot != ARM_TTE_EMPTY) {
+			break;
+		}
+		*slot = (block0 + (uint64_t)i * ARM_TT_L2_SIZE) | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+		    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+		    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+		    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	}
 	__asm__ volatile("dsb ishst" ::: "memory");
 }
 #endif
@@ -2217,7 +2231,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 
 #if defined(SWEET)
 	/* phystokv() must still refer to the bootstrap aperture here. */
-	sweet_early_map_final();
+	sweet_early_map_final(args);
 #endif
 	arm_vm_physmap_init(args);
 	set_mmu_ttb_alternate(cpu_ttep & TTBR_BADDR_MASK);
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index e8f555e..58d71c0 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -523,11 +523,17 @@ LEXT(start_first_cpu)
 	mov		x21, #0
 
 #if defined(SWEET)
-	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0x9c000000 + 2368 * 4320)
+	/* Stage 0: white 64x32 band from boot_args->Video (no hardcoded board FB). */
+	ldr		x0, [x20, #40]
+	cbz		x0, Lsweet_skip_mark
+	ldr		x4, [x20, #56]
+	ldr		x1, [x20, #72]
+	cmp		x1, #33
+	b.lo	Lsweet_skip_mark
+	sub		x1, x1, #32
+	madd	x0, x1, x4, x0
 	mov		w1, #-1
 	mov		x2, #32
-	mov		x4, #4320
 Lsweet_mark_row:
 	mov		x3, #64
 	mov		x5, x0
@@ -539,6 +545,7 @@ Lsweet_mark_pixel:
 	subs	x2, x2, #1
 	b.ne	Lsweet_mark_row
 	dsb		sy
+Lsweet_skip_mark:
 #endif
 
 	// Set low reset vector before attempting any loads
@@ -689,19 +696,38 @@ Lkernelcache_base_found:
 
 #if defined(SWEET)
 	/*
-	 * Splash framebuffer: one 32MB Normal-NC block in the EXISTING V=P
-	 * L2 table. Both framebuffer and RAM use L1 index 0; another call to
-	 * create_bootstrap_mapping would replace the RAM L2 table.
-	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
-	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
+	 * Splash framebuffer: map every 32MB Normal-NC block covering Video in the
+	 * EXISTING V=P L2 table (L1 index 0, <4GB). Framebuffers like begonia's
+	 * 0x7d9b0000..0x7e360000 cross a 32MB boundary and need two L2 slots.
 	 */
-	MOV64	x10, 0x9c000000
+	ldr		x10, [x20, #40]
+	cbz		x10, Lsweet_skip_fb_map
+	ldr		x11, [x20, #56]
+	ldr		x12, [x20, #72]
+	mul		x11, x11, x12
+	cbz		x11, Lsweet_skip_fb_map
+	add		x14, x10, x11
+	sub		x14, x14, #1
+	lsr		x10, x10, #(ARM_TT_L2_SHIFT)
+	lsl		x10, x10, #(ARM_TT_L2_SHIFT)
+	lsr		x14, x14, #(ARM_TT_L2_SHIFT)
+	lsl		x14, x14, #(ARM_TT_L2_SHIFT)
+Lsweet_fb_map_loop:
+	lsr		x9, x10, #32
+	cbnz	x9, Lsweet_skip_fb_map
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
 	add		x13, x25, #(2 * PGBYTES)
 	str		x11, [x13, x12, lsl #TTE_SHIFT]
+	cmp		x10, x14
+	b.eq	Lsweet_skip_fb_map
+	mov		x9, #1
+	lsl		x9, x9, #(ARM_TT_L2_SHIFT)
+	add		x10, x10, x9
+	b		Lsweet_fb_map_loop
+Lsweet_skip_fb_map:
 #endif
 
 	/* Ensure TTEs are visible */
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 7dcca46..2c20cc3 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -18,7 +18,7 @@
  * 0x9d400000 1080x2246); sweet_early_set_video picks it from boot_args.
  */
 #define EARLY_BLOCK_PA 0x9c000000ull
-#define EARLY_BLOCK_SIZE 0x2000000ull
+#define EARLY_BLOCK_SIZE 0x4000000ull
 static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)EARLY_BLOCK_PA;
 static unsigned int early_width = 1080u, early_height = 2400u, early_stride = 4320u / 4;
 static uint64_t early_off;
@@ -200,11 +200,14 @@ sweet_early_flush_log(void)
 void
 sweet_early_set_video(uint64_t pa, uint64_t width, uint64_t height, uint64_t rowbytes)
 {
-	if (pa < EARLY_BLOCK_PA || width == 0 || height <= 32 || rowbytes < width * 4 ||
-	    pa + height * rowbytes > EARLY_BLOCK_PA + EARLY_BLOCK_SIZE) {
+	if (pa == 0 || width == 0 || height <= 32 || rowbytes < width * 4) {
 		return; /* keep the sweet default */
 	}
-	early_off = pa - EARLY_BLOCK_PA;
+	uint64_t block = pa & ~0x1ffffffull;
+	if (pa + height * rowbytes > block + EARLY_BLOCK_SIZE) {
+		return;
+	}
+	early_off = pa - block;
 	early_width = (unsigned int)width;
 	early_height = (unsigned int)height;
 	early_stride = (unsigned int)(rowbytes / 4);
