diff --git a/bsd/dev/begonia_autotest.c b/bsd/dev/begonia_autotest.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/begonia_autotest.c
@@ -0,0 +1,139 @@
+/*
+ * begonia_autotest.c (Loxy, 19 Nov 2026): unattended iOS test boots on begonia.
+ *
+ * begoniabgmtl=1  As soon as the root volume is mounted, arm Chlorophyll for backboardd:
+ *                 create /private/var/tmp/bgmtl-bb.arm and remove bgmtl-bb.off and bgmtl-bb.state,
+ *                 so every such boot tries the GPU compositor once; bgl-launch / the inject fall back
+ *                 to CPU rendering by themselves if the GPU fails (they write bgmtl-bb.off again).
+ *                 begoniabgmtl=0 removes bgmtl-bb.arm (GPU compositor off). Absent: files untouched.
+ * begoniareboot=N After N seconds (30..3600) print a marker, give the persistent console log
+ *                 (sweetlog) time to flush, then reboot the normal way (filesystems synced). The phone
+ *                 then comes back through the dual-boot picker, which starts Android by itself.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/vnode.h>
+#include <sys/fcntl.h>
+#include <sys/reboot.h>
+#include <libkern/libkern.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+
+extern vnode_t rootvnode;
+extern int reboot_kernel(int howto, char *message);
+extern int unlink1(vfs_context_t ctx, vnode_t start_dvp, user_addr_t path_arg,
+    enum uio_seg segflg, int unlink_flags);
+extern void IOSleep(unsigned int milliseconds);
+extern void begonia_wdt_stop_kicking(void);     /* begonia_reboot.c */
+
+#define BGMTL_DIR   "/private/var/tmp/"
+
+static uint32_t autotest_bgmtl = 2;     /* 2 = not given */
+static uint32_t autotest_reboot;
+static uint32_t autotest_bgflags = ~0u; /* begoniabgflags=<mask>; ~0 = not given */
+
+/*
+ * begoniabgflags=<mask> (20 Nov 2026): Chlorophyll's switch files, read when a process starts (docs/FIXES.md):
+ * a set bit creates the file, a clear bit removes it. Absent: all left as they are.
+ */
+static const char *const autotest_flag_files[] = {
+	BGMTL_DIR "bgmtl.trace",        /* bit 0: per-commit trace, per-present "mean texel value" (BLACK frames) */
+	BGMTL_DIR "bgmtl.perf",         /* bit 1: per-second commit timing in bgmtl.log */
+	BGMTL_DIR "bgmtl-bb.sync",      /* bit 2: backboardd commits synchronously */
+	BGMTL_DIR "bgmtl-bb.full",      /* bit 3: backboardd redraws in full (no dirty regions) */
+	BGMTL_DIR "bgmtl.dumpatt",      /* bit 4: with the trace, attachments dumped to /private/var/tmp/att */
+};
+
+static void
+autotest_touch(const char *path)
+{
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx = vfs_context_kernel();
+	int err = vnode_open(path, O_CREAT | FWRITE | O_NOFOLLOW, 0644, 0, &vp, ctx);
+	if (err == 0) {
+		vnode_close(vp, FWRITE, ctx);
+	}
+	printf("BEGONIA AUTOTEST: create %s -> %d\n", path, err);
+}
+
+static void
+autotest_remove(const char *path)
+{
+	int err = unlink1(vfs_context_kernel(), NULLVP, CAST_USER_ADDR_T(path), UIO_SYSSPACE, 0);
+	printf("BEGONIA AUTOTEST: remove %s -> %d\n", path, err);
+}
+
+static void
+begonia_autotest_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint64_t t0 = mach_absolute_time();
+	uint64_t ns;
+
+	if (autotest_bgmtl != 2 || autotest_bgflags != ~0u) {
+		/* wait for the root mount (rd=ufsroot0), at most 120 s */
+		for (int i = 0; i < 1200 && rootvnode == NULLVP; i++) {
+			IOSleep(100);
+		}
+		if (rootvnode == NULLVP) {
+			printf("BEGONIA AUTOTEST: no root volume after 120 s, bgmtl files untouched\n");
+		} else {
+			if (autotest_bgmtl == 1) {
+				autotest_remove(BGMTL_DIR "bgmtl-bb.off");
+				autotest_remove(BGMTL_DIR "bgmtl-bb.state");
+				autotest_touch(BGMTL_DIR "bgmtl-bb.arm");
+			} else if (autotest_bgmtl == 0) {
+				autotest_remove(BGMTL_DIR "bgmtl-bb.arm");
+			}
+			if (autotest_bgflags != ~0u) {
+				for (uint32_t i = 0; i < sizeof(autotest_flag_files) / sizeof(autotest_flag_files[0]); i++) {
+					if (autotest_bgflags & (1u << i)) {
+						autotest_touch(autotest_flag_files[i]);
+					} else {
+						autotest_remove(autotest_flag_files[i]);
+					}
+				}
+			}
+		}
+	}
+
+	if (autotest_reboot) {
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		uint64_t left_ms = (uint64_t)autotest_reboot * 1000ULL;
+		uint64_t spent_ms = ns / 1000000ULL;
+		if (left_ms > spent_ms) {
+			IOSleep((unsigned int)(left_ms - spent_ms));
+		}
+		printf("BEGONIA AUTOTEST: begoniareboot=%u reached, rebooting in 5 s\n", autotest_reboot);
+		IOSleep(5000);  /* sweetlog flushes about once a second */
+		begonia_wdt_stop_kicking();     /* begoniawdt guard: a shutdown that hangs ends in a watchdog reset */
+		reboot_kernel(RB_AUTOBOOT, (char *)"begoniareboot");
+	}
+}
+
+void begonia_autotest_init(void);
+
+void
+begonia_autotest_init(void)
+{
+	thread_t thread;
+
+	(void)PE_parse_boot_argn("begoniabgmtl", &autotest_bgmtl, sizeof(autotest_bgmtl));
+	(void)PE_parse_boot_argn("begoniareboot", &autotest_reboot, sizeof(autotest_reboot));
+	(void)PE_parse_boot_argn("begoniabgflags", &autotest_bgflags, sizeof(autotest_bgflags));
+	if (autotest_reboot && (autotest_reboot < 30 || autotest_reboot > 3600)) {
+		printf("BEGONIA AUTOTEST: begoniareboot=%u out of range 30..3600, ignored\n", autotest_reboot);
+		autotest_reboot = 0;
+	}
+	if (autotest_bgmtl == 2 && !autotest_reboot && autotest_bgflags == ~0u) {
+		return;
+	}
+	printf("BEGONIA AUTOTEST: bgmtl=%u reboot=%u s bgflags=%#x\n", autotest_bgmtl, autotest_reboot, autotest_bgflags);
+	if (kernel_thread_start(begonia_autotest_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("BEGONIA AUTOTEST: kernel_thread_start failed\n");
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/begonia_plog.c b/bsd/dev/begonia_plog.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/begonia_plog.c
@@ -0,0 +1,112 @@
+/*
+ * begonia_plog.c (Loxy, 19 Nov 2026): mirror the XNU console into the Linux ramoops console zone.
+ *
+ * The mtkloader already writes its own log there (PLOG_ZONE_PA, persistent_ram_buffer as Linux 4.14
+ * ramoops reads it: u32 sig "DBGC", u32 start, u32 size, data[]). XNU appends everything that reaches
+ * the console (kernel printf, daemons' /dev/console, the panic text) after it, so the next Android boot
+ * shows the loader log followed by the XNU console in /sys/fs/pstore/console-ramoops*. Unlike sweetlog
+ * this needs no UFS, so it also covers a boot that dies before or in the UFS driver. The zone is outside
+ * XNU's RAM window (dram-base 0xC1004000), mapped as device memory. Before IOKit maps it, up to 64 KiB
+ * are kept in a static buffer. begoniaplog=0 turns it off.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <libkern/libkern.h>
+#include <mach/vm_types.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define PLOG_ZONE_PA    0x4D09F000ULL
+#define PLOG_ZONE_SIZE  0x40000U
+#define PLOG_SIG        0x43474244U
+#define PLOG_CAP        (PLOG_ZONE_SIZE - 12U)
+#define EARLY_CAP       (64U * 1024U)
+
+static char plog_early[EARLY_CAP];
+static uint32_t plog_early_len;
+static volatile uint32_t *plog_hdr;
+static volatile uint8_t *plog_data;
+static uint32_t plog_pos, plog_size;
+static int plog_state;          /* 0 buffering, 1 live, -1 off */
+
+void begonia_plog_append(const char *c, int size);
+void begonia_plog_start(void);
+
+static void
+plog_put(const char *c, uint32_t n)
+{
+	uint32_t pos = plog_pos % PLOG_CAP;
+	for (uint32_t i = 0; i < n; i++) {
+		plog_data[pos] = (uint8_t)c[i];
+		pos = (pos + 1U) % PLOG_CAP;
+		if (plog_size < PLOG_CAP) {
+			plog_size++;
+		}
+	}
+	plog_pos = pos;
+	plog_hdr[1] = plog_pos;
+	plog_hdr[2] = plog_size;
+}
+
+void
+begonia_plog_append(const char *c, int size)
+{
+	if (size <= 0 || plog_state < 0) {
+		return;
+	}
+	if (plog_state == 0) {
+		uint32_t n = (uint32_t)size;
+		if (plog_early_len >= EARLY_CAP) {
+			return;
+		}
+		if (n > EARLY_CAP - plog_early_len) {
+			n = EARLY_CAP - plog_early_len;
+		}
+		for (uint32_t i = 0; i < n; i++) {
+			plog_early[plog_early_len + i] = c[i];
+		}
+		plog_early_len += n;
+		return;
+	}
+	plog_put(c, (uint32_t)size);
+}
+
+void
+begonia_plog_start(void)
+{
+	uint32_t on = 1;
+	static const char mark[] = "\n== begonia XNU console (plog) ==\n";
+
+	if (plog_state != 0) {
+		return;
+	}
+	(void)PE_parse_boot_argn("begoniaplog", &on, sizeof(on));
+	if (!on) {
+		plog_state = -1;
+		return;
+	}
+	vm_offset_t va = ml_io_map((vm_offset_t)PLOG_ZONE_PA, PLOG_ZONE_SIZE);
+	if (va == 0) {
+		plog_state = -1;
+		printf("BEGONIA PLOG: ml_io_map failed\n");
+		return;
+	}
+	plog_hdr = (volatile uint32_t *)va;
+	plog_data = (volatile uint8_t *)(va + 12U);
+	if (plog_hdr[0] == PLOG_SIG && plog_hdr[1] < PLOG_CAP && plog_hdr[2] <= PLOG_CAP) {
+		plog_pos = plog_hdr[1];         /* keep the loader's log, continue after it */
+		plog_size = plog_hdr[2];
+	} else {
+		plog_hdr[0] = PLOG_SIG;
+		plog_pos = 0;
+		plog_size = 0;
+	}
+	plog_put(mark, (uint32_t)(sizeof(mark) - 1U));
+	plog_put(plog_early, plog_early_len);
+	plog_state = 1;
+	printf("BEGONIA PLOG: XNU console mirrored to ramoops at 0x%llx (%u early bytes)\n",
+	    PLOG_ZONE_PA, plog_early_len);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/begonia_reboot.c b/bsd/dev/begonia_reboot.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/begonia_reboot.c
@@ -0,0 +1,246 @@
+/*
+ * begonia_reboot.c (Loxy, 20 Nov 2026): restart, power off and panic restart on begonia (MT6785).
+ *
+ * Bergamota's reset path (bsd/dev/sweet_reboot.c) is Qualcomm only (PS_HOLD, then PSCI) and is only set
+ * up on beryllium. On begonia sweet_reboot_restart() flushed the UFS cache and returned -1, so a restart
+ * ended in "MACH Reboot", a power off in "CPU halted", and 30 s later both in panic("Halt/Restart Timed
+ * Out"); a panic spun forever (debug=0x14e has DB_NMI, so XNU never calls kdp_machine_reboot_type).
+ *
+ * begonia_reboot_init() maps TOPRGU in thread context and installs PE_halt_restart, which
+ * IOPlatformExpert::haltRestart() calls for every type after SweetPlatformExpert's own handling:
+ *  - kPERestartCPU, kPEPanicRestartCPU: the MediaTek software watchdog reset, step by step as the MIUI
+ *    4.14 kernel reboots (drivers/watchdog/mediatek/wdt/common/wdt_v2 wdt_arch_reset with
+ *    WD_SW_RESET_BYPASS_PWR_KEY; begonia's toprgu node has no "rstmode", MT6785 has no DBGTOP): kick,
+ *    NONRST_REG2 bypass-power-key bit, WDT_MODE without IRQ / DUAL / EXTRA_CNT / DDR_RESERVE plus
+ *    EXTEN, the status backup in NONRST_REG, then WDT_SWRST = 0x1209. A warm reset like every Android
+ *    reboot: DRAM keeps the ramoops logs, and the dual-boot picker starts Android after its countdown.
+ *    PSCI SYSTEM_RESET if the SoC is still running 2 s later.
+ *  - kPEHaltCPU (power off): UFS cache flush, PSCI SYSTEM_OFF (MediaTek ATF powers the PMIC off); if
+ *    that returns, the reset above.
+ *  - kPEPanicDiagnosticsDone: the panic text is out (also in the ramoops mirror, begonia_plog.c). Unless
+ *    the debug boot-arg has DB_REBOOT_ALWAYS (0x100000, then kPEPanicRestartCPU follows), reset after
+ *    begoniapanicreset seconds (default 5; 0 = keep the panic screen, the old behaviour).
+ * Every log line starts with "BEGONIA REBOOT:".
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <mach/vm_types.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+#include <IOKit/IOPlatformExpert.h>
+#include "sweet_board.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void delay(int usec);
+extern int sweet_ufs_flush_final(void);         /* bsd/dev/sweet_ufs.c (Bergamota 0222) */
+
+#define RGU_PA                  0x10007000u     /* live DT toprgu@10007000, "mediatek,toprgu" */
+#define RGU_MODE                0x00u
+#define RGU_LENGTH              0x04u
+#define RGU_LENGTH_KEY          0x0008u
+#define RGU_MODE_ENABLE         0x0001u
+#define RGU_RESTART             0x08u
+#define RGU_STATUS              0x0cu
+#define RGU_SWRST               0x14u
+#define RGU_NONRST              0x20u
+#define RGU_NONRST2             0x24u
+#define RGU_MODE_KEY            0x22000000u
+#define RGU_MODE_DDR_RESERVE    0x0080u
+#define RGU_MODE_DUAL           0x0040u
+#define RGU_MODE_EXTRA_CNT      0x0010u
+#define RGU_MODE_IRQ            0x0008u
+#define RGU_MODE_EXTEN          0x0004u
+#define RGU_RESTART_KEY         0x1971u
+#define RGU_SWRST_KEY           0x1209u
+#define RGU_NONRST2_BYPASS_PWRKEY (1u << 13)
+
+#define PSCI_SYSTEM_OFF         0x84000008ULL
+#define PSCI_SYSTEM_RESET       0x84000009ULL
+#define DB_REBOOT_ALWAYS_BIT    0x100000u       /* osfmk/kern/debug.h */
+
+static volatile uint32_t *br_rgu;
+static uint32_t br_panic_reset_s = 5;
+static uint32_t br_debug;
+static volatile uint32_t br_busy;
+static uint32_t br_wdt_secs;                    /* begoniawdt=N: hardware watchdog guard, 0 = off */
+static volatile bool br_wdt_kicking;
+
+void begonia_reboot_init(void);
+void begonia_wdt_stop_kicking(void);
+extern void IOSleep(unsigned int milliseconds);
+
+static inline void
+br_w(uint32_t off, uint32_t v)
+{
+	br_rgu[off / 4] = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static inline uint32_t
+br_r(uint32_t off)
+{
+	return br_rgu[off / 4];
+}
+
+/* SMCCC 1.0 fast call from EL1 (HCR_EL2.TSC is clear, the loader drops XNU to EL1): MediaTek ATF PSCI. */
+static uint64_t
+br_psci(uint64_t fn)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	__asm__ volatile ("smc #0" : "+r"(x0) : : "x1", "x2", "x3", "x4", "x5", "x6", "x7",
+	    "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+	return x0;
+}
+
+/* The MIUI 4.14 kernel's normal reboot (wdt_arch_reset, bypass power key), without the PMIC dump. */
+static void
+br_rgu_reset(void)
+{
+	uint32_t mode, nonrst2;
+
+	br_w(RGU_RESTART, RGU_RESTART_KEY);
+	nonrst2 = br_r(RGU_NONRST2) | RGU_NONRST2_BYPASS_PWRKEY;
+	mode = br_r(RGU_MODE) & 0x00ffffffu;
+	mode &= ~(RGU_MODE_IRQ | RGU_MODE_DUAL);
+	mode |= RGU_MODE_KEY | RGU_MODE_EXTEN;
+	br_w(RGU_NONRST2, nonrst2);
+	br_w(RGU_NONRST, br_r(RGU_STATUS) | br_r(RGU_NONRST));
+	mode &= ~RGU_MODE_EXTRA_CNT;
+	br_w(RGU_MODE, mode);
+	br_w(RGU_NONRST, br_r(RGU_STATUS));
+	mode = (br_r(RGU_MODE) & 0x00ffffffu & ~RGU_MODE_DDR_RESERVE) | RGU_MODE_KEY;
+	br_w(RGU_MODE, mode);
+	delay(200);
+	br_w(RGU_SWRST, RGU_SWRST_KEY);
+	for (int i = 0; i < 400; i++) {         /* Linux mainline repeats it every 5 ms */
+		delay(5000);
+		br_w(RGU_SWRST, RGU_SWRST_KEY);
+	}
+}
+
+static int
+br_reset(const char *why)
+{
+	if (br_busy++ == 0) {
+		printf("BEGONIA REBOOT: %s: TOPRGU software reset (WDT_MODE 0x%08x, NONRST2 0x%08x, STATUS 0x%08x)\n",
+		    why, br_rgu ? br_r(RGU_MODE) : 0, br_rgu ? br_r(RGU_NONRST2) : 0, br_rgu ? br_r(RGU_STATUS) : 0);
+		delay(100 * 1000);              /* let the console / ramoops mirror take the line */
+	}
+	if (br_rgu != NULL) {
+		br_rgu_reset();
+	}
+	printf("BEGONIA REBOOT: still running after the watchdog reset, PSCI SYSTEM_RESET\n");
+	(void)br_psci(PSCI_SYSTEM_RESET);
+	delay(2000 * 1000);
+	printf("BEGONIA REBOOT: no reset happened\n");
+	return -1;
+}
+
+static int
+begonia_halt_restart(unsigned int type)
+{
+	switch (type) {
+	case kPERestartCPU:
+		return br_reset("restart");
+	case kPEPanicRestartCPU:
+		return br_reset("panic restart");
+	case kPEHaltCPU: {
+		int flush = sweet_ufs_flush_final();
+		printf("BEGONIA REBOOT: power off (UFS cache flush -> %d), PSCI SYSTEM_OFF\n", flush);
+		delay(100 * 1000);
+		uint64_t rc = br_psci(PSCI_SYSTEM_OFF);
+		delay(1000 * 1000);
+		printf("BEGONIA REBOOT: PSCI SYSTEM_OFF returned 0x%llx\n", rc);
+		return br_reset("power off fallback");
+	}
+	case kPEPanicDiagnosticsDone:
+		if ((br_debug & DB_REBOOT_ALWAYS_BIT) || br_panic_reset_s == 0) {
+			return -1;
+		}
+		printf("BEGONIA REBOOT: panic, reset in %u s (begoniapanicreset=0 keeps the panic screen)\n",
+		    br_panic_reset_s);
+		delay((int)(br_panic_reset_s * 1000 * 1000));
+		return br_reset("panic");
+	default:
+		return -1;
+	}
+}
+
+/*
+ * Hardware watchdog guard for unattended test boots (begoniawdt=N, 1..31 s): the TOPRGU counter runs,
+ * a kernel thread restarts it every 2 s. A hard hang (every CPU stuck, nothing scheduled), or a panic
+ * whose reset did not happen, resets the SoC within N s like an Android kernel watchdog timeout would,
+ * and the picker starts Android. begonia_wdt_stop_kicking() (the autotest, right before its orderly
+ * reboot) turns a hang in the shutdown path into a reset as well.
+ */
+static void
+br_wdt_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	while (br_wdt_kicking) {
+		br_w(RGU_RESTART, RGU_RESTART_KEY);
+		IOSleep(2000);
+	}
+	printf("BEGONIA REBOOT: watchdog no longer kicked (reset in %u s unless the reboot completes)\n", br_wdt_secs);
+}
+
+void
+begonia_wdt_stop_kicking(void)
+{
+	br_wdt_kicking = false;
+}
+
+static void
+br_wdt_start(void)
+{
+	thread_t thread;
+	uint32_t mode;
+
+	/* WDT_LENGTH[15:5] counts 512 ticks of the 32 kHz clock: 64 per second; key 0x08 in [4:0] */
+	br_w(RGU_LENGTH, (((br_wdt_secs * 64u) << 5) & 0xffe0u) | RGU_LENGTH_KEY);
+	br_w(RGU_RESTART, RGU_RESTART_KEY);
+	br_w(RGU_NONRST2, br_r(RGU_NONRST2) | RGU_NONRST2_BYPASS_PWRKEY);
+	mode = br_r(RGU_MODE) & 0x00ffffffu;
+	mode &= ~(RGU_MODE_IRQ | RGU_MODE_DUAL | RGU_MODE_EXTRA_CNT | RGU_MODE_DDR_RESERVE);
+	br_wdt_kicking = true;
+	br_w(RGU_MODE, mode | RGU_MODE_KEY | RGU_MODE_EXTEN | RGU_MODE_ENABLE);
+	if (kernel_thread_start(br_wdt_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		printf("BEGONIA REBOOT: hardware watchdog guard %u s (WDT_MODE %#x)\n", br_wdt_secs, br_r(RGU_MODE));
+	} else {
+		br_w(RGU_MODE, (br_r(RGU_MODE) & 0x00ffffffu & ~RGU_MODE_ENABLE) | RGU_MODE_KEY);
+		br_wdt_kicking = false;
+		printf("BEGONIA REBOOT: no kicker thread, watchdog guard off\n");
+	}
+}
+
+/* Thread context (begonia_platform_hw_init, before the GPU / touch drivers). Idempotent. */
+void
+begonia_reboot_init(void)
+{
+	if (br_rgu != NULL || !sweet_board_begonia()) {
+		return;
+	}
+	(void)PE_parse_boot_argn("begoniapanicreset", &br_panic_reset_s, sizeof(br_panic_reset_s));
+	if (br_panic_reset_s > 600) {
+		br_panic_reset_s = 600;
+	}
+	(void)PE_parse_boot_argn("debug", &br_debug, sizeof(br_debug));
+	br_rgu = (volatile uint32_t *)ml_io_map(RGU_PA, 0x1000);
+	if (br_rgu == NULL) {
+		printf("BEGONIA REBOOT: TOPRGU map failed, PSCI only\n");
+	}
+	PE_halt_restart = begonia_halt_restart;
+	printf("BEGONIA REBOOT: restart/power off/panic -> TOPRGU (WDT_MODE 0x%08x, STATUS 0x%08x, NONRST2 0x%08x), "
+	    "panic reset after %u s\n", br_rgu ? br_r(RGU_MODE) : 0, br_rgu ? br_r(RGU_STATUS) : 0,
+	    br_rgu ? br_r(RGU_NONRST2) : 0, br_panic_reset_s);
+	(void)PE_parse_boot_argn("begoniawdt", &br_wdt_secs, sizeof(br_wdt_secs));
+	if (br_wdt_secs > 31u) {
+		br_wdt_secs = 31u;
+	}
+	if (br_rgu != NULL && br_wdt_secs != 0u) {
+		br_wdt_start();
+	}
+}
