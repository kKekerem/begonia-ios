+
+static inline uint32_t
+usb_rd(uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(usb.mac + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+usb_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(usb.mac + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static inline void
+usb_set(uint32_t off, uint32_t bits)
+{
+	usb_wr(off, usb_rd(off) | bits);
+}
+
+static inline void
+usb_clr(uint32_t off, uint32_t bits)
+{
+	usb_wr(off, usb_rd(off) & ~bits);
+}
+
+static inline uint32_t
+phy_rd(uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(usb.phy + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+phy_rmw(uint32_t off, uint32_t clr, uint32_t set)
+{
+	*(volatile uint32_t *)(usb.phy + off) = (phy_rd(off) & ~clr) | set;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static bool
+usb_wait(uint32_t off, uint32_t mask, uint32_t want, unsigned us)
+{
+	for (unsigned i = 0; i < us; i += 10) {
+		if ((usb_rd(off) & mask) == want) {
+			return true;
+		}
+		delay(10);
+	}
+	return (usb_rd(off) & mask) == want;
+}
+
+static void
+usb_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&usb.chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* PIO, as mu3d_hal_write_fifo / read_fifo: 32-bit words, then a 16- and an 8-bit write for the tail */
+static void
+fifo_write(unsigned ep, const uint8_t *p, uint32_t n)
+{
+	vm_offset_t f = usb.mac + U3D_FIFO(ep);
+
+	while (n >= 4) {
+		*(volatile uint32_t *)f = (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) |
+		    ((uint32_t)p[3] << 24);
+		p += 4;
+		n -= 4;
+	}
+	if (n >= 2) {
+		*(volatile uint16_t *)f = (uint16_t)(p[0] | (p[1] << 8));
+		p += 2;
+		n -= 2;
+	}
+	if (n) {
+		*(volatile uint8_t *)f = p[0];
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void
+fifo_read(unsigned ep, uint8_t *p, uint32_t n)
+{
+	vm_offset_t f = usb.mac + U3D_FIFO(ep);
+
+	while (n > 0) {
+		uint32_t v = *(volatile uint32_t *)f;
+		for (unsigned i = 0; i < 4 && n > 0; i++, n--) {
+			*p++ = (uint8_t)(v >> (8 * i));
+		}
+	}
+}
+
+/* ---- PHY, clocks, controller ---- */
+
+static void
+usb_vusb_on(void)
+{
+	uint32_t con0 = 0, mon = 0;
+	bool ok = begonia_pmic_read(MT6359_LDO_VUSB_CON0, &con0) && begonia_pmic_read(MT6359_LDO_VUSB_MON, &mon);
+
+	printf("BEGONIA USB: VUSB (3.3 V PHY supply) CON0 %#x MON %#x (read %s)\n", con0, mon, ok ? "ok" : "FAILED");
+	if (ok && !(mon & 1u)) {
+		(void)begonia_pmic_write(MT6359_LDO_VUSB_CON0, con0 | 1u);
+		delay(250);
+		(void)begonia_pmic_read(MT6359_LDO_VUSB_MON, &mon);
+		printf("BEGONIA USB: VUSB enabled, MON %#x\n", mon);
+	}
+}
