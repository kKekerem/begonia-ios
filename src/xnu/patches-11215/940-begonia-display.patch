+/*
+ * "top [S]": CPU time of every process over S seconds (default 5; live threads, user + system), the 14 busiest.
+ * "smp NAME": the threads of the processes called NAME with their user backtraces (Bergamota's sampler).
+ */
+#define TOP_MAX 200
+struct top_ent {
+	int      pid;
+	char     name[24];
+	uint64_t us;
+};
+static struct top_ent top_a[TOP_MAX], top_b[TOP_MAX];
+static uint32_t top_na, top_nb;
+static uint64_t top_t0, top_at;
+static struct top_ent *top_fill;
+static uint32_t *top_fill_n;
+static char smp_name[32];
+
+static int
+top_cb(proc_t p, __unused void *arg)
+{
+	if (*top_fill_n >= TOP_MAX) {
+		return PROC_RETURNED;
+	}
+	task_t task = proc_task(p);
+	if (task == TASK_NULL) {
+		return PROC_RETURNED;
+	}
+	struct task_thread_times_info tt;
+	mach_msg_type_number_t cnt = TASK_THREAD_TIMES_INFO_COUNT;
+	if (task_info(task, TASK_THREAD_TIMES_INFO, (task_info_t)&tt, &cnt) != KERN_SUCCESS) {
+		return PROC_RETURNED;
+	}
+	struct top_ent *e = &top_fill[(*top_fill_n)++];
+	e->pid = proc_pid(p);
+	proc_name(e->pid, e->name, sizeof(e->name));
+	e->us = (uint64_t)tt.user_time.seconds * 1000000ull + (uint64_t)tt.user_time.microseconds +
+	    (uint64_t)tt.system_time.seconds * 1000000ull + (uint64_t)tt.system_time.microseconds;
+	return PROC_RETURNED;
+}
+
+static void
+top_snap(struct top_ent *t, uint32_t *n)
+{
+	*n = 0;
+	top_fill = t;
+	top_fill_n = n;
+	proc_iterate(PROC_ALLPROCLIST, top_cb, NULL, NULL, NULL);
+}
+
+static void
+top_poll(void)
+{
+	if (top_at == 0 || mach_absolute_time() < top_at) {
+		return;
+	}
+	top_at = 0;
+	top_snap(top_b, &top_nb);
+	uint64_t wall;
+	absolutetime_to_nanoseconds(mach_absolute_time() - top_t0, &wall);
+	wall /= 1000;
+	if (wall == 0) {
+		wall = 1;
+	}
+	/* delta per process (matched by pid), then the 14 biggest by selection */
+	uint64_t total = 0;
+	for (uint32_t i = 0; i < top_nb; i++) {
+		uint64_t before = 0;
+		for (uint32_t j = 0; j < top_na; j++) {
+			if (top_a[j].pid == top_b[i].pid) {
+				before = top_a[j].us;
+				break;
+			}
+		}
+		top_b[i].us = top_b[i].us > before ? top_b[i].us - before : 0;
+		total += top_b[i].us;
+	}
+	printf("BEGONIA TOP: %llu ms, %u processes, CPU time %llu ms = %llu.%01llu cores busy\n", wall / 1000, top_nb,
+	    total / 1000, total / wall, (total * 10 / wall) % 10);
+	for (uint32_t k = 0; k < 14; k++) {
+		uint32_t best = TOP_MAX;
+		for (uint32_t i = 0; i < top_nb; i++) {
+			if (top_b[i].pid >= 0 && (best == TOP_MAX || top_b[i].us > top_b[best].us)) {
+				best = i;
+			}
+		}
+		if (best == TOP_MAX || top_b[best].us == 0) {
+			break;
+		}
+		printf("BEGONIA TOP:   %-20s %5d  %llu.%01llu%%  (%llu ms)\n", top_b[best].name, top_b[best].pid,
+		    top_b[best].us * 100 / wall, (top_b[best].us * 1000 / wall) % 10, top_b[best].us / 1000);
+		top_b[best].pid = -1;
+	}
+}
+
+static int
+smp_cb(proc_t p, __unused void *arg)
+{
+	char name[32];
+	proc_name(proc_pid(p), name, sizeof(name));
+	if (strcmp(name, smp_name) == 0) {
+		task_t task = proc_task(p);
+		if (task != TASK_NULL) {
+			sweet_sample_task(name, proc_pid(p), task);
+		}
+	}
+	return PROC_RETURNED;
+}
+
+static bool
+parse_ints(const char *s, int *v, int n)
+{
+	for (int i = 0; i < n; i++) {
+		while (*s == ' ') {
+			s++;
+		}
+		if (*s < '0' || *s > '9') {
+			return false;
+		}
+		int x = 0;
+		while (*s >= '0' && *s <= '9') {
+			x = x * 10 + (*s++ - '0');
+		}
+		v[i] = x;
+	}
+	return true;
+}
