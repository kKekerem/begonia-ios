+/*
+ * "cpufreq": the clock of every CPU, measured. This thread is bound to each processor in turn and times a chain of
+ * 20 million dependent adds (one cycle each on the A55 and on the A76) against mach_absolute_time.
+ */
+extern processor_t cpu_to_processor(int cpu);
+extern processor_t thread_bind(processor_t processor);
+
+static uint64_t
+cpufreq_khz_here(void)
+{
+	uint64_t x = 1, n = 20000000ull, ns;
+	uint64_t t0 = mach_absolute_time();
+	__asm__ volatile (
+                "1: add %0, %0, #1\n"
+                "   add %0, %0, #1\n"
+                "   add %0, %0, #1\n"
+                "   add %0, %0, #1\n"
+                "   subs %1, %1, #4\n"
+                "   b.ne 1b\n"
+                : "+r"(x), "+r"(n) : : "cc");
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	/* 20M dependent adds + 5M sub/branch that run alongside: ~20M cycles */
+	return ns ? (20000000ull * 1000000ull) / ns : 0;
+}
+
+static void
+cpufreq_report(void)
+{
+	char line[200];
+	size_t n = (size_t)snprintf(line, sizeof(line), "BEGONIA CPU: MHz");
+	for (unsigned int cpu = 0; cpu <= ml_get_max_cpu_number() && cpu < 8u; cpu++) {
+		processor_t p = cpu_to_processor((int)cpu);
+		if (p == (processor_t)NULL) {
+			continue;
+		}
+		thread_bind(p);
+		thread_block(THREAD_CONTINUE_NULL);     /* move there */
+		uint64_t khz = cpufreq_khz_here();
+		n += (size_t)snprintf(line + n, sizeof(line) - n, " cpu%u=%llu", cpu, khz / 1000);
+		if (n >= sizeof(line)) {
+			break;
+		}
+	}
+	thread_bind((processor_t)NULL);
+	thread_block(THREAD_CONTINUE_NULL);
+	printf("%s\n", line);
+}
