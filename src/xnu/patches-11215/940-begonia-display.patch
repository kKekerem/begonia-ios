+/*
+ * 26 Nov 2026 (Loxy 940): touches without a finger. "tap X Y" and "swipe X0 Y0 X1 Y1 MS" in panel pixels (1080x2340) go
+ * to SweetHIDTouch as finger 0: down, a move every 8 ms along the line, up. One at a time; the poll loop runs them.
+ */
+#define INJ_PANEL_H 2340u
+static struct {
+	bool     active, down;
+	int      x0, y0, x1, y1;
+	uint64_t t0, dur, next, step;
+} inj;
+
+static int
+inj_hid_y(int y)
+{
+	int v = (int)(((uint32_t)(y < 0 ? 0 : y) * 2400u + INJ_PANEL_H / 2u) / INJ_PANEL_H);
+	return v > 2399 ? 2399 : v;
+}
+
+static void
+inj_start(int x0, int y0, int x1, int y1, uint32_t ms)
+{
+	if (inj.active && inj.down) {
+		sweet_hid_touch(0, 0, inj.x1, inj_hid_y(inj.y1));
+	}
+	inj.x0 = x0;
+	inj.y0 = y0;
+	inj.x1 = x1;
+	inj.y1 = y1;
+	nanoseconds_to_absolutetime((uint64_t)(ms < 30u ? 30u : (ms > 5000u ? 5000u : ms)) * NSEC_PER_MSEC, &inj.dur);
+	nanoseconds_to_absolutetime(8ULL * NSEC_PER_MSEC, &inj.step);
+	inj.t0 = mach_absolute_time();
+	inj.next = inj.t0;
+	inj.down = false;
+	inj.active = true;
+}
+
+static void
+inj_poll(void)
+{
+	if (!inj.active) {
+		return;
+	}
+	uint64_t now = mach_absolute_time();
+	if (now < inj.next) {
+		return;
+	}
+	inj.next = now + inj.step;
+	uint64_t el = now - inj.t0;
+	if (el >= inj.dur) {
+		if (inj.down) {
+			sweet_hid_touch(0, 1, inj.x1, inj_hid_y(inj.y1));
+		}
+		sweet_hid_touch(0, 0, inj.x1, inj_hid_y(inj.y1));
+		inj.active = inj.down = false;
+		return;
+	}
+	int x = inj.x0 + (int)(((int64_t)(inj.x1 - inj.x0) * (int64_t)el) / (int64_t)inj.dur);
+	int y = inj.y0 + (int)(((int64_t)(inj.y1 - inj.y0) * (int64_t)el) / (int64_t)inj.dur);
+	sweet_hid_touch(0, 1, x, inj_hid_y(y));
+	inj.down = true;
