diff --git a/bsd/dev/begonia_disp.c b/bsd/dev/begonia_disp.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/begonia_disp.c
@@ -0,0 +1,456 @@
+/*
+ * begonia_disp.c (Loxy, 26 Nov 2026): the MT6785 display engine as LK left it, for the SweetFB framebuffer
+ * (iokit/Kernel/arm/SweetFramebuffer.cpp) on begonia (Redmi Note 8 Pro, CSOT NT36672A video-mode panel).
+ *
+ * LK configures OVL0/OVL0_2L -> RDMA0 -> DSI0 in video mode and scans its framebuffer by physical address (M4U off).
+ * The panel refreshes on its own at ~60 Hz; nothing here starts or stops that.
+ *
+ *  - Probe (read only): which OVL layer scans the boot framebuffer, the DSI timing, and how the line counters move
+ *    (RDMA0 OUT_LINE_CNT +0x12c, DSI0 STATE_DBG9 +0x16c), sampled for ~70 ms: frame period and the time of a frame
+ *    start (SOF) in mach absolute time.
+ *  - Phase: begonia_disp_sof() returns the predicted time of the next frame start, re-measured from one line counter
+ *    read (no spinning), so the framebuffer's vsync tick runs on the panel's own clock and copies a frame just before
+ *    the scan reaches it (the copy is ~7x faster than the scan, so it stays ahead of the beam: no tearing).
+ *  - Backlight: DCS 0x51 (Write Display Brightness, one byte) as a video-mode command packet (DSI_VM_CMD_CON +0x130,
+ *    DSI_START.VM_CMD_START bit 16, DSI_INTSTA.VM_CMD_DONE bit 5; begonia's Linux ddp_dsi.c DSI_send_vm_cmd). The
+ *    panel's PWM output drives the LM36273 backlight, so 0x51 = 0 is a dark screen and the level comes back on 0x51.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <libkern/libkern.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include "sweet_board.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void delay(int usec);
+
+#define OVL0_PA         0x14008000u
+#define OVL0_2L_PA      0x14009000u
+#define RDMA0_PA        0x1400b000u
+#define DSI0_PA         0x14014000u
+#define MUTEX_PA        0x14016000u
+
+#define OVL_STA         0x000u
+#define OVL_INTEN       0x004u
+#define OVL_INTSTA      0x008u
+#define OVL_EN          0x00cu
+#define OVL_SRC_CON     0x02cu
+#define OVL_L0_CON      0x030u
+#define OVL_L0_SRC_SIZE 0x038u
+#define OVL_L0_PITCH    0x044u
+#define OVL_LAYER_STRIDE 0x20u
+#define OVL_L0_ADDR     0xf40u
+
+#define RDMA_INT_STATUS 0x004u
+#define RDMA_IN_LINE    0x124u
+#define RDMA_OUT_LINE   0x12cu
+
+#define DSI_START       0x000u
+#define DSI_INTEN       0x008u
+#define DSI_INTSTA      0x00cu
+#define DSI_MODE_CTRL   0x014u
+#define DSI_VSA_NL      0x020u
+#define DSI_VBP_NL      0x024u
+#define DSI_VFP_NL      0x028u
+#define DSI_VACT_NL     0x02cu
+#define DSI_VM_CMD_CON  0x130u
+#define DSI_STATE_DBG9  0x16cu
+#define DSI_VM_CMD_START (1u << 16)
+#define DSI_VM_CMD_DONE (1u << 5)
+
+static vm_offset_t g_ovl[2], g_rdma, g_dsi, g_mutex;
+static int g_ovl_idx = -1, g_layer = -1;
+static uint32_t g_vsa, g_vbp, g_vfp, g_vact, g_vtotal, g_mode;
+static int g_counter;                   /* 0 none, 1 DSI line counter (all lines), 2 RDMA out line (active lines) */
+static uint32_t g_counter_max;          /* largest value the counter took in the probe */
+static uint64_t g_period;               /* frame period, mach absolute units; 0 = unknown */
+static uint64_t g_sof;                  /* a measured (or corrected) frame start, mach absolute */
+static uint64_t g_line;                 /* one line in mach absolute units (period / lines per frame) */
+static bool g_ready;
+static uint32_t g_dcs_sent, g_dcs_fail;
+
+static inline uint32_t
+rd(vm_offset_t b, uint32_t o)
+{
+	uint32_t v = *(volatile uint32_t *)(b + o);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+wr(vm_offset_t b, uint32_t o, uint32_t v)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(b + o) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static uint32_t
+counter_now(void)
+{
+	if (g_counter == 1) {
+		return rd(g_dsi, DSI_STATE_DBG9) & 0x3fffffu;
+	}
+	if (g_counter == 2) {
+		return rd(g_rdma, RDMA_OUT_LINE) & 0x1fffu;
+	}
+	return 0;
+}
+
+static uint64_t
+abs_us(uint64_t abs)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(abs, &ns);
+	return ns / 1000;
+}
+
+/*
+ * Watch one counter for up to ~70 ms: the times it wrapped (a value well below the previous one = a new frame).
+ * Returns the number of wraps (up to 4) and fills the times and the largest value seen.
+ */
+static uint32_t
+watch_counter(int which, uint64_t *wraps, uint32_t *maxv, uint32_t *samples)
+{
+	uint64_t t0 = mach_absolute_time(), limit, now;
+	uint32_t prev = 0, n = 0, cnt = 0, mx = 0;
+	bool first = true;
+
+	nanoseconds_to_absolutetime(70ULL * NSEC_PER_MSEC, &limit);
+	int saved = g_counter;
+	g_counter = which;
+	do {
+		uint32_t v = counter_now();
+		now = mach_absolute_time();
+		cnt++;
+		if (v > mx) {
+			mx = v;
+		}
+		if (!first && v + 64u < prev && n < 4) {
+			wraps[n++] = now;
+		}
+		prev = v;
+		first = false;
+	} while (now - t0 < limit);
+	g_counter = saved;
+	*maxv = mx;
+	*samples = cnt;
+	return n;
+}
+
+static void
+probe_layer(uint64_t fb_pa)
+{
+	for (int i = 0; i < 2; i++) {
+		if (g_ovl[i] == 0) {
+			continue;
+		}
+		vm_offset_t o = g_ovl[i];
+		uint32_t src = rd(o, OVL_SRC_CON);
+		printf("BEGONIA DISP: OVL%s sta %#x inten %#x intsta %#x en %#x src_con %#x\n", i ? "0_2L" : "0",
+		    rd(o, OVL_STA), rd(o, OVL_INTEN), rd(o, OVL_INTSTA), rd(o, OVL_EN), src);
+		for (uint32_t l = 0; l < 4; l++) {
+			uint32_t off = l * OVL_LAYER_STRIDE;
+			uint32_t con = rd(o, OVL_L0_CON + off), addr = rd(o, OVL_L0_ADDR + off);
+			uint32_t pitch = rd(o, OVL_L0_PITCH + off), size = rd(o, OVL_L0_SRC_SIZE + off);
+			if (!(src & (1u << l)) && addr == 0) {
+				continue;
+			}
+			printf("BEGONIA DISP:   layer %u %s con %#x addr %#x pitch %#x size %#x%s\n", l, (src & (1u << l)) ? "on " : "off",
+			    con, addr, pitch, size, addr == (uint32_t)fb_pa ? "  <- boot framebuffer" : "");
+			if ((src & (1u << l)) && addr == (uint32_t)fb_pa && g_ovl_idx < 0) {
+				g_ovl_idx = i;
+				g_layer = (int)l;
+			}
+		}
+	}
+}
+
+/* Called once by the framebuffer's start() with the boot framebuffer's physical address. */
+bool begonia_disp_init(uint64_t fb_pa);
+bool
+begonia_disp_init(uint64_t fb_pa)
+{
+	if (!sweet_board_begonia() || g_ready) {
+		return g_ready;
+	}
+	g_ovl[0] = ml_io_map(OVL0_PA, 0x1000);
+	g_ovl[1] = ml_io_map(OVL0_2L_PA, 0x1000);
+	g_rdma = ml_io_map(RDMA0_PA, 0x1000);
+	g_dsi = ml_io_map(DSI0_PA, 0x1000);
+	g_mutex = ml_io_map(MUTEX_PA, 0x1000);
+	if (g_rdma == 0 || g_dsi == 0) {
+		printf("BEGONIA DISP: ml_io_map failed\n");
+		return false;
+	}
+	probe_layer(fb_pa);
+	g_mode = rd(g_dsi, DSI_MODE_CTRL);
+	g_vsa = rd(g_dsi, DSI_VSA_NL) & 0x3ffu;
+	g_vbp = rd(g_dsi, DSI_VBP_NL) & 0x3ffu;
+	g_vfp = rd(g_dsi, DSI_VFP_NL) & 0x3ffu;
+	g_vact = rd(g_dsi, DSI_VACT_NL) & 0x3fffu;
+	g_vtotal = g_vsa + g_vbp + g_vfp + g_vact;
+	printf("BEGONIA DISP: DSI0 start %#x inten %#x intsta %#x mode %#x (%s) vsa %u vbp %u vfp %u vact %u -> %u lines, "
+	    "vm_cmd_con %#x dbg9 %#x; RDMA0 int %#x in_line %u out_line %u; MUTEX intsta %#x mutex0 en %#x sof %#x\n",
+	    rd(g_dsi, DSI_START), rd(g_dsi, DSI_INTEN), rd(g_dsi, DSI_INTSTA), g_mode, (g_mode & 3u) ? "video" : "command",
+	    g_vsa, g_vbp, g_vfp, g_vact, g_vtotal, rd(g_dsi, DSI_VM_CMD_CON), rd(g_dsi, DSI_STATE_DBG9),
+	    rd(g_rdma, RDMA_INT_STATUS), rd(g_rdma, RDMA_IN_LINE), rd(g_rdma, RDMA_OUT_LINE),
+	    g_mutex ? rd(g_mutex, 0x004) : 0, g_mutex ? rd(g_mutex, 0x020) : 0, g_mutex ? rd(g_mutex, 0x02c) : 0);
+
+	/* which counter moves: the DSI one counts every line of the frame (blanking too), RDMA only the active ones */
+	uint64_t w[4];
+	uint32_t mx, samples, n;
+	n = watch_counter(1, w, &mx, &samples);
+	printf("BEGONIA DISP: DSI line counter: %u wraps in 70 ms, max %u, %u samples%s\n", n, mx, samples,
+	    n >= 2 ? "" : " (not usable)");
+	if (n >= 3 && mx > 1000) {
+		g_counter = 1;
+	} else {
+		n = watch_counter(2, w, &mx, &samples);
+		printf("BEGONIA DISP: RDMA out line counter: %u wraps in 70 ms, max %u, %u samples%s\n", n, mx, samples,
+		    n >= 2 ? "" : " (not usable)");
+		if (n >= 3 && mx > 1000) {
+			g_counter = 2;
+		}
+	}
+	if (g_counter != 0) {
+		g_counter_max = mx;
+		uint64_t p1 = w[1] - w[0], p2 = w[2] - w[1];
+		g_period = (p1 + p2) / 2;
+		g_sof = w[n - 1];
+		/* lines per frame as the counter sees them: the DSI counter wraps at vtotal; RDMA's stops at vact for the blanking */
+		uint32_t lines = g_counter == 1 ? (mx + 1u) : (g_vtotal > mx ? g_vtotal : mx + 1u);
+		g_line = g_period / (lines ? lines : 1u);
+		printf("BEGONIA DISP: frame period %llu us (%llu.%02llu Hz; periods %llu/%llu us), %u lines per frame by the %s counter, "
+		    "line %llu ns\n", abs_us(g_period), 100000000ull / (abs_us(g_period) ? abs_us(g_period) : 1) / 100,
+		    100000000ull / (abs_us(g_period) ? abs_us(g_period) : 1) % 100, abs_us(p1), abs_us(p2), lines,
+		    g_counter == 1 ? "DSI" : "RDMA", abs_us(g_line * 1000));
+	} else {
+		printf("BEGONIA DISP: no line counter moves: the vsync tick stays on its own clock\n");
+	}
+	g_ready = true;
+	return true;
+}
+
+/*
+ * The predicted start of the first frame at or after `from` (mach absolute), re-measured now from one counter read:
+ * the frame started counter * line ago. Reads during RDMA's blanking (counter parked at its maximum) are skipped.
+ * 0 = no hardware phase.
+ */
+uint64_t begonia_disp_next_sof(uint64_t from, int64_t *err_out);
+uint64_t
+begonia_disp_next_sof(uint64_t from, int64_t *err_out)
+{
+	if (!g_ready || g_period == 0 || g_counter == 0) {
+		return 0;
+	}
+	uint64_t now = mach_absolute_time();
+	uint32_t c = counter_now();
+	int64_t err = 0;
+	if (c > 2u && c + 2u < g_counter_max) {
+		uint64_t meas = now - (uint64_t)c * g_line;      /* this frame's start as the counter says */
+		/* the prediction for this frame: g_sof advanced by whole periods to just before meas */
+		uint64_t pred = g_sof;
+		if (meas > pred) {
+			pred += ((meas - pred + g_period / 2) / g_period) * g_period;
+		}
+		err = (int64_t)(meas - pred);
+		/* follow the panel slowly (the counter read jitters by a line or two); a large error (a frame start we
+		 * mis-predicted by more than 2 ms) is taken at once */
+		int64_t lim;
+		nanoseconds_to_absolutetime(2 * NSEC_PER_MSEC, (uint64_t *)&lim);
+		g_sof = (err > lim || err < -lim) ? meas : (uint64_t)((int64_t)pred + err / 4);
+	}
+	if (err_out) {
+		*err_out = err;
+	}
+	uint64_t next = g_sof;
+	if (from > next) {
+		next += ((from - next + g_period - 1) / g_period) * g_period;
+	}
+	return next;
+}
+
+uint64_t begonia_disp_period(void);
+uint64_t
+begonia_disp_period(void)
+{
+	return g_period;
+}
+
+/* DCS short write (cmd, one parameter or none) as a video-mode command packet. 0 or an errno. */
+int begonia_disp_dcs(uint8_t cmd, int param);
+int
+begonia_disp_dcs(uint8_t cmd, int param)
+{
+	if (!g_ready || g_dsi == 0 || (g_mode & 3u) == 0) {
+		return ENODEV;
+	}
+	uint32_t con = rd(g_dsi, DSI_VM_CMD_CON);
+	uint32_t low = (con & 0x3du) | 1u;                 /* VM_CMD_EN, keep TIME_SEL and the porch choice */
+	if (!(low & 0x38u)) {
+		low |= 1u << 5;                                 /* TS_VFP_EN: in the vertical front porch */
+	}
+	uint32_t id = param >= 0 ? 0x15u : 0x05u;          /* DCS short write, one / no parameter */
+	uint32_t v = low | (id << 8) | ((uint32_t)cmd << 16) | ((uint32_t)(param >= 0 ? param & 0xff : 0) << 24);
+	wr(g_dsi, DSI_INTSTA, ~DSI_VM_CMD_DONE);           /* write 0 to clear */
+	wr(g_dsi, DSI_VM_CMD_CON, v);
+	uint32_t st = rd(g_dsi, DSI_START);
+	wr(g_dsi, DSI_START, st & ~DSI_VM_CMD_START);
+	wr(g_dsi, DSI_START, st | DSI_VM_CMD_START);
+	for (uint32_t us = 0; us < 60000u; us += 50u) {
+		if (rd(g_dsi, DSI_INTSTA) & DSI_VM_CMD_DONE) {
+			wr(g_dsi, DSI_INTSTA, ~DSI_VM_CMD_DONE);
+			g_dcs_sent++;
+			return 0;
+		}
+		delay(50);
+	}
+	g_dcs_fail++;
+	return ETIMEDOUT;
+}
+
+/* Is the video stream still running (the line counter moves)? For a check after a command packet. */
+bool begonia_disp_alive(void);
+bool
+begonia_disp_alive(void)
+{
+	if (!g_ready || g_counter == 0) {
+		return true;
+	}
+	uint32_t a = counter_now();
+	delay(200);
+	uint32_t b = counter_now();
+	delay(200);
+	uint32_t c = counter_now();
+	return a != b || b != c;
+}
+
+void begonia_disp_stats(uint32_t *sent, uint32_t *failed);
+void
+begonia_disp_stats(uint32_t *sent, uint32_t *failed)
+{
+	*sent = g_dcs_sent;
+	*failed = g_dcs_fail;
+}
+
+/*
+ * 26 Nov 2026: the backlight itself. The user saw the screen stay lit after the panel's DCS 0x51 went to 0: the LK left
+ * the LM36273 (backlight + LCD bias, I2C channel 0 at 0x11007000, address 0x11, begonia.dws I2C_LCD_BIAS) in I2C
+ * brightness mode, where the panel's PWM output means nothing. Android's own driver for this phone (leds-lm36273.c)
+ * switches it with register 0x08 BL_ENABLE: 0x00 = backlight and current sinks off, 0x17 = on (then 0x03 BC2 = 0xcd).
+ * A FIFO-mode write on the MT6785 I2C controller (i2c-mtk.c's sequence, without its DMA and interrupt): the timing and
+ * pin setup the LK programmed are kept; the I2C0 clock gate (infracfg_ao MODULE_SW_CG_0 bit 11) is opened if it is
+ * shut; the interrupt mask stays 0 and completion is polled (INTR_STAT, else START going back to 0), 5 ms at most.
+ */
+#define BGI_I2C0_PA             0x11007000u
+#define BGI_INFRA_PA            0x10001000u
+#define BGI_CG0_CLR             0x84u
+#define BGI_CG0_STA             0x90u
+#define BGI_I2C0_CG             (1u << 11)
+#define BGI_DATA_PORT           0x00u
+#define BGI_SLAVE_ADDR          0x04u
+#define BGI_INTR_MASK           0x08u
+#define BGI_INTR_STAT           0x0cu
+#define BGI_CONTROL             0x10u
+#define BGI_TRANSFER_LEN        0x14u
+#define BGI_TRANSAC_LEN         0x18u
+#define BGI_START               0x24u
+#define BGI_FIFO_ADDR_CLR       0x38u
+#define BGI_INTR_ALL            0x1ffu
+#define BGI_TRANSAC_COMP        0x001u
+#define BGI_ERRORS              0x12eu  /* bus error, timeout, arbitration lost, HS NACK, ACK error */
+static vm_offset_t g_i2c, g_infra;
+static uint32_t g_i2c_ok, g_i2c_fail;
+
+static inline void
+i2c_w16(uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint16_t *)(g_i2c + off) = (uint16_t)v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static inline uint32_t
+i2c_r16(uint32_t off)
+{
+	uint32_t v = *(volatile uint16_t *)(g_i2c + off);
+	__asm__ volatile ("dmb sy" ::: "memory");
+	return v;
+}
+
+/* one register of a 7-bit I2C device on channel 0; 0, or -1 (mapping), -2 (NACK/bus error), -3 (no completion) */
+int begonia_i2c0_write(uint8_t addr7, uint8_t reg, uint8_t val);
+int
+begonia_i2c0_write(uint8_t addr7, uint8_t reg, uint8_t val)
+{
+	if (g_infra == 0) {
+		g_infra = ml_io_map(BGI_INFRA_PA, 0x1000);
+	}
+	if (g_i2c == 0) {
+		g_i2c = ml_io_map(BGI_I2C0_PA, 0x1000);
+	}
+	if (g_i2c == 0 || g_infra == 0) {
+		g_i2c_fail++;
+		return -1;
+	}
+	if (*(volatile uint32_t *)(g_infra + BGI_CG0_STA) & BGI_I2C0_CG) {
+		*(volatile uint32_t *)(g_infra + BGI_CG0_CLR) = BGI_I2C0_CG;     /* the controller's clock on */
+		__asm__ volatile ("dsb sy" ::: "memory");
+		delay(10);
+	}
+	i2c_w16(BGI_CONTROL, (1u << 5) | (1u << 3));           /* ACKERR_DET_EN | CLK_EXT_EN: a plain write */
+	i2c_w16(BGI_SLAVE_ADDR, (uint32_t)addr7 << 1);
+	i2c_w16(BGI_INTR_MASK, 0);
+	i2c_w16(BGI_INTR_STAT, BGI_INTR_ALL);
+	i2c_w16(BGI_FIFO_ADDR_CLR, 1);
+	i2c_w16(BGI_TRANSFER_LEN, 2);
+	i2c_w16(BGI_TRANSAC_LEN, 1);
+	i2c_w16(BGI_DATA_PORT, reg);
+	i2c_w16(BGI_DATA_PORT, val);
+	i2c_w16(BGI_START, 1);
+	uint32_t st = 0;
+	int r = -3;
+	for (int i = 0; i < 500; i++) {         /* 2 bytes at 100..400 kHz take 60..250 us */
+		delay(10);
+		st = i2c_r16(BGI_INTR_STAT);
+		if (st & BGI_ERRORS) {
+			r = -2;
+			break;
+		}
+		if ((st & BGI_TRANSAC_COMP) || (i > 40 && (i2c_r16(BGI_START) & 1u) == 0)) {
+			r = 0;
+			break;
+		}
+	}
+	i2c_w16(BGI_INTR_STAT, BGI_INTR_ALL);
+	if (r == 0) {
+		g_i2c_ok++;
+	} else {
+		g_i2c_fail++;
+		if (g_i2c_fail < 20) {
+			printf("BEGONIA I2C: write %#x reg %#x = %#x failed %d (stat %#x start %#x)\n", addr7, reg, val, r, st,
+			    i2c_r16(BGI_START));
+		}
+	}
+	return r;
+}
+
+/* the LM36273's backlight off (BL_ENABLE 0) or on (BL_ENABLE 0x17, BC2 0xcd), as Android's driver does */
+int begonia_bl_i2c(bool on);
+int
+begonia_bl_i2c(bool on)
+{
+	int r = begonia_i2c0_write(0x11, 0x08, on ? 0x17 : 0x00);
+	if (on && r == 0) {
+		r = begonia_i2c0_write(0x11, 0x03, 0xcd);
+	}
+	printf("BEGONIA I2C: LM36273 backlight %s -> %d (%u ok, %u failed)\n", on ? "on" : "off", r, g_i2c_ok, g_i2c_fail);
+	return r;
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/osfmk/kern/begonia_kprof.c b/osfmk/kern/begonia_kprof.c
new file mode 100644
--- /dev/null
+++ b/osfmk/kern/begonia_kprof.c
@@ -0,0 +1,116 @@
+/*
+ * begonia (Loxy, 26 Nov 2026): a sampling profiler for the USB console ("kprof S" in bsd/dev/begonia_usb.c).
+ *
+ * The UI ran at 1-10 fps with the GPU ~1 % busy, and an unnamed kernel thread at MAXPRI_KERNEL held a whole CPU on
+ * every boot; per-process CPU times ("top") could not say what the CPUs actually execute. Every 10 ms all other CPUs
+ * get a cross-call (cpu_broadcast_xcall_simple, which waits for them); in the IPI each records what it interrupted:
+ * the idle thread, a user PC (and the process), or a kernel PC (unslid, so it can be looked up in the kernel's symbol
+ * table offline) with the thread id and its scheduler priority. Nothing is changed and no lock is taken in the IPI.
+ */
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <kern/kern_types.h>
+#include <kern/thread.h>
+#include <kern/task.h>
+#include <kern/cpu_number.h>
+#include <kern/kalloc.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <arm/cpu_data.h>
+#include <arm/cpu_data_internal.h>
+#include <arm64/proc_reg.h>
+#include <mach/arm/thread_status.h>
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+
+struct begonia_kprof_sample {
+	uint64_t pc;            /* user PC, or the kernel PC unslid */
+	uint64_t tid;
+	int32_t  pid;           /* 0 = kernel_task, -1 = unknown */
+	uint8_t  cpu;
+	uint8_t  mode;          /* 0 idle, 1 user, 2 kernel, 3 no interrupted state */
+	uint8_t  pri;
+	uint8_t  pad;
+};
+
+#define BGK_CPUS        16
+#define BGK_UNANSWERED  0xffu
+
+struct bgk_round {
+	struct begonia_kprof_sample s[BGK_CPUS];
+};
+
+static void
+bgk_cb(void *arg)
+{
+	struct bgk_round *r = (struct bgk_round *)arg;
+	int cpu = cpu_number();
+	if (cpu < 0 || cpu >= BGK_CPUS) {
+		return;
+	}
+	struct begonia_kprof_sample *s = &r->s[cpu];
+	thread_t th = current_thread();
+	s->cpu = (uint8_t)cpu;
+	s->tid = th->thread_id;
+	s->pri = (uint8_t)th->sched_pri;
+	s->pid = -1;
+	s->pc = 0;
+	if (th->options & TH_OPT_IDLE_THREAD) {
+		s->mode = 0;
+		return;
+	}
+	task_t t = get_threadtask(th);
+	if (t == kernel_task) {
+		s->pid = 0;
+	} else if (t != TASK_NULL) {
+		s->pid = task_pid(t);
+	}
+	arm_saved_state_t *st = (arm_saved_state_t *)getCpuDatap()->cpu_int_state;
+	if (st == NULL || !is_saved_state64(st)) {
+		s->mode = 3;
+		return;
+	}
+	uint64_t pc = get_saved_state_pc(st);
+	if (PSR64_IS_USER(get_saved_state_cpsr(st))) {
+		s->mode = 1;
+		s->pc = pc;
+	} else {
+		s->mode = 2;
+		s->pc = (uint64_t)VM_KERNEL_UNSLIDE(pc);
+	}
+}
+
+/* `rounds` samples of every other CPU, `gap_us` apart (the caller's CPU is not sampled); returns the records written */
+uint32_t begonia_kprof_run(struct begonia_kprof_sample *out, uint32_t max, uint32_t rounds, uint32_t gap_us);
+
+uint32_t
+begonia_kprof_run(struct begonia_kprof_sample *out, uint32_t max, uint32_t rounds, uint32_t gap_us)
+{
+	struct bgk_round *r = kalloc_data(sizeof(*r), Z_WAITOK | Z_ZERO);
+	uint32_t n = 0;
+
+	if (r == NULL || out == NULL) {
+		if (r != NULL) {
+			kfree_data(r, sizeof(*r));
+		}
+		return 0;
+	}
+	for (uint32_t i = 0; i < rounds && n < max; i++) {
+		for (int c = 0; c < BGK_CPUS; c++) {
+			r->s[c].mode = BGK_UNANSWERED;
+		}
+		(void)cpu_broadcast_xcall_simple(FALSE, bgk_cb, r);
+		for (int c = 0; c < BGK_CPUS && n < max; c++) {
+			if (r->s[c].mode != BGK_UNANSWERED) {
+				out[n++] = r->s[c];
+			}
+		}
+		if (gap_us != 0) {
+			delay((int)gap_us);
+		}
+	}
+	kfree_data(r, sizeof(*r));
+	return n;
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
