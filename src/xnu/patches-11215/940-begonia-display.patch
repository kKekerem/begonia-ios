+/*
+ * 26 Nov 2026: files of the running iOS without going back to Android. "tail N PATH" prints the last N bytes (at most
+ * 48 KB) of a file as console lines; "touch PATH" / "rm PATH" create / remove one (Chlorophyll's switch files in
+ * /private/var/tmp, read by the processes when they start their GPU device).
+ */
+extern int unlink1(vfs_context_t ctx, vnode_t start_dvp, user_addr_t path_arg, enum uio_seg segflg, int unlink_flags);
+
+static void
+usb_file_tail(uint32_t n, const char *path)
+{
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx = vfs_context_kernel();
+	int err = vnode_open(path, FREAD | O_NOFOLLOW, 0, 0, &vp, ctx);
+	if (err != 0) {
+		printf("BEGONIA FILE: %s: open error %d\n", path, err);
+		return;
+	}
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_data_size);
+	off_t size = 0;
+	if (vnode_getattr(vp, &va, ctx) == 0) {
+		size = (off_t)va.va_data_size;
+	}
+	if (n == 0u || n > 49152u) {
+		n = 49152u;
+	}
+	off_t off = size > (off_t)n ? size - (off_t)n : 0;
+	int len = (int)(size - off);
+	char *buf = kalloc_data((vm_size_t)len + 1u, Z_WAITOK | Z_ZERO);
+	if (buf == NULL) {
+		vnode_close(vp, FREAD, ctx);
+		printf("BEGONIA FILE: no memory\n");
+		return;
+	}
+	int resid = 0;
+	err = vn_rdwr(UIO_READ, vp, buf, len, off, UIO_SYSSPACE, IO_NOAUTH, vfs_context_ucred(ctx), &resid,
+	    vfs_context_proc(ctx));
+	vnode_close(vp, FREAD, ctx);
+	printf("BEGONIA FILE: %s: %lld bytes, showing %d from %lld (read error %d)\n", path, (long long)size, len - resid,
+	    (long long)off, err);
+	int got = len - resid, start = 0;
+	for (int i = 0; i <= got; i++) {
+		if (i == got || buf[i] == '\n' || i - start >= 200) {
+			char c = buf[i];
+			buf[i] = '\0';
+			if (i > start) {
+				printf("BEGONIA FILE| %s\n", buf + start);
+			}
+			if (i < got) {
+				buf[i] = c;
+			}
+			start = (i < got && c == '\n') ? i + 1 : i;
+		}
+	}
+	kfree_data(buf, (vm_size_t)len + 1u);
+}
+
+static void
+usb_file_touch(const char *path)
+{
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx = vfs_context_kernel();
+	int err = vnode_open(path, O_CREAT | FWRITE | O_NOFOLLOW, 0644, 0, &vp, ctx);
+	if (err == 0) {
+		vnode_close(vp, FWRITE, ctx);
+	}
+	printf("BEGONIA FILE: touch %s -> %d\n", path, err);
+}
+
+static void
+usb_file_rm(const char *path)
+{
+	int err = unlink1(vfs_context_kernel(), NULLVP, CAST_USER_ADDR_T(path), UIO_SYSSPACE, 0);
+	printf("BEGONIA FILE: rm %s -> %d\n", path, err);
+}
+
+/*
+ * "ucstat S NAME" (26 Nov 2026): S seconds of the IOKit external methods NAME's threads call in our drivers (1 SweetMali,
+ * 2 IOSurface, 3 IOMobileFramebuffer), per selector: calls, total time and the longest call. backboardd spent about half
+ * of its CPU in the kernel at ~20 fps; this says how much of it is ours.
+ */
+static uint64_t uc_cnt[4][64], uc_tot[4][64], uc_max[4][64];
+static volatile int uc_pid = -1;        /* -1 off, else only this pid (0: every process) */
+static uint64_t uc_t0, uc_at;
+static char uc_name[32];
+
+void begonia_uc_account(uint32_t cls, uint32_t sel, uint64_t abs);
+void
+begonia_uc_account(uint32_t cls, uint32_t sel, uint64_t abs)
+{
+	int want = uc_pid;
+	if (want < 0 || cls >= 4u || (want > 0 && proc_selfpid() != want)) {
+		return;
+	}
+	sel &= 63u;     /* 950: SweetMali's selectors are 0x40..0x7d (SUBMIT 0x40 -> 0, CREATE_BO 0x42 -> 2, WAIT_SEQ 0x7d -> 61) */
+	uc_cnt[cls][sel]++;
+	uc_tot[cls][sel] += abs;
+	if (abs > uc_max[cls][sel]) {
+		uc_max[cls][sel] = abs;
+	}
+}
+
+static int
+uc_find_cb(proc_t p, void *arg)
+{
+	char name[32];
+	proc_name(proc_pid(p), name, sizeof(name));
+	if (strcmp(name, uc_name) == 0) {
+		*(int *)arg = proc_pid(p);
+		return PROC_RETURNED_DONE;
+	}
+	return PROC_RETURNED;
+}
+
+static void
+uc_start(uint32_t secs, const char *name)
+{
+	int pid = 0;
+	strlcpy(uc_name, name, sizeof(uc_name));
+	if (name[0] != '\0' && strcmp(name, "all") != 0) {
+		pid = -1;
+		proc_iterate(PROC_ALLPROCLIST, uc_find_cb, &pid, NULL, NULL);
+		if (pid <= 0) {
+			printf("BEGONIA UC: no process %s\n", name);
+			return;
+		}
+	}
+	bzero(uc_cnt, sizeof(uc_cnt));
+	bzero(uc_tot, sizeof(uc_tot));
+	bzero(uc_max, sizeof(uc_max));
+	uint64_t d;
+	nanoseconds_to_absolutetime((uint64_t)(secs < 1u ? 1u : (secs > 30u ? 30u : secs)) * NSEC_PER_SEC, &d);
+	uc_t0 = mach_absolute_time();
+	uc_at = uc_t0 + d;
+	uc_pid = pid;
+}
+
+static void
+uc_poll(void)
+{
+	if (uc_pid < 0 || mach_absolute_time() < uc_at) {
+		return;
+	}
+	int pid = uc_pid;
+	uc_pid = -1;
+	uint64_t wall_ns = 0, ns = 0, mx = 0, all = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time() - uc_t0, &wall_ns);
+	static const char *const cls_name[4] = { "?", "mali", "surface", "iomfb" };
+	for (uint32_t c = 1; c < 4u; c++) {
+		for (uint32_t k = 0; k < 64u; k++) {
+			all += uc_tot[c][k];
+		}
+	}
+	absolutetime_to_nanoseconds(all, &ns);
+	printf("BEGONIA UC: %s (pid %d) %llu ms: %llu ms in our external methods (%llu.%01llu%% of one CPU)\n", uc_name, pid,
+	    wall_ns / 1000000ull, ns / 1000000ull, wall_ns ? ns * 100ull / wall_ns : 0ull, wall_ns ? (ns * 1000ull / wall_ns) % 10ull : 0ull);
+	for (uint32_t c = 1; c < 4u; c++) {
+		for (uint32_t k = 0; k < 64u; k++) {
+			if (uc_cnt[c][k] == 0u) {
+				continue;
+			}
+			absolutetime_to_nanoseconds(uc_tot[c][k], &ns);
+			absolutetime_to_nanoseconds(uc_max[c][k], &mx);
+			printf("BEGONIA UC:   %-7s sel %2u: %6llu calls, %6llu us total, %5llu us max, %4llu us each\n", cls_name[c], k,
+			    uc_cnt[c][k], ns / 1000ull, mx / 1000ull, ns / 1000ull / uc_cnt[c][k]);
+		}
+	}
+}
+
+static int
+smp_cb(proc_t p, __unused void *arg)
+{
+	char name[32];
+	proc_name(proc_pid(p), name, sizeof(name));
+	if (strcmp(name, smp_name) == 0) {
+		task_t task = proc_task(p);
+		if (task != TASK_NULL) {
+			sweet_sample_task(name, proc_pid(p), task);
+		}
+	}
+	return PROC_RETURNED;
+}
+
+static bool
+parse_ints(const char *s, int *v, int n)
+{
+	for (int i = 0; i < n; i++) {
+		while (*s == ' ') {
+			s++;
+		}
+		if (*s < '0' || *s > '9') {
+			return false;
+		}
+		int x = 0;
+		while (*s >= '0' && *s <= '9') {
+			x = x * 10 + (*s++ - '0');
+		}
+		v[i] = x;
+	}
+	return true;
+}
+
+/*
+ * 26 Nov 2026 (940 v7): CPU clocks. Nothing on the iOS path runs MediaTek's CPU DVFS (Android's kernel asks the SSPM's
+ * DVFS processor through CSRAM 0x0011bc00), so every core stays at the OPP the boot loader left: A55 (LL, cpu0-5)
+ * 1175 MHz, A76 (L, cpu6-7) 1085 MHz. "cpuopp LL L" (MHz, 0 = leave) sets an OPP of the MT6785T table (frequencies
+ * and Vproc from Android's mtk_cpufreq_opp_table.h, the higher of that and this phone's /proc/cpufreq table):
+ * MT6359 VPROC2 (LL, shared with the CCI) / VPROC1 (L) through the PMIC wrapper, VSRAM by the PMIC's hardware tracking
+ * (else by hand: Vproc + 100 mV, 850..1120 mV), then the cluster PLL (ARMPLL_LL / ARMPLL_L CON1, apmixed 0x1000c000 +
+ * 0x204 / 0x214) moved in steps of at most 50 MHz with its post-divider kept (the VCO stays inside what the table
+ * uses: at most 3340 MHz). Up: voltage, then clock; down: clock, then voltage, never below what the boot loader set.
+ * "cpuinfo" prints the registers. Volatile: every boot starts from the boot loader's OPP again.
+ */
+extern bool begonia_pmic_read(uint32_t reg, uint32_t *val);
+extern bool begonia_pmic_write(uint32_t reg, uint32_t val);
+extern void delay(int usec);
+extern int begonia_bl_i2c(bool on);
+
+#define BGC_APMIXED             0x1000c000u
+#define BGC_MCUCFG_DIV          0x0c53a000u     /* MP0/MP1/BUS_PLL_DIVIDER at +0x2a0/+0x2a4/+0x2e0 */
+#define BGC_VSRAM1_DA           0x1e8eu         /* LDO_VSRAM_PROC1_VOSEL1, bits 14:8 */
+#define BGC_VSRAM2_DA           0x1eacu
+
+struct bgc_cluster {
+	const char *name;
+	uint32_t con1, div;                     /* offsets: apmixed CON1, divider config */
+	uint32_t vset, vda, sset, strack, sda;  /* MT6359: VPROC ELR0 / DBG0, VSRAM ELR / TRACK0 / VOSEL1 */
+	const uint16_t (*opp)[2];               /* MHz, mV */
+	uint32_t nopp;
+	uint32_t boot_vsel, boot_svsel, boot_dds;   /* saved at the first change */
+	bool saved;
+};
+/*
+ * 26 Nov 2026: the rest of MTK's 6785T table (mtk_cpufreq_opp_table.h, MiCode begonia-r-oss: CPU_DVFS_FREQn_L/LL_6785T
+ * with VOLTn_VPROC1/2_6785T): L up to 2050 MHz at 1031.25 mV, LL up to 1733 at 1012.5 mV (its 1800..2000 MHz rows need
+ * 1037..1119 mV on six cores without any thermal control here: left out).
+ */
+static const uint16_t bgc_opp_ll[][2] = {
+	{ 1733, 1013 }, { 1666, 982 }, { 1618, 957 }, { 1500, 913 }, { 1375, 875 }, { 1275, 844 }, { 1175, 800 },
+};
+static const uint16_t bgc_opp_l[][2] = {
+	{ 2050, 1032 }, { 1986, 1007 }, { 1923, 982 }, { 1860, 950 },
+	{ 1796, 925 }, { 1733, 907 }, { 1670, 900 }, { 1530, 857 }, { 1419, 825 }, { 1308, 800 }, { 1169, 775 }, { 1085, 750 },
+};
+static struct bgc_cluster bgc[2] = {
+	{ "LL", 0x204, 0x2a0, 0x17b2, 0x17a6, 0x1b42, 0x1ebe, BGC_VSRAM2_DA, bgc_opp_ll,
+	  (uint32_t)(sizeof(bgc_opp_ll) / sizeof(bgc_opp_ll[0])), 0, 0, 0, false },
+	{ "L", 0x214, 0x2a4, 0x172e, 0x1726, 0x1b40, 0x1ea0, BGC_VSRAM1_DA, bgc_opp_l,
+	  (uint32_t)(sizeof(bgc_opp_l) / sizeof(bgc_opp_l[0])), 0, 0, 0, false },
+};
+static vm_offset_t bgc_apm, bgc_mcu;
+
+static bool
+bgc_map(void)
+{
+	if (bgc_apm == 0) {
+		bgc_apm = ml_io_map(BGC_APMIXED, 0x1000);
+	}
+	if (bgc_mcu == 0) {
+		bgc_mcu = ml_io_map(BGC_MCUCFG_DIV, 0x1000);
+	}
+	return bgc_apm != 0 && bgc_mcu != 0;
+}
+
+static inline uint32_t
+bgc_rd(vm_offset_t b, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(b + off);
+	__asm__ volatile ("dmb sy" ::: "memory");
+	return v;
+}
+
+static inline void
+bgc_wr(vm_offset_t b, uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(b + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* PLL output in MHz from CON1: 26 MHz x PCW / 2^14, then the post-divider (bits 26:24) */
+static uint32_t
+bgc_mhz(uint32_t con1)
+{
+	uint32_t vco = (uint32_t)(((uint64_t)(con1 & 0x3fffffu) * 26u) >> 14);
+	return vco >> ((con1 >> 24) & 7u);
+}
+
+static void
+bgc_info(void)
+{
+	if (!bgc_map()) {
+		printf("BEGONIA CPU: no mapping\n");
+		return;
+	}
+	for (int c = 0; c < 2; c++) {
+		struct bgc_cluster *k = &bgc[c];
+		uint32_t con1 = bgc_rd(bgc_apm, k->con1), div = bgc_rd(bgc_mcu, k->div);
+		uint32_t vs = 0, vd = 0, ss = 0, st = 0, sd = 0;
+		bool ok = begonia_pmic_read(k->vset, &vs) && begonia_pmic_read(k->vda, &vd) && begonia_pmic_read(k->sset, &ss) &&
+		    begonia_pmic_read(k->strack, &st) && begonia_pmic_read(k->sda, &sd);
+		printf("BEGONIA CPU: %s CON1 %#x (%u MHz, postdiv %u) div %#x (mux %u, ckdiv %u) | PMIC %s vproc set %u (%u mV) "
+		    "now %u (%u mV), vsram set %u (%u mV) now %u (%u mV), track %#x\n",
+		    k->name, con1, bgc_mhz(con1), 1u << ((con1 >> 24) & 7u), div, (div >> 9) & 3u, (div >> 17) & 31u,
+		    ok ? "ok" : "READ FAILED", vs & 0x7fu, 400u + (vs & 0x7fu) * 25u / 4u, vd & 0x7fu, 400u + (vd & 0x7fu) * 25u / 4u,
+		    ss & 0x7fu, 500u + (ss & 0x7fu) * 25u / 4u, (sd >> 8) & 0x7fu, 500u + ((sd >> 8) & 0x7fu) * 25u / 4u, st);
+	}
+	printf("BEGONIA CPU: CCIPLL CON1 %#x (%u MHz), BUS div %#x, FHCTL HP_EN %#x\n", bgc_rd(bgc_apm, 0x2a4),
+	    bgc_mhz(bgc_rd(bgc_apm, 0x2a4)), bgc_rd(bgc_mcu, 0x2e0), bgc_rd(bgc_apm, 0xe00));
+}
+
+/* Vproc to mV and back (MT6359 buck: 400 mV + 6.25 mV a step, 7 bits) */
+static uint32_t
+bgc_vsel(uint32_t mv)
+{
+	return (mv <= 400u) ? 0u : ((mv - 400u) * 4u + 24u) / 25u;
+}
+
+static bool
+bgc_set_volt(struct bgc_cluster *k, uint32_t vsel, bool tracking)
+{
+	uint32_t cur = 0;
+	if (vsel > 115u || !begonia_pmic_read(k->vda, &cur)) {     /* 115 = 1118.75 mV, the table's top */
+		return false;
+	}
+	cur &= 0x7fu;
+	uint32_t mv = 400u + vsel * 25u / 4u;
+	uint32_t smv = mv + 100u < 850u ? 850u : (mv + 100u > 1120u ? 1120u : mv + 100u);
+	uint32_t ssel = (smv - 500u) * 4u / 25u;
+	if (!tracking && vsel > cur && !begonia_pmic_write(k->sset, ssel)) {
+		return false;   /* up: SRAM first */
+	}
+	if (!begonia_pmic_write(k->vset, vsel)) {
+		return false;
+	}
+	uint32_t d = vsel > cur ? vsel - cur : cur - vsel;      /* steps of 6.25 mV; up 10 mV/us, down 7.5 mV/us */
+	delay((int)(d + 25u));
+	for (int i = 0; i < 20; i++) {
+		uint32_t now = 0;
+		if (begonia_pmic_read(k->vda, &now) && (now & 0x7fu) == vsel) {
+			if (!tracking && vsel < cur) {
+				(void)begonia_pmic_write(k->sset, ssel);        /* down: SRAM after */
+			}
+			return true;
+		}
+		delay(20);
+	}
+	return false;
+}
+
+/* the PLL to `mhz` with its post-divider kept, in steps of at most 50 MHz at the output */
+static bool
+bgc_set_clock(struct bgc_cluster *k, uint32_t mhz)
+{
+	uint32_t con1 = bgc_rd(bgc_apm, k->con1);
+	uint32_t pd = (con1 >> 24) & 7u;
+	uint32_t vco = mhz << pd;
+	if (pd > 2u || vco < 1000u || vco > 3340u) {
+		printf("BEGONIA CPU: %s: VCO %u MHz with post-divider %u is outside what the table uses\n", k->name, vco, 1u << pd);
+		return false;
+	}
+	uint32_t target = (vco << 14) / 26u;
+	uint32_t cur = con1 & 0x3fffffu;
+	uint32_t step = ((50u << pd) << 14) / 26u;
+	while (cur != target) {
+		uint32_t next = cur < target ? (target - cur > step ? cur + step : target) : (cur - target > step ? cur - step : target);
+		uint32_t v = (bgc_rd(bgc_apm, k->con1) & ~0x3fffffu) | next | (1u << 31);
+		bgc_wr(bgc_apm, k->con1, v);
+		delay(20);
+		cur = next;
+	}
+	return true;
+}
+
+static void
+bgc_opp(int c, uint32_t mhz)
+{
+	struct bgc_cluster *k = &bgc[c];
+	uint32_t mv = 0;
+	for (uint32_t i = 0; i < k->nopp; i++) {
+		if (k->opp[i][0] == mhz) {
+			mv = k->opp[i][1];
+		}
+	}
+	if (mv == 0) {
+		printf("BEGONIA CPU: %s %u MHz is not one of its OPPs here\n", k->name, mhz);
+		return;
+	}
+	uint32_t track = 0, vda = 0, sda = 0;
+	if (!bgc_map() || !begonia_pmic_read(k->strack, &track) || !begonia_pmic_read(k->vda, &vda) ||
+	    !begonia_pmic_read(k->sset, &sda)) {
+		printf("BEGONIA CPU: %s: PMIC not readable, nothing changed\n", k->name);
+		return;
+	}
+	if (bgc_rd(bgc_apm, 0xe00) & (c == 0 ? 1u : 2u)) {
+		printf("BEGONIA CPU: %s: its PLL is under frequency hopping control, nothing changed\n", k->name);
+		return;
+	}
+	if (!k->saved) {
+		k->boot_vsel = vda & 0x7fu;
+		k->boot_svsel = sda & 0x7fu;
+		k->boot_dds = bgc_rd(bgc_apm, k->con1) & 0x3fffffu;
+		k->saved = true;
+	}
+	bool tracking = (track & 1u) != 0;
+	uint32_t vsel = bgc_vsel(mv);
+	if (vsel < k->boot_vsel) {
+		vsel = k->boot_vsel;            /* never below what the boot loader chose (the CCI shares VPROC2) */
+	}
+	uint32_t was = bgc_mhz(bgc_rd(bgc_apm, k->con1));
+	bool ok;
+	if (mhz >= was) {
+		ok = bgc_set_volt(k, vsel, tracking) && bgc_set_clock(k, mhz);
+	} else {
+		ok = bgc_set_clock(k, mhz) && bgc_set_volt(k, vsel, tracking);
+	}
+	printf("BEGONIA CPU: %s %u -> %u MHz at %u mV (vsel %u, sram %s): %s\n", k->name, was, bgc_mhz(bgc_rd(bgc_apm, k->con1)),
+	    400u + vsel * 25u / 4u, vsel, tracking ? "tracked by the PMIC" : "set by hand", ok ? "done" : "FAILED");
+}
+
+/*
+ * 26 Nov 2026 (940 v8): the Mali clock above the 375..620 MHz begoniamalimhz accepts. This phone's own GPU table (Android
+ * /proc/gpufreq, binned): 806 MHz at 706.25 mV, 778 at 700, 720 at 681.25, 620 at 643.75, 545 at 631.25, VSRAM_GPU 850 mV
+ * throughout; the Mali driver (910) already runs VGPU at 700 mV with MFGPLL at begoniamalimhz. "gpumhz N" and
+ * begoniagpumhz=N (545..806, applied 20 s after boot, once the Mali driver has set its clock): VGPU to 712.5 mV first
+ * (MT6359 VGPU11 ELR0 0x15ac, 0.4 V + 6.25 mV a step; never lowered), then MFGPLL re-tuned the way mtk_gpufreq does it:
+ * mfg_sel parked on mainpll_d5, CON1 = PCW_CHG | POSDIV /4 | DDS, 20 us, back to mfgpll_ck.
+ */
+#define BGG_TOPCK               0x10000000u
+#define BGG_CLK_CFG_UPDATE      0x0004u
+#define BGG_CK_CFG_3_SET        0x0054u
+#define BGG_CK_CFG_3_CLR        0x0058u
+#define BGG_MFGPLL_CON1         0x0254u
+#define BGG_VGPU11_ELR0         0x15acu
+static vm_offset_t bgg_topck;
+
+static void
+bgg_set(uint32_t mhz)
+{
+	if (mhz < 545u || mhz > 806u) {
+		printf("BEGONIA GPU: %u MHz is outside 545..806\n", mhz);
+		return;
+	}
+	if (bgg_topck == 0) {
+		bgg_topck = ml_io_map(BGG_TOPCK, 0x1000);
+	}
+	uint32_t elr = 0;
+	if (bgg_topck == 0 || !bgc_map() || !begonia_pmic_read(BGG_VGPU11_ELR0, &elr)) {
+		printf("BEGONIA GPU: no mapping or PMIC not readable, nothing changed\n");
+		return;
+	}
+	uint32_t was = bgc_mhz(bgc_rd(bgc_apm, BGG_MFGPLL_CON1));
+	if ((elr & 0x7fu) < 50u) {
+		if (!begonia_pmic_write(BGG_VGPU11_ELR0, (elr & ~0x7fu) | 50u)) {
+			printf("BEGONIA GPU: VGPU write failed, nothing changed\n");
+			return;
+		}
+		delay(80);
+	}
+	(void)begonia_pmic_read(BGG_VGPU11_ELR0, &elr);
+	bgc_wr(bgg_topck, BGG_CK_CFG_3_CLR, 0xffu << 16);
+	bgc_wr(bgg_topck, BGG_CK_CFG_3_SET, 3u << 16);          /* mfg_sel = mainpll_d5 while the PLL moves */
+	bgc_wr(bgg_topck, BGG_CLK_CFG_UPDATE, 1u << 14);
+	delay(10);
+	uint32_t dds = (uint32_t)((((uint64_t)mhz * 4ull) << 14) / 26ull) & 0x3fffffu;
+	bgc_wr(bgc_apm, BGG_MFGPLL_CON1, (1u << 31) | (2u << 24) | dds);
+	delay(20);
+	bgc_wr(bgg_topck, BGG_CK_CFG_3_CLR, 0xffu << 16);
+	bgc_wr(bgg_topck, BGG_CK_CFG_3_SET, 1u << 16);          /* back to mfgpll_ck */
+	bgc_wr(bgg_topck, BGG_CLK_CFG_UPDATE, 1u << 14);
+	delay(10);
+	printf("BEGONIA GPU: MFGPLL %u -> %u MHz, VGPU %u mV\n", was, bgc_mhz(bgc_rd(bgc_apm, BGG_MFGPLL_CON1)),
+	    400u + (elr & 0x7fu) * 25u / 4u);
+}
