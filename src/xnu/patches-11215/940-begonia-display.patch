+	}
+	if (secs > 6u) {
+		secs = 6u;
+	}
+	uint32_t rounds = secs * 100u, max = rounds * 8u;
+	struct begonia_kprof_sample *s = kalloc_data(max * sizeof(*s), Z_WAITOK | Z_ZERO);
+	struct kp_cnt *procs = kalloc_data(3u * KP_TOP * sizeof(struct kp_cnt), Z_WAITOK | Z_ZERO);
+	if (s == NULL || procs == NULL) {
+		printf("BEGONIA KPROF: no memory\n");
+		if (s != NULL) {
+			kfree_data(s, max * sizeof(*s));
+		}
+		if (procs != NULL) {
+			kfree_data(procs, 3u * KP_TOP * sizeof(struct kp_cnt));
+		}
+		return;
+	}
+	struct kp_cnt *kthr = procs + KP_TOP, *kpcs = procs + 2u * KP_TOP;
+	uint32_t np = 0, nk = 0, nc = 0;
+	uint32_t n = begonia_kprof_run(s, max, rounds, 10000u);
+	uint32_t m[4] = { 0, 0, 0, 0 }, cpu_busy[16], cpu_all[16];
+	bzero(cpu_busy, sizeof(cpu_busy));
+	bzero(cpu_all, sizeof(cpu_all));
+	for (uint32_t i = 0; i < n; i++) {
+		uint32_t md = s[i].mode < 3u ? s[i].mode : 3u;
+		m[md]++;
+		if (s[i].cpu < 16u) {
+			cpu_all[s[i].cpu]++;
+			if (md != 0u) {
+				cpu_busy[s[i].cpu]++;
+			}
+		}
+		if (md == 0u) {
+			continue;
+		}
+		if (s[i].pid > 0) {
+			kp_add(procs, &np, (uint64_t)s[i].pid, 0, md == 2u, s[i].pri);
+		} else if (s[i].pid == 0) {
+			kp_add(kthr, &nk, s[i].tid, s[i].pc, false, s[i].pri);
+		}
+		if (md == 2u) {
+			kp_add(kpcs, &nc, s[i].pc, s[i].tid, false, (uint32_t)(s[i].pid < 0 ? 0 : s[i].pid));
+		}
+	}
+	uint32_t tot = n ? n : 1u;
+	printf("BEGONIA KPROF: %u samples in %u s (%u rounds): idle %u%%, user %u%%, kernel %u%%, no state %u%%\n", n, secs,
+	    rounds, m[0] * 100u / tot, m[1] * 100u / tot, m[2] * 100u / tot, m[3] * 100u / tot);
+	char line[220];
+	size_t l = (size_t)snprintf(line, sizeof(line), "BEGONIA KPROF: busy");
+	for (uint32_t c = 0; c < 16u && l < sizeof(line) - 16u; c++) {
+		if (cpu_all[c] != 0u) {
+			l += (size_t)snprintf(line + l, sizeof(line) - l, " cpu%u=%u%%", c, cpu_busy[c] * 100u / cpu_all[c]);
+		}
+	}
+	printf("%s\n", line);
+	for (uint32_t k = 0; k < 18u; k++) {
+		uint32_t b = kp_pick(procs, np);
+		if (b == KP_TOP) {
+			break;
+		}
+		char name[32];
+		proc_name((int)procs[b].key, name, sizeof(name));
+		printf("BEGONIA KPROF:   %-20s %5llu %3u%% of a core (user %u, kernel %u samples, pri %u)\n", name,
+		    procs[b].key, (procs[b].n + procs[b].n2) * 100u / rounds, procs[b].n, procs[b].n2, procs[b].pri);
+		procs[b].n = procs[b].n2 = 0;
+	}
+	for (uint32_t k = 0; k < 8u; k++) {
+		uint32_t b = kp_pick(kthr, nk);
+		if (b == KP_TOP) {
+			break;
+		}
+		printf("BEGONIA KPROF:   kthread tid %llu pri %u: %u%% of a core, pc %#llx\n", kthr[b].key, kthr[b].pri,
+		    kthr[b].n * 100u / rounds, kthr[b].aux);
+		kthr[b].n = 0;
+	}
+	for (uint32_t k = 0; k < 24u; k++) {
+		uint32_t b = kp_pick(kpcs, nc);
+		if (b == KP_TOP) {
+			break;
+		}
+		printf("BEGONIA KPROF:   kpc %#llx: %u (tid %llu, pid %u)\n", kpcs[b].key, kpcs[b].n, kpcs[b].aux, kpcs[b].pri);
+		kpcs[b].n = 0;
+	}
+	kfree_data(s, max * sizeof(*s));
+	kfree_data(procs, 3u * KP_TOP * sizeof(struct kp_cnt));
+}
