+static uint32_t
+kp_pick(struct kp_cnt *t, uint32_t nt)
+{
+	uint32_t best = KP_TOP;
+	for (uint32_t i = 0; i < nt; i++) {
+		if (t[i].n + t[i].n2 != 0u && (best == KP_TOP || t[i].n + t[i].n2 > t[best].n + t[best].n2)) {
+			best = i;
+		}
+	}
+	return best;
+}
