+static void
+kp_add(struct kp_cnt *t, uint32_t *nt, uint64_t key, uint64_t aux, bool second, uint32_t pri)
+{
+	for (uint32_t i = 0; i < *nt; i++) {
+		if (t[i].key == key) {
+			if (second) {
+				t[i].n2++;
+			} else {
+				t[i].n++;
+			}
+			return;
+		}
+	}
+	if (*nt < KP_TOP) {
+		t[*nt].key = key;
+		t[*nt].aux = aux;
+		t[*nt].n = second ? 0u : 1u;
+		t[*nt].n2 = second ? 1u : 0u;
+		t[*nt].pri = pri;
+		(*nt)++;
+	}
+}
