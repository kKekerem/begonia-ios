+/*
+ * begonia 940: CPU <-> Mali coherency of plain IOSurfaces. Their memory is mapped write-back cacheable in the kernel and in
+ * every client, and the MT6785 Mali is not IO-coherent: what the CPU drew could still sit in its caches when the GPU
+ * sampled the surface (small pictures -- icons, previews -- came out transparent), and what the GPU drew could be shadowed
+ * by stale lines when the CPU read it. IOSurface's own locking is the contract: a write-unlock pushes the CPU's lines to
+ * memory (dc cvac, the lines stay valid), and a lock after GPU writes (gpuBlits, counted per job by SweetMali) drops the
+ * stale ones first (dc civac). Pool surfaces keep their own rules (zcclean); surfaces never locked by the CPU (the
+ * compositor's framebuffers) cost nothing here.
+ */
+static void
+sweet_dma_clean_va(const void *va, size_t len)
+{
+	uint64_t ctr;
+	__asm__ volatile ("mrs %0, ctr_el0" : "=r"(ctr));
+	uintptr_t line = (uintptr_t)4 << ((ctr >> 16) & 0xf);
+	uintptr_t p = (uintptr_t)va & ~(line - 1);
+	uintptr_t end = (uintptr_t)va + len;
+
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (; p < end; p += line) {
+		__asm__ volatile ("dc cvac, %0" :: "r"(p) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void
+sweet_surface_cpu_release(SweetSurface *s)
+{
+	if (!sweet_board_begonia() || s->pooled || s->wrapped || s->memory == NULL ||
+	    OSDynamicCast(IOBufferMemoryDescriptor, s->memory) == NULL) {
+		return;         /* wrapped client memory: SweetMali cleans it around every job; physical: write-combined */
+	}
+	uintptr_t kva = s->kernelAddress();
+	if (kva != 0 && s->allocSize != 0 && s->allocSize <= s->memory->getLength()) {
+		sweet_dma_clean_va((const void *)kva, s->allocSize);
+	}
+}
+
+static void
+sweet_surface_cpu_acquire(SweetSurface *s)
+{
+	if (!sweet_board_begonia() || s->pooled || s->wrapped || s->memory == NULL ||
+	    OSDynamicCast(IOBufferMemoryDescriptor, s->memory) == NULL) {
+		return;
+	}
+	uint32_t g = __atomic_load_n(&s->gpuBlits, __ATOMIC_ACQUIRE);
+	if (g == s->gpuBlitsCpuSeen) {
+		return;
+	}
+	uintptr_t kva = s->kernelAddress();
+	if (kva != 0 && s->allocSize != 0 && s->allocSize <= s->memory->getLength()) {
+		sweet_dma_sync_va((const void *)kva, s->allocSize);
+	}
+	s->gpuBlitsCpuSeen = g;
+}
