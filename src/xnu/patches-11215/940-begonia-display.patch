+/*
+ * 26 Nov 2026 (Loxy 940): touches without a finger. "tap X Y" and "swipe X0 Y0 X1 Y1 MS" in panel pixels (1080x2340) go
+ * to SweetHIDTouch as finger 0: down, a move every 8 ms along the line, up. One at a time; the poll loop runs them.
+ */
+#define INJ_PANEL_H 2340u
+static struct {
+	bool     active, down;
+	int      x0, y0, x1, y1;
+	uint64_t t0, dur, next, step;
+} inj;
+
+static int
+inj_hid_y(int y)
+{
+	int v = (int)(((uint32_t)(y < 0 ? 0 : y) * 2400u + INJ_PANEL_H / 2u) / INJ_PANEL_H);
+	return v > 2399 ? 2399 : v;
+}
+
+static void
+inj_start(int x0, int y0, int x1, int y1, uint32_t ms)
+{
+	if (inj.active && inj.down) {
+		sweet_hid_touch(0, 0, inj.x1, inj_hid_y(inj.y1));
+	}
+	inj.x0 = x0;
+	inj.y0 = y0;
+	inj.x1 = x1;
+	inj.y1 = y1;
+	nanoseconds_to_absolutetime((uint64_t)(ms < 30u ? 30u : (ms > 5000u ? 5000u : ms)) * NSEC_PER_MSEC, &inj.dur);
+	nanoseconds_to_absolutetime(8ULL * NSEC_PER_MSEC, &inj.step);
+	inj.t0 = mach_absolute_time();
+	inj.next = inj.t0;
+	inj.down = false;
+	inj.active = true;
+}
+
+static void
+inj_poll(void)
+{
+	if (!inj.active) {
+		return;
+	}
+	uint64_t now = mach_absolute_time();
+	if (now < inj.next) {
+		return;
+	}
+	inj.next = now + inj.step;
+	uint64_t el = now - inj.t0;
+	if (el >= inj.dur) {
+		if (inj.down) {
+			sweet_hid_touch(0, 1, inj.x1, inj_hid_y(inj.y1));
+		}
+		sweet_hid_touch(0, 0, inj.x1, inj_hid_y(inj.y1));
+		inj.active = inj.down = false;
+		return;
+	}
+	int x = inj.x0 + (int)(((int64_t)(inj.x1 - inj.x0) * (int64_t)el) / (int64_t)inj.dur);
+	int y = inj.y0 + (int)(((int64_t)(inj.y1 - inj.y0) * (int64_t)el) / (int64_t)inj.dur);
+	sweet_hid_touch(0, 1, x, inj_hid_y(y));
+	inj.down = true;
+}
+
+/*
+ * "top [S]": CPU time of every process over S seconds (default 5; live threads, user + system), the 14 busiest.
+ * "smp NAME": the threads of the processes called NAME with their user backtraces (Bergamota's sampler).
+ */
+#define TOP_MAX 200
+struct top_ent {
+	int      pid;
+	char     name[24];
+	uint64_t us;
+	uint64_t sys;           /* 26 Nov: system part (traps such as the FJCVTZS emulation, syscalls) */
+};
+static struct top_ent top_a[TOP_MAX], top_b[TOP_MAX];
+static uint32_t top_na, top_nb;
+static uint64_t top_t0, top_at;
+static struct top_ent *top_fill;
+static uint32_t *top_fill_n;
+static char smp_name[32];
+
+static int
+top_cb(proc_t p, __unused void *arg)
+{
+	if (*top_fill_n >= TOP_MAX) {
+		return PROC_RETURNED;
+	}
+	task_t task = proc_task(p);
+	if (task == TASK_NULL) {
+		return PROC_RETURNED;
+	}
+	struct task_thread_times_info tt;
+	mach_msg_type_number_t cnt = TASK_THREAD_TIMES_INFO_COUNT;
+	if (task_info(task, TASK_THREAD_TIMES_INFO, (task_info_t)&tt, &cnt) != KERN_SUCCESS) {
+		return PROC_RETURNED;
+	}
+	struct top_ent *e = &top_fill[(*top_fill_n)++];
+	e->pid = proc_pid(p);
+	proc_name(e->pid, e->name, sizeof(e->name));
+	e->sys = (uint64_t)tt.system_time.seconds * 1000000ull + (uint64_t)tt.system_time.microseconds;
+	e->us = (uint64_t)tt.user_time.seconds * 1000000ull + (uint64_t)tt.user_time.microseconds + e->sys;
+	return PROC_RETURNED;
+}
+
+static void
+top_snap(struct top_ent *t, uint32_t *n)
+{
+	*n = 0;
+	top_fill = t;
+	top_fill_n = n;
+	proc_iterate(PROC_ALLPROCLIST, top_cb, NULL, NULL, NULL);
+}
+
+/*
+ * 26 Nov 2026: kernel_task alone was 134 % of a CPU with the phone idle (live_054409). "top" now also lists its busiest
+ * threads: ours are named at kernel_thread_start ("begonia touch", "begonia usb", ...), SweetFB's work loop names
+ * itself; others show as "-" with their thread id and priority. Idle threads are skipped.
+ */
+#define KTOP_MAX 640
+struct ktop_ent {
+	uint64_t tid;
+	uint64_t ns;
+	int32_t  pri;
+	char     name[28];
+};
+static struct ktop_ent ktop_a[KTOP_MAX], ktop_b[KTOP_MAX];
+static uint64_t ktop_ids[KTOP_MAX];
+static uint32_t ktop_na, ktop_nb;
+
+static void
+ktop_snap(struct ktop_ent *t, uint32_t *n)
+{
+	task_t kt = proc_task(kernproc);
+	*n = 0;
+	if (kt == TASK_NULL) {
+		return;
+	}
+	int bytes = fill_taskthreadlist(kt, ktop_ids, KTOP_MAX, true);
+	uint32_t cnt = bytes > 0 ? (uint32_t)bytes / (uint32_t)sizeof(uint64_t) : 0u;
+	for (uint32_t i = 0; i < cnt && *n < KTOP_MAX; i++) {
+		struct proc_threadinfo_internal ti;
+		bzero(&ti, sizeof(ti));
+		if (fill_taskthreadinfo(kt, ktop_ids[i], true, &ti, NULL, NULL) != 0 || (ti.pth_flags & TH_FLAGS_IDLE)) {
+			continue;
+		}
+		struct ktop_ent *e = &t[(*n)++];
+		e->tid = ktop_ids[i];
+		e->ns = ti.pth_user_time + ti.pth_system_time;
+		e->pri = ti.pth_curpri;
+		strlcpy(e->name, ti.pth_name, sizeof(e->name));
+	}
+}
+
+static void
+ktop_report(uint64_t wall_us)
+{
+	ktop_snap(ktop_b, &ktop_nb);
+	for (uint32_t i = 0; i < ktop_nb; i++) {
+		uint64_t before = 0;
+		for (uint32_t j = 0; j < ktop_na; j++) {
+			if (ktop_a[j].tid == ktop_b[i].tid) {
+				before = ktop_a[j].ns;
+				break;
+			}
+		}
+		ktop_b[i].ns = ktop_b[i].ns > before ? ktop_b[i].ns - before : 0;
+	}
+	for (uint32_t k = 0; k < 12; k++) {
+		uint32_t best = KTOP_MAX;
+		for (uint32_t i = 0; i < ktop_nb; i++) {
+			if (ktop_b[i].tid != 0 && (best == KTOP_MAX || ktop_b[i].ns > ktop_b[best].ns)) {
+				best = i;
+			}
+		}
+		/* per mille of one CPU: ns / (wall_us * 1000) * 1000 */
+		if (best == KTOP_MAX || ktop_b[best].ns / wall_us < 3u) {
+			break;
+		}
+		printf("BEGONIA TOP:     kthread %-26s tid %-7llu pri %3d  %llu.%01llu%%\n", ktop_b[best].name[0] ? ktop_b[best].name : "-",
+		    ktop_b[best].tid, ktop_b[best].pri, ktop_b[best].ns / wall_us / 10u, (ktop_b[best].ns / wall_us) % 10u);
+		ktop_b[best].tid = 0;
+	}
+}
+
+static void
+top_poll(void)
+{
+	if (top_at == 0 || mach_absolute_time() < top_at) {
+		return;
+	}
+	top_at = 0;
+	top_snap(top_b, &top_nb);
+	uint64_t wall;
+	absolutetime_to_nanoseconds(mach_absolute_time() - top_t0, &wall);
+	wall /= 1000;
+	if (wall == 0) {
+		wall = 1;
+	}
+	/* delta per process (matched by pid), then the 14 biggest by selection */
+	uint64_t total = 0;
+	for (uint32_t i = 0; i < top_nb; i++) {
+		uint64_t before = 0, before_sys = 0;
+		for (uint32_t j = 0; j < top_na; j++) {
+			if (top_a[j].pid == top_b[i].pid) {
+				before = top_a[j].us;
+				before_sys = top_a[j].sys;
+				break;
+			}
+		}
+		top_b[i].us = top_b[i].us > before ? top_b[i].us - before : 0;
+		top_b[i].sys = top_b[i].sys > before_sys ? top_b[i].sys - before_sys : 0;
+		total += top_b[i].us;
+	}
+	printf("BEGONIA TOP: %llu ms, %u processes, CPU time %llu ms = %llu.%01llu cores busy\n", wall / 1000, top_nb,
+	    total / 1000, total / wall, (total * 10 / wall) % 10);
+	for (uint32_t k = 0; k < 14; k++) {
+		uint32_t best = TOP_MAX;
+		for (uint32_t i = 0; i < top_nb; i++) {
+			if (top_b[i].pid >= 0 && (best == TOP_MAX || top_b[i].us > top_b[best].us)) {
+				best = i;
+			}
+		}
+		if (best == TOP_MAX || top_b[best].us == 0) {
+			break;
+		}
+		printf("BEGONIA TOP:   %-20s %5d  %llu.%01llu%%  (%llu ms, system %llu.%01llu%%)\n", top_b[best].name,
+		    top_b[best].pid, top_b[best].us * 100 / wall, (top_b[best].us * 1000 / wall) % 10, top_b[best].us / 1000,
+		    top_b[best].sys * 100 / wall, (top_b[best].sys * 1000 / wall) % 10);
+		top_b[best].pid = -1;
+	}
+	ktop_report(wall);
+}
+
+/*
+ * "cpufreq": the clock of every CPU, measured. This thread is bound to each processor in turn and times a chain of
+ * 20 million dependent adds (one cycle each on the A55 and on the A76) against mach_absolute_time.
+ */
+extern processor_t cpu_to_processor(int cpu);
+extern processor_t thread_bind(processor_t processor);
+
+static uint64_t
+cpufreq_khz_here(void)
+{
+	uint64_t x = 1, n = 20000000ull, ns;
+	uint64_t t0 = mach_absolute_time();
+	__asm__ volatile (
+                "1: add %0, %0, #1\n"
+                "   add %0, %0, #1\n"
+                "   add %0, %0, #1\n"
+                "   add %0, %0, #1\n"
+                "   subs %1, %1, #4\n"
+                "   b.ne 1b\n"
+                : "+r"(x), "+r"(n) : : "cc");
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	/* 20M dependent adds + 5M sub/branch that run alongside: ~20M cycles */
+	return ns ? (20000000ull * 1000000ull) / ns : 0;
+}
