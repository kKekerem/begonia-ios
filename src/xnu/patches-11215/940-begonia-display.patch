+/*
+ * "membw" (26 Nov 2026): DRAM copy bandwidth from an A55 (cpu0) and an A76 (cpu6). On the iOS path nothing runs the
+ * DRAM/vcore DVFS (DVFSRC + SSPM firmware are Android's), so the DRAM may sit at whatever the boot loader left; this shows
+ * it. 8 MB copied into another 8 MB buffer 8 times per core (64 MB read + 64 MB written); MB/s of copy.
+ */
+/*
+ * 26 Nov 2026 (942): Bergamota 0191 ("beryllium-amp-idle-core-steering") taught choose_processor() in
+ * osfmk/kern/sched_prim.c to give user threads with base_pri >= a threshold an IDLE big core first and everything else
+ * an idle little core first, but only sweet_cpufreq.c (Qualcomm) turns it on, with "MPIDR Aff1 >= 4 = big". On begonia
+ * it was never enabled: one SMP cluster, so an idle CPU was picked lowest number first = the six A55s (cpu0-5) before
+ * the two A76s (cpu6-7, Aff1 6-7), and the UI ran on the slow cores unless six threads were busy. begoniaamp=0 keeps the
+ * stock choice; begoniaamppri=N is the threshold (default 37 = user-initiated and above: UI and render threads; default
+ * QoS daemons, utility, background and kernel threads take an A55 first). Running threads are not moved.
+ */
+extern void sweet_amp_enable(uint64_t big, uint64_t little, int pri);  /* osfmk/kern/sched_prim.c (Bergamota 0191) */
+
+static void
+bg_amp_setup(int pri)
+{
+	const ml_topology_info_t *topo = ml_get_topology_info();
+	uint64_t big = 0, little = 0;
+
+	for (unsigned int i = 0; topo != NULL && i < topo->num_cpus && i < 64u; i++) {
+		if (topo->cpus[i].phys_id >= 0x600u) {
+			big |= 1ULL << topo->cpus[i].cpu_id;
+		} else {
+			little |= 1ULL << topo->cpus[i].cpu_id;
+		}
+	}
+	if (big == 0 || little == 0) {
+		printf("BEGONIA AMP: one core class only (A76 %#llx, A55 %#llx): steering off\n", big, little);
+		return;
+	}
+	sweet_amp_enable(big, little, pri);
+	printf("BEGONIA AMP: idle-core steering on: A76 mask %#llx, A55 mask %#llx; user threads with base_pri >= %d take an "
+	    "idle A76 first\n", big, little, pri);
+}
+
+static void
+membw_report(void)
+{
+	const size_t sz = 8u << 20;
+	uint8_t *a = kalloc_data(sz, Z_WAITOK);
+	uint8_t *b = kalloc_data(sz, Z_WAITOK);
+	char line[160];
+	size_t n = (size_t)snprintf(line, sizeof(line), "BEGONIA MEMBW: copy MB/s");
+
+	if (a == NULL || b == NULL) {
+		printf("BEGONIA MEMBW: no memory\n");
+	} else {
+		memset(a, 0x5a, sz);
+		memset(b, 0xa5, sz);
+		static const unsigned int cpus[2] = { 0u, 6u };
+		for (unsigned int k = 0; k < 2u; k++) {
+			processor_t p = cpus[k] <= ml_get_max_cpu_number() ? cpu_to_processor((int)cpus[k]) : (processor_t)NULL;
+			if (p == (processor_t)NULL) {
+				continue;
+			}
+			thread_bind(p);
+			thread_block(THREAD_CONTINUE_NULL);
+			bcopy(a, b, sz);        /* warm the TLB */
+			uint64_t ns = 0, t0 = mach_absolute_time();
+			for (int i = 0; i < 8; i++) {
+				bcopy((i & 1) ? b : a, (i & 1) ? a : b, sz);
+			}
+			absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+			n += (size_t)snprintf(line + n, sizeof(line) - n, " cpu%u=%llu", cpus[k],
+			    ns ? (uint64_t)(8u * sz) * 1000ull / ns : 0ull);
+		}
+		thread_bind((processor_t)NULL);
+		thread_block(THREAD_CONTINUE_NULL);
+		printf("%s\n", line);
+	}
+	if (a != NULL) {
+		kfree_data(a, sz);
+	}
+	if (b != NULL) {
+		kfree_data(b, sz);
+	}
+}
