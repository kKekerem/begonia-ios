+
+/*
+ * 27 Nov 2026 (Loxy 950): asynchronous submission. A submit used to start its job and poll for the end in the caller:
+ * Chlorophyll's commit (~20 render passes a frame = ~40 jobs) waited for every job, so the compositor could never run
+ * ahead of the GPU and each frame cost its CPU time PLUS its GPU time. Now a submit queues the job and returns its
+ * sequence number; the "begonia mali jobs" thread runs the queue in order with the same start/poll code, and
+ * begonia_mali_wait() blocks until a number is done (WAIT_SEQ, WAIT_BO, Mesa's fences, GEM_CLOSE, SweetFB's swap gate).
+ * begoniamaliasync=0 keeps the synchronous path.
+ */
+#define MALI_QLEN       256u
+struct mali_qjob {
+	uint64_t jc_va;
+	uint64_t seq;
+	bool fragment;
+};
+static struct mali_qjob g_q[MALI_QLEN];
+static uint32_t g_q_head, g_q_tail;     /* head: next job to run, tail: next free entry */
+static uint32_t g_async = 1u;
+static LCK_MTX_DECLARE(mali_q_mtx, &mali_grp);
+
+static void
+mali_q_worker(__unused void *arg, __unused wait_result_t wr)
+{
+	for (;;) {
+		lck_mtx_lock(&mali_q_mtx);
+		while (g_q_head == g_q_tail) {
+			(void)lck_mtx_sleep(&mali_q_mtx, LCK_SLEEP_DEFAULT, (event_t)&g_q_tail, THREAD_UNINT);
+		}
+		struct mali_qjob j = g_q[g_q_head];
+		lck_mtx_unlock(&mali_q_mtx);
+		(void)mali_run_job(j.jc_va, j.fragment, j.seq);    /* a failed or lost job is done as well */
+		lck_mtx_lock(&mali_q_mtx);
+		if (j.seq > g_done_seq) {
+			g_done_seq = j.seq;
+		}
+		g_q_head = (g_q_head + 1u) % MALI_QLEN;
+		lck_mtx_unlock(&mali_q_mtx);
+		thread_wakeup((event_t)&g_q_head);
+		thread_wakeup((event_t)&g_done_seq);
+	}
+}
+
+uint64_t
+begonia_mali_submit(uint64_t jc_va, bool fragment)
+{
+	uint64_t seq;
+
+	if (!g_ready || jc_va == 0u || g_lost) {
+		return 0u;
+	}
+	lck_mtx_lock(&mali_q_mtx);
+	if (!g_async) {
+		seq = ++g_seq;
+		lck_mtx_unlock(&mali_q_mtx);
+		bool ok = mali_run_job(jc_va, fragment, seq);
+		thread_wakeup((event_t)&g_done_seq);
+		return ok ? seq : 0u;
+	}
+	while ((g_q_tail + 1u) % MALI_QLEN == g_q_head) {
+		(void)lck_mtx_sleep(&mali_q_mtx, LCK_SLEEP_DEFAULT, (event_t)&g_q_head, THREAD_UNINT);
+	}
+	seq = ++g_seq;
+	g_q[g_q_tail].jc_va = jc_va;
+	g_q[g_q_tail].seq = seq;
+	g_q[g_q_tail].fragment = fragment;
+	g_q_tail = (g_q_tail + 1u) % MALI_QLEN;
+	lck_mtx_unlock(&mali_q_mtx);
+	thread_wakeup((event_t)&g_q_tail);
 	return seq;
 }
 
