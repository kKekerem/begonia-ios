 	uint16_t      fBlRaw[2];        /* brightness bytes of strings 0, 1 as found */
+	vm_offset_t   fBlPwm;           /* begonia MT6785 disp_pwm0 @ 0x1100e000 */
+	uint32_t      fBlPwmPeriod;
+	bool          begoniaPwmWrite(uint32_t high);
