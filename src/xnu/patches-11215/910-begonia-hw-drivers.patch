+static inline uint32_t
+rd32(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+wr32(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+}
+
+static bool
+wait_mask(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t want, uint32_t ms)
+{
+	for (uint32_t us = 0; us < ms * 1000u; us += 10u) {
+		if ((rd32(base, off) & mask) == want) {
+			return true;
+		}
+		delay(10);
+	}
+	return (rd32(base, off) & mask) == want;
+}
+
+static bool
+power_pmic_rails(void)
+{
+	uint32_t vpu_elr = 0, vgpu_elr = 0, vpu_con = 0, vgpu_con = 0, dbg1 = 0;
+
+	if (!begonia_pmic_read(MT6359_VPU_ELR0, &vpu_elr) ||
+	    !begonia_pmic_read(MT6359_VPU_CON0, &vpu_con) ||
+	    !begonia_pmic_read(MT6359_VGPU11_ELR0, &vgpu_elr) ||
+	    !begonia_pmic_read(MT6359_VGPU11_CON0, &vgpu_con)) {
+		return false;
+	}
+	if (!begonia_pmic_write(MT6359_VPU_ELR0, (vpu_elr & ~0x7fu) | 0x48u) ||
+	    !begonia_pmic_write(MT6359_VPU_CON0, vpu_con | 1u)) {
+		return false;
+	}
+	delay(250);
+	if (!begonia_pmic_write(MT6359_VGPU11_ELR0, (vgpu_elr & ~0x7fu) | 0x30u) ||
+	    !begonia_pmic_write(MT6359_VGPU11_CON0, vgpu_con | 1u)) {
+		return false;
+	}
+	delay(300);
+	(void)begonia_pmic_read(MT6359_VGPU11_DBG1, &dbg1);
+	printf("BEGONIA MALI: PMIC VSRAM_GPU=850mV VGPU=700mV DBG1=%#x\n", dbg1);
+	return true;
+}
+
+static void
+setup_clocks(void)
+{
+	uint32_t con0, con1, dds;
+
+	wr32(topck, CK_CFG_3_CLR, 0xffu << 16);
+	wr32(topck, CK_CFG_3_SET, 3u << 16);
+	wr32(topck, CLK_CFG_UPDATE, 1u << 14);
+	delay(10);
+
+	con0 = rd32(apmixed, MFGPLL_CON0);
+	if ((con0 & 1u) == 0u) {
+		wr32(apmixed, MFGPLL_PWR_CON0, rd32(apmixed, MFGPLL_PWR_CON0) | 1u);
+		delay(10);
+		wr32(apmixed, MFGPLL_PWR_CON0, rd32(apmixed, MFGPLL_PWR_CON0) & ~(1u << 1));
+		delay(5);
+		dds = (uint32_t)(((545ull * 4ull) << 14) / 26ull) & 0x3fffffu;
+		wr32(apmixed, MFGPLL_CON1, (1u << 31) | (2u << 24) | dds);
+		delay(20);
+		wr32(apmixed, MFGPLL_CON0, rd32(apmixed, MFGPLL_CON0) | 1u);
+		delay(40);
+	} else if (g_req_mhz != 0u) {
+		/*
+		 * LK leaves MFGPLL running (269 MHz on begonia). begoniamalimhz=N (375..620) re-tunes it the way
+		 * mtk_gpufreq_core.c __mt_gpufreq_clock_switch does: mfg_sel is parked on mainpll_d5 (above),
+		 * CON1 = PCW_CHG | POSDIV /4 | DDS, 20 us, then back to mfgpll_ck (below). VGPU is 700 mV here
+		 * (power_pmic_rails), the OPP table's voltage for 620 MHz.
+		 */
+		dds = (uint32_t)((((uint64_t)g_req_mhz * 4ull) << 14) / 26ull) & 0x3fffffu;
+		wr32(apmixed, MFGPLL_CON1, (1u << 31) | (2u << 24) | dds);
+		delay(20);
+	}
+	con1 = rd32(apmixed, MFGPLL_CON1);
+	g_freq_khz = (uint32_t)((((uint64_t)(con1 & 0x3fffffu) * 26000ull) >> 14) /
+	    (1ull << ((con1 >> 24) & 7u)));
+
+	wr32(topck, CK_CFG_3_CLR, 0xffu << 16);
+	wr32(topck, CK_CFG_3_SET, 1u << 16);
+	wr32(topck, CLK_CFG_UPDATE, 1u << 14);
+	delay(10);
+}
+
+static bool
+mtcmos_on(uint32_t con_off, uint32_t sta_mask, uint32_t sram_bits, uint32_t sram_ack, bool is_mfg1)
+{
+	wr32(spm, con_off, rd32(spm, con_off) | PWR_ON);
+	wr32(spm, con_off, rd32(spm, con_off) | PWR_ON_2ND);
+	if (!wait_mask(spm, PWR_STATUS, sta_mask, sta_mask, 20) ||
+	    !wait_mask(spm, PWR_STATUS_2ND, sta_mask, sta_mask, 20)) {
+		return false;
+	}
+	wr32(spm, con_off, rd32(spm, con_off) & ~PWR_CLK_DIS);
+	wr32(spm, con_off, rd32(spm, con_off) & ~PWR_ISO);
+	wr32(spm, con_off, rd32(spm, con_off) | PWR_RST_B);
+	if (is_mfg1) {
+		wr32(spm, con_off, rd32(spm, con_off) & ~(1u << 8));
+		if (!wait_mask(spm, con_off, 1u << 12, 0u, 20)) {
+			return false;
+		}
+		wr32(spm, con_off, rd32(spm, con_off) & ~(1u << 9));
+		if (!wait_mask(spm, con_off, 1u << 13, 0u, 20)) {
+			return false;
+		}
+		wr32(infra, INFRA_PROT_CLR, MFG1_PROT_STEP2_MASK);
+		wr32(infra, INFRA_PROT_1_CLR, MFG1_PROT_STEP1_MASK);
+	} else if (sram_bits != 0u) {
+		wr32(spm, con_off, rd32(spm, con_off) & ~sram_bits);
+		if (!wait_mask(spm, con_off, sram_ack, 0u, 20)) {
+			return false;
+		}
+	}
+	return true;
+}
