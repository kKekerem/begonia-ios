diff --git a/bsd/dev/begonia_keys.c b/bsd/dev/begonia_keys.c
new file mode 100644
index 0000000..27fc3e1
--- /dev/null
+++ b/bsd/dev/begonia_keys.c
@@ -0,0 +1,212 @@
+/*
+ * Polled physical keys & MT6359 PMIC wrapper (WACS2) for Redmi Note 8 Pro (begonia / MT6785).
+ *   Volume Up / Down: MT6785 keypad controller kp@10010000 (KP_MEM1 bits 0..1, active-low)
+ *   Power key:        MT6359 PMIC TOPSTATUS (0x2a) bit 1 via pwrap@1000d000 (active-low)
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <libkern/libkern.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include "sweet_board.h"
+#include "begonia_drivers.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_hid_key(int key, int down);
+
+#define BEGONIA_KPD_PHYS        0x10010000u
+#define BEGONIA_KP_MEM1         0x0004u
+
+#define BEGONIA_PWRAP_PHYS      0x1000d000u
+#define PWRAP_WACS2_CMD         0x0c20u
+#define PWRAP_WACS2_RDATA       0x0c24u
+#define PWRAP_WACS2_VLDCLR      0x0c28u
+#define PWRAP_FSM(r)            (((r) >> 16) & 7u)
+#define PWRAP_FSM_IDLE          0u
+#define PWRAP_FSM_WFVLDCLR      6u
+
+#define MT6359_TOPSTATUS        0x002au
+#define MT6359_PWRKEY_DEB_BIT   (1u << 1)
+
+static LCK_GRP_DECLARE(begonia_pwrap_grp, "begonia-pwrap");
+static LCK_MTX_DECLARE(begonia_pwrap_mtx, &begonia_pwrap_grp);
+
+static vm_offset_t kpd_base;
+static vm_offset_t pwrap_base;
+static bool keys_started;
+static int keys_sleep_chan;
+static int keys_log;
+
+static inline uint32_t
+mm_rd32(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+mm_wr32(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+}
+
+static bool
+pwrap_ensure_mapped(void)
+{
+	if (pwrap_base == 0) {
+		pwrap_base = ml_io_map(BEGONIA_PWRAP_PHYS, 0x1000u);
+	}
+	return pwrap_base != 0;
+}
+
+static bool
+pwrap_wait_fsm(uint32_t state)
+{
+	for (uint32_t spin = 0; spin < 100000u; spin++) {
+		if (PWRAP_FSM(mm_rd32(pwrap_base, PWRAP_WACS2_RDATA)) == state) {
+			return true;
+		}
+	}
+	return false;
+}
+
+bool
+begonia_pmic_read(uint32_t reg, uint32_t *val)
+{
+	bool ok = false;
+
+	if (val == NULL) {
+		return false;
+	}
+	lck_mtx_lock(&begonia_pwrap_mtx);
+	if (pwrap_ensure_mapped() && pwrap_wait_fsm(PWRAP_FSM_IDLE)) {
+		mm_wr32(pwrap_base, PWRAP_WACS2_CMD, ((reg >> 1) & 0x7fffu) << 16);
+		if (pwrap_wait_fsm(PWRAP_FSM_WFVLDCLR)) {
+			*val = mm_rd32(pwrap_base, PWRAP_WACS2_RDATA) & 0xffffu;
+			mm_wr32(pwrap_base, PWRAP_WACS2_VLDCLR, 1u);
+			ok = true;
+		}
+	}
+	lck_mtx_unlock(&begonia_pwrap_mtx);
+	return ok;
+}
+
+bool
+begonia_pmic_write(uint32_t reg, uint32_t val)
+{
+	bool ok = false;
+
+	lck_mtx_lock(&begonia_pwrap_mtx);
+	if (pwrap_ensure_mapped() && pwrap_wait_fsm(PWRAP_FSM_IDLE)) {
+		uint32_t cmd = (1u << 31) | (((reg >> 1) & 0x7fffu) << 16) | (val & 0xffffu);
+		mm_wr32(pwrap_base, PWRAP_WACS2_CMD, cmd);
+		ok = pwrap_wait_fsm(PWRAP_FSM_IDLE);
+	}
+	lck_mtx_unlock(&begonia_pwrap_mtx);
+	return ok;
+}
+
+static void
+keys_sleep_ms(uint32_t ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&keys_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+begonia_keys_thread(__unused void *arg, __unused wait_result_t result)
+{
+	static const char *names[3] = { "power", "volup", "voldown" };
+	int stable[3] = { 0, 0, 0 };
+	int prev_raw[3] = { 0, 0, 0 };
+	uint32_t pmic_errs = 0;
+
+	for (;;) {
+		uint32_t kmem = mm_rd32(kpd_base, BEGONIA_KP_MEM1);
+		uint32_t top = 0;
+		bool pok = begonia_pmic_read(MT6359_TOPSTATUS, &top);
+		int raw[3];
+
+		raw[0] = pok ? ((top & MT6359_PWRKEY_DEB_BIT) == 0 ? 1 : 0) : stable[0];
+		raw[1] = (kmem & (1u << 0)) == 0 ? 1 : 0;
+		raw[2] = (kmem & (1u << 1)) == 0 ? 1 : 0;
+
+		if (!pok && (pmic_errs++ % 250u) == 0) {
+			printf("BEGONIA KEYS: PMIC TOPSTATUS read failed\n");
+		} else if (pok) {
+			pmic_errs = 0;
+		}
+
+		for (int k = 0; k < 3; k++) {
+			if (raw[k] == prev_raw[k] && raw[k] != stable[k]) {
+				stable[k] = raw[k];
+				if (keys_log) {
+					printf("BEGONIA KEYS: %s %s (kmem=%#x top=%#x)\n",
+					    names[k], stable[k] ? "down" : "up", kmem, top);
+				}
+				sweet_hid_key(k, stable[k]);
+			}
+			prev_raw[k] = raw[k];
+		}
+		keys_sleep_ms(20u);
+	}
+}
+
+void
+begonia_keys_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+
+	if (keys_started || !sweet_board_begonia()) {
+		return;
+	}
+	keys_started = true;
+	(void)PE_parse_boot_argn("begoniakeys", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("begoniakeylog", &keys_log, sizeof(keys_log));
+	if (!enabled) {
+		printf("BEGONIA KEYS: disabled (begoniakeys=0)\n");
+		return;
+	}
+	kpd_base = ml_io_map(BEGONIA_KPD_PHYS, 0x1000u);
+	if (kpd_base == 0 || !pwrap_ensure_mapped()) {
+		printf("BEGONIA KEYS: ml_io_map failed (kpd=%#lx pwrap=%#lx)\n",
+		    (unsigned long)kpd_base, (unsigned long)pwrap_base);
+		return;
+	}
+	uint32_t top = 0;
+	bool pok = begonia_pmic_read(MT6359_TOPSTATUS, &top);
+	printf("BEGONIA KEYS: kp@%#x kmem1=%#x pwrap@%#x topstatus=%#x (ok=%d)\n",
+	    BEGONIA_KPD_PHYS, mm_rd32(kpd_base, BEGONIA_KP_MEM1),
+	    BEGONIA_PWRAP_PHYS, top, pok ? 1 : 0);
+
+	if (kernel_thread_start(begonia_keys_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("BEGONIA KEYS: kernel_thread_start failed\n");
+	}
+}
+
+void
+begonia_platform_hw_init(void)
+{
+	static bool hw_started;
+
+	if (hw_started || !sweet_board_begonia()) {
+		return;
+	}
+	hw_started = true;
+	begonia_keys_init();
+	begonia_touch_init();
+	begonia_mali_init();
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/begonia_mali.c b/bsd/dev/begonia_mali.c
new file mode 100644
index 0000000..04d06a8
--- /dev/null
+++ b/bsd/dev/begonia_mali.c
@@ -0,0 +1,495 @@
+/*
+ * ARM Mali-G76 MC4 (r0p0, 0x7211 @ 0x13040000) driver for Redmi Note 8 Pro (begonia / MT6785).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <libkern/libkern.h>
+#include <sys/sysctl.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <machine/machine_routines.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <vm/vm_kern_xnu.h>
+#include <pexpert/pexpert.h>
+#include "sweet_board.h"
+#include "begonia_drivers.h"
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define TOPCKGEN_PA             0x10000000u
+#define INFRACFG_PA             0x10001000u
+#define SPM_PA                  0x10006000u
+#define APMIXED_PA              0x1000c000u
+#define MFGCFG_PA               0x13fbf000u
+#define MALI_PA                 0x13040000u
+
+#define MT6359_VPU_CON0         0x1488u
+#define MT6359_VPU_ELR0         0x14acu
+#define MT6359_VGPU11_CON0      0x1588u
+#define MT6359_VGPU11_DBG1      0x15a8u
+#define MT6359_VGPU11_ELR0      0x15acu
+
+#define MFGPLL_CON0             0x0250u
+#define MFGPLL_CON1             0x0254u
+#define MFGPLL_PWR_CON0         0x025cu
+#define CLK_CFG_UPDATE          0x0004u
+#define CK_CFG_3_SET            0x0054u
+#define CK_CFG_3_CLR            0x0058u
+
+#define PWR_STATUS              0x0160u
+#define PWR_STATUS_2ND          0x0164u
+#define PWR_RST_B               (1u << 0)
+#define PWR_ISO                 (1u << 1)
+#define PWR_ON                  (1u << 2)
+#define PWR_ON_2ND              (1u << 3)
+#define PWR_CLK_DIS             (1u << 4)
+#define INFRA_PROT_CLR          0x02a4u
+#define INFRA_PROT_1_CLR        0x02acu
+#define MFG1_PROT_STEP2_MASK    ((1u << 21) | (1u << 22))
+#define MFG1_PROT_STEP1_MASK    ((1u << 19) | (1u << 20) | (1u << 21))
+#define SPM_POWERON_CONFIG_EN   0x0000u
+#define SPM_PROJECT_CODE        0x0b16u
+#define MFG_CG_CLR              0x0008u
+#define MFG_ASYNC_CON           0x0020u
+#define MFG_ASYNC_CON_1         0x0024u
+#define MFG_GLOBAL_CON          0x00b0u
+#define MFG_TIMESTAMP_EN        0x0130u
+
+#define GPU_ID                  0x000u
+#define GPU_L2_FEATURES         0x004u
+#define GPU_CORE_FEATURES       0x008u
+#define GPU_TILER_FEATURES      0x00cu
+#define GPU_MEM_FEATURES        0x010u
+#define GPU_MMU_FEATURES        0x014u
+#define GPU_AS_PRESENT          0x018u
+#define GPU_JS_PRESENT          0x01cu
+#define GPU_INT_RAWSTAT         0x020u
+#define GPU_INT_CLEAR           0x024u
+#define GPU_INT_MASK            0x028u
+#define GPU_CMD                 0x030u
+#define GPU_AFBC_FEATURES       0x04cu
+#define GPU_THREAD_MAX_THREADS  0x0a0u
+#define GPU_THREAD_MAX_WG_SIZE  0x0a4u
+#define GPU_THREAD_MAX_BARRIER  0x0a8u
+#define GPU_THREAD_FEATURES     0x0acu
+#define GPU_TEX_FEATURES(n)     (0x0b0u + (n) * 4u)
+#define GPU_JS_FEATURES(n)      (0x0c0u + (n) * 4u)
+#define SHADER_PRESENT_LO       0x100u
+#define TILER_PRESENT_LO        0x110u
+#define L2_PRESENT_LO           0x120u
+#define SHADER_READY_LO         0x140u
+#define TILER_READY_LO          0x150u
+#define L2_READY_LO             0x160u
+#define SHADER_PWRON_LO         0x180u
+#define TILER_PWRON_LO          0x190u
+#define L2_PWRON_LO             0x1a0u
+#define COHERENCY_FEATURES      0x300u
+#define GPU_THREAD_TLS_ALLOC    0x310u
+#define STACK_PRESENT_LO        0xe00u
+
+#define JOB_INT_RAWSTAT         0x1000u
+#define JOB_INT_CLEAR           0x1004u
+#define JOB_INT_MASK            0x1008u
+#define JS_SLOT(n)              (0x1800u + (n) * 0x80u)
+#define JS_HEAD_NEXT_LO         0x40u
+#define JS_HEAD_NEXT_HI         0x44u
+#define JS_AFFINITY_NEXT_LO     0x50u
+#define JS_AFFINITY_NEXT_HI     0x54u
+#define JS_CONFIG_NEXT          0x58u
+#define JS_COMMAND_NEXT         0x60u
+#define JS_CONFIG_VAL           ((3u << 8) | (1u << 10) | (3u << 12) | (8u << 16))
+#define JS_CONFIG_IDENT         ((3u << 8) | (3u << 12) | (8u << 16))
+#define AS0                     0x2400u
+#define AS_FAULTSTATUS          0x1cu
+
+SYSCTL_NODE(_kern, OID_AUTO, begonia, CTLFLAG_RW | CTLFLAG_LOCKED, 0, "Redmi Note 8 Pro (begonia) drivers");
+
+static vm_offset_t topck, infra, spm, apmixed, mfgcfg, mali;
+static LCK_GRP_DECLARE(mali_grp, "begonia-mali");
+static LCK_MTX_DECLARE(mali_mtx, &mali_grp);
+
+static uint32_t g_stage, g_gpu_id, g_shader_mask, g_tiler_mask, g_l2_mask, g_va_bits, g_freq_khz;
+static uint32_t g_clients, g_buffers, g_submits, g_faults;
+static uint64_t g_seq, g_done_seq;
+static bool g_started, g_ready;
+
+SYSCTL_UINT(_kern_begonia, OID_AUTO, mali, CTLFLAG_RD | CTLFLAG_LOCKED, &g_stage, 0, "Mali-G76 bringup stage (0..6)");
+SYSCTL_UINT(_kern_begonia, OID_AUTO, mali_id, CTLFLAG_RD | CTLFLAG_LOCKED, &g_gpu_id, 0, "Mali GPU_ID");
+SYSCTL_UINT(_kern_begonia, OID_AUTO, mali_shaders, CTLFLAG_RD | CTLFLAG_LOCKED, &g_shader_mask, 0, "Mali shader core mask");
+SYSCTL_UINT(_kern_begonia, OID_AUTO, mali_va_bits, CTLFLAG_RD | CTLFLAG_LOCKED, &g_va_bits, 0, "Mali MMU VA bits");
+SYSCTL_UINT(_kern_begonia, OID_AUTO, mali_freq_khz, CTLFLAG_RD | CTLFLAG_LOCKED, &g_freq_khz, 0, "Mali MFGPLL KHz");
+SYSCTL_UINT(_kern_begonia, OID_AUTO, mali_clients, CTLFLAG_RD | CTLFLAG_LOCKED, &g_clients, 0, "Open SweetMali clients");
+SYSCTL_UINT(_kern_begonia, OID_AUTO, mali_buffers, CTLFLAG_RD | CTLFLAG_LOCKED, &g_buffers, 0, "Mapped Mali BOs");
+SYSCTL_UINT(_kern_begonia, OID_AUTO, mali_submits, CTLFLAG_RD | CTLFLAG_LOCKED, &g_submits, 0, "Submitted Mali jobs");
+SYSCTL_UINT(_kern_begonia, OID_AUTO, mali_faults, CTLFLAG_RD | CTLFLAG_LOCKED, &g_faults, 0, "Mali MMU/job faults");
+
+static inline uint32_t
+rd32(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+wr32(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+}
+
+static bool
+wait_mask(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t want, uint32_t ms)
+{
+	for (uint32_t us = 0; us < ms * 1000u; us += 10u) {
+		if ((rd32(base, off) & mask) == want) {
+			return true;
+		}
+		delay(10);
+	}
+	return (rd32(base, off) & mask) == want;
+}
+
+static bool
+power_pmic_rails(void)
+{
+	uint32_t vpu_elr = 0, vgpu_elr = 0, vpu_con = 0, vgpu_con = 0, dbg1 = 0;
+
+	if (!begonia_pmic_read(MT6359_VPU_ELR0, &vpu_elr) ||
+	    !begonia_pmic_read(MT6359_VPU_CON0, &vpu_con) ||
+	    !begonia_pmic_read(MT6359_VGPU11_ELR0, &vgpu_elr) ||
+	    !begonia_pmic_read(MT6359_VGPU11_CON0, &vgpu_con)) {
+		return false;
+	}
+	if (!begonia_pmic_write(MT6359_VPU_ELR0, (vpu_elr & ~0x7fu) | 0x48u) ||
+	    !begonia_pmic_write(MT6359_VPU_CON0, vpu_con | 1u)) {
+		return false;
+	}
+	delay(250);
+	if (!begonia_pmic_write(MT6359_VGPU11_ELR0, (vgpu_elr & ~0x7fu) | 0x30u) ||
+	    !begonia_pmic_write(MT6359_VGPU11_CON0, vgpu_con | 1u)) {
+		return false;
+	}
+	delay(300);
+	(void)begonia_pmic_read(MT6359_VGPU11_DBG1, &dbg1);
+	printf("BEGONIA MALI: PMIC VSRAM_GPU=850mV VGPU=700mV DBG1=%#x\n", dbg1);
+	return true;
+}
+
+static void
+setup_clocks(void)
+{
+	uint32_t con0, con1, dds;
+
+	wr32(topck, CK_CFG_3_CLR, 0xffu << 16);
+	wr32(topck, CK_CFG_3_SET, 3u << 16);
+	wr32(topck, CLK_CFG_UPDATE, 1u << 14);
+	delay(10);
+
+	con0 = rd32(apmixed, MFGPLL_CON0);
+	if ((con0 & 1u) == 0u) {
+		wr32(apmixed, MFGPLL_PWR_CON0, rd32(apmixed, MFGPLL_PWR_CON0) | 1u);
+		delay(10);
+		wr32(apmixed, MFGPLL_PWR_CON0, rd32(apmixed, MFGPLL_PWR_CON0) & ~(1u << 1));
+		delay(5);
+		dds = (uint32_t)(((545ull * 4ull) << 14) / 26ull) & 0x3fffffu;
+		wr32(apmixed, MFGPLL_CON1, (1u << 31) | (2u << 24) | dds);
+		delay(20);
+		wr32(apmixed, MFGPLL_CON0, rd32(apmixed, MFGPLL_CON0) | 1u);
+		delay(40);
+	}
+	con1 = rd32(apmixed, MFGPLL_CON1);
+	g_freq_khz = (uint32_t)((((uint64_t)(con1 & 0x3fffffu) * 26000ull) >> 14) /
+	    (1ull << ((con1 >> 24) & 7u)));
+
+	wr32(topck, CK_CFG_3_CLR, 0xffu << 16);
+	wr32(topck, CK_CFG_3_SET, 1u << 16);
+	wr32(topck, CLK_CFG_UPDATE, 1u << 14);
+	delay(10);
+}
+
+static bool
+mtcmos_on(uint32_t con_off, uint32_t sta_mask, uint32_t sram_bits, uint32_t sram_ack, bool is_mfg1)
+{
+	wr32(spm, con_off, rd32(spm, con_off) | PWR_ON);
+	wr32(spm, con_off, rd32(spm, con_off) | PWR_ON_2ND);
+	if (!wait_mask(spm, PWR_STATUS, sta_mask, sta_mask, 20) ||
+	    !wait_mask(spm, PWR_STATUS_2ND, sta_mask, sta_mask, 20)) {
+		return false;
+	}
+	wr32(spm, con_off, rd32(spm, con_off) & ~PWR_CLK_DIS);
+	wr32(spm, con_off, rd32(spm, con_off) & ~PWR_ISO);
+	wr32(spm, con_off, rd32(spm, con_off) | PWR_RST_B);
+	if (is_mfg1) {
+		wr32(spm, con_off, rd32(spm, con_off) & ~(1u << 8));
+		if (!wait_mask(spm, con_off, 1u << 12, 0u, 20)) {
+			return false;
+		}
+		wr32(spm, con_off, rd32(spm, con_off) & ~(1u << 9));
+		if (!wait_mask(spm, con_off, 1u << 13, 0u, 20)) {
+			return false;
+		}
+		wr32(infra, INFRA_PROT_CLR, MFG1_PROT_STEP2_MASK);
+		wr32(infra, INFRA_PROT_1_CLR, MFG1_PROT_STEP1_MASK);
+	} else if (sram_bits != 0u) {
+		wr32(spm, con_off, rd32(spm, con_off) & ~sram_bits);
+		if (!wait_mask(spm, con_off, sram_ack, 0u, 20)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static bool
+run_selftest_job(vm_offset_t kva, uint64_t gpu_va, uint32_t magic, const char *tag)
+{
+	volatile uint32_t *job = (volatile uint32_t *)kva;
+	volatile uint32_t *dst = (volatile uint32_t *)(kva + 0x800u);
+	uint32_t js = JS_SLOT(1);
+
+	bzero((void *)kva, PAGE_SIZE);
+	job[4] = (2u << 1) | 1u | (1u << 16);
+	job[8] = (uint32_t)(gpu_va + 0x800u);
+	job[9] = (uint32_t)((gpu_va + 0x800u) >> 32);
+	job[10] = 6u;
+	job[12] = magic;
+	sweet_dma_sync_va((void *)kva, PAGE_SIZE);
+
+	wr32(mali, JOB_INT_MASK, 0u);
+	wr32(mali, JOB_INT_CLEAR, 0xffffffffu);
+	wr32(mali, js + JS_HEAD_NEXT_LO, (uint32_t)gpu_va);
+	wr32(mali, js + JS_HEAD_NEXT_HI, (uint32_t)(gpu_va >> 32));
+	wr32(mali, js + JS_AFFINITY_NEXT_LO, g_shader_mask);
+	wr32(mali, js + JS_AFFINITY_NEXT_HI, 0u);
+	wr32(mali, js + JS_CONFIG_NEXT, magic == 0xc0ffee01u ? JS_CONFIG_IDENT : JS_CONFIG_VAL);
+	wr32(mali, js + JS_COMMAND_NEXT, 1u);
+
+	(void)wait_mask(mali, JOB_INT_RAWSTAT, (1u << 1) | (1u << 17), 1u << 1, 100u);
+	sweet_dma_sync_va((void *)kva, PAGE_SIZE);
+	bool ok = (*dst == magic);
+	printf("BEGONIA MALI: selftest (%s) irq=%#x fault=%#x word=%#x (%s)\n",
+	    tag, rd32(mali, JOB_INT_RAWSTAT), rd32(mali, AS0 + AS_FAULTSTATUS),
+	    *dst, ok ? "PASS" : "FAIL");
+	wr32(mali, JOB_INT_CLEAR, 0xffffffffu);
+	return ok;
+}
+
+void
+begonia_mali_init(void)
+{
+	int enabled = 1;
+	vm_offset_t test_kva = 0;
+
+	if (g_started || !sweet_board_begonia()) {
+		return;
+	}
+	g_started = true;
+	(void)PE_parse_boot_argn("begoniamali", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("BEGONIA MALI: disabled (begoniamali=0)\n");
+		return;
+	}
+
+	topck = ml_io_map(TOPCKGEN_PA, 0x1000u);
+	infra = ml_io_map(INFRACFG_PA, 0x1000u);
+	spm = ml_io_map(SPM_PA, 0x1000u);
+	apmixed = ml_io_map(APMIXED_PA, 0x1000u);
+	mfgcfg = ml_io_map(MFGCFG_PA, 0x1000u);
+	mali = ml_io_map(MALI_PA, 0x10000u);
+	if (!topck || !infra || !spm || !apmixed || !mfgcfg || !mali) {
+		printf("BEGONIA MALI: ml_io_map failed\n");
+		return;
+	}
+	if (!power_pmic_rails()) {
+		printf("BEGONIA MALI: PMIC rail bringup failed\n");
+		return;
+	}
+	setup_clocks();
+	g_stage = 1;
+
+	if ((rd32(spm, SPM_POWERON_CONFIG_EN) & 1u) == 0u) {
+		wr32(spm, SPM_POWERON_CONFIG_EN, (SPM_PROJECT_CODE << 16) | 1u);
+	}
+	if (!mtcmos_on(0x328u, 1u << 4, 0u, 0u, false) ||
+	    !mtcmos_on(0x32cu, 1u << 7, 0u, 0u, true) ||
+	    !mtcmos_on(0x330u, 1u << 20, 1u << 8, 1u << 12, false) ||
+	    !mtcmos_on(0x334u, 1u << 22, 1u << 8, 1u << 12, false) ||
+	    !mtcmos_on(0x338u, 1u << 23, 1u << 8, 1u << 12, false) ||
+	    !mtcmos_on(0x350u, 1u << 13, 1u << 8, 1u << 12, false)) {
+		printf("BEGONIA MALI: MFG MTCMOS failed\n");
+		return;
+	}
+	wr32(mfgcfg, MFG_CG_CLR, 1u);
+	wr32(mfgcfg, MFG_GLOBAL_CON, rd32(mfgcfg, MFG_GLOBAL_CON) & ~((1u << 8) | (1u << 10)));
+	wr32(mfgcfg, MFG_ASYNC_CON, rd32(mfgcfg, MFG_ASYNC_CON) | (1u << 23) | (1u << 25));
+	wr32(mfgcfg, MFG_ASYNC_CON_1, rd32(mfgcfg, MFG_ASYNC_CON_1) | 1u);
+	wr32(mfgcfg, MFG_TIMESTAMP_EN, 1u);
+	delay(10);
+	g_stage = 2;
+
+	g_gpu_id = rd32(mali, GPU_ID);
+	if (g_gpu_id == 0u || g_gpu_id == 0xffffffffu) {
+		printf("BEGONIA MALI: bad GPU_ID=%#x\n", g_gpu_id);
+		return;
+	}
+	wr32(mali, GPU_INT_MASK, 0u);
+	wr32(mali, GPU_INT_CLEAR, 0xffffffffu);
+	wr32(mali, GPU_CMD, 1u);
+	(void)wait_mask(mali, GPU_INT_RAWSTAT, 1u << 8, 1u << 8, 50u);
+	wr32(mali, GPU_INT_CLEAR, 0xffffffffu);
+
+	g_l2_mask = rd32(mali, L2_PRESENT_LO);
+	g_tiler_mask = rd32(mali, TILER_PRESENT_LO);
+	g_shader_mask = rd32(mali, SHADER_PRESENT_LO);
+	g_va_bits = rd32(mali, GPU_MMU_FEATURES) & 0xffu;
+	if (g_va_bits < 33u || g_va_bits > 48u) {
+		g_va_bits = 48u;
+	}
+	begonia_mali_mmu_init(mali, g_va_bits);
+
+	wr32(mali, L2_PWRON_LO, g_l2_mask);
+	wr32(mali, TILER_PWRON_LO, g_tiler_mask);
+	wr32(mali, SHADER_PWRON_LO, g_shader_mask);
+	if (!wait_mask(mali, L2_READY_LO, g_l2_mask, g_l2_mask, 50u) ||
+	    !wait_mask(mali, TILER_READY_LO, g_tiler_mask, g_tiler_mask, 50u) ||
+	    !wait_mask(mali, SHADER_READY_LO, g_shader_mask, g_shader_mask, 50u)) {
+		printf("BEGONIA MALI: core power-on timeout\n");
+		return;
+	}
+	g_stage = 3;
+	printf("BEGONIA MALI: GPU_ID=%#x (%u MHz) shaders=%#x tiler=%#x l2=%#x va=%u\n",
+	    g_gpu_id, g_freq_khz / 1000u, g_shader_mask, g_tiler_mask, g_l2_mask, g_va_bits);
+
+	if (kmem_alloc_contig(kernel_map, &test_kva, PAGE_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return;
+	}
+	ppnum_t test_pn = pmap_find_phys(kernel_pmap, (addr64_t)test_kva);
+	uint64_t test_pa = ptoa_64(test_pn);
+	begonia_mali_mmu_as0_set(mali, 0ull, 2u);
+	if (!run_selftest_job(test_kva, test_pa, 0xc0ffee01u, "identity")) {
+		kmem_free(kernel_map, test_kva, PAGE_SIZE);
+		return;
+	}
+	g_stage = 4;
+
+	bool mapped = begonia_mali_map_page(0x00100000ull, test_pa, false);
+	if (mapped) {
+		begonia_mali_mmu_as0_set(mali, begonia_mali_mmu_root_pa(), begonia_mali_mmu_transcfg());
+		mapped = run_selftest_job(test_kva, 0x00100000ull, 0xc0ffee02u, "page-table");
+		begonia_mali_unmap_range(0x00100000ull, 4096ull);
+	}
+	kmem_free(kernel_map, test_kva, PAGE_SIZE);
+	if (!mapped) {
+		return;
+	}
+	g_stage = 5;
+	g_ready = true;
+	SweetMaliPublish();
+	g_stage = 6;
+}
+
+bool begonia_mali_ready(void) { return g_ready; }
+uint32_t begonia_mali_gpu_id(void) { return g_gpu_id; }
+uint32_t begonia_mali_va_bits(void) { return g_va_bits; }
+uint64_t begonia_mali_last_seq(void) { return g_done_seq; }
+uint32_t begonia_mali_faults(void) { return g_faults; }
+
+bool
+begonia_mali_param(uint32_t which, uint64_t *value)
+{
+	if (!g_ready || value == NULL) {
+		return false;
+	}
+	if (which >= 18u && which <= 21u) {
+		*value = rd32(mali, GPU_TEX_FEATURES(which - 18u));
+		return true;
+	}
+	if (which >= 22u && which <= 37u) {
+		*value = rd32(mali, GPU_JS_FEATURES(which - 22u));
+		return true;
+	}
+	static const uint16_t reg_map[18] = {
+		0, 0, 0, 0, 0, STACK_PRESENT_LO, GPU_AS_PRESENT, GPU_JS_PRESENT,
+		GPU_L2_FEATURES, GPU_CORE_FEATURES, GPU_TILER_FEATURES, GPU_MEM_FEATURES,
+		GPU_MMU_FEATURES, GPU_THREAD_FEATURES, GPU_THREAD_MAX_THREADS,
+		GPU_THREAD_MAX_WG_SIZE, GPU_THREAD_MAX_BARRIER, COHERENCY_FEATURES,
+	};
+	if (which == 0u) { *value = g_gpu_id >> 16; return true; }
+	if (which == 1u) { *value = g_gpu_id & 0xffffu; return true; }
+	if (which == 2u) { *value = g_shader_mask; return true; }
+	if (which == 3u) { *value = g_tiler_mask; return true; }
+	if (which == 4u) { *value = g_l2_mask; return true; }
+	if (which < 18u) { *value = rd32(mali, reg_map[which]); return true; }
+	if (which == 38u) { *value = 1u; return true; }
+	if (which == 39u) { *value = rd32(mali, GPU_THREAD_TLS_ALLOC); return true; }
+	if (which == 40u) { *value = rd32(mali, GPU_AFBC_FEATURES); return true; }
+	if (which == 41u) { uint64_t t; __asm__ volatile("mrs %0, cntvct_el0" : "=r"(t)); *value = t; return true; }
+	if (which == 42u) { uint64_t f; __asm__ volatile("mrs %0, cntfrq_el0" : "=r"(f)); *value = f; return true; }
+	return false;
+}
+
+uint64_t
+begonia_mali_submit(uint64_t jc_va, bool fragment)
+{
+	uint32_t slot = fragment ? 0u : 1u;
+	uint32_t js = JS_SLOT(slot);
+	uint64_t seq;
+
+	if (!g_ready || jc_va == 0u) {
+		return 0u;
+	}
+	lck_mtx_lock(&mali_mtx);
+	g_submits++;
+	seq = ++g_seq;
+	uint32_t irqm = (1u << slot) | (1u << (slot + 16u));
+	wr32(mali, JOB_INT_CLEAR, irqm);
+	(void)wait_mask(mali, js + JS_COMMAND_NEXT, 1u, 0u, 50u);
+	wr32(mali, js + JS_HEAD_NEXT_LO, (uint32_t)jc_va);
+	wr32(mali, js + JS_HEAD_NEXT_HI, (uint32_t)(jc_va >> 32));
+	wr32(mali, js + JS_AFFINITY_NEXT_LO, g_shader_mask);
+	wr32(mali, js + JS_AFFINITY_NEXT_HI, 0u);
+	wr32(mali, js + JS_CONFIG_NEXT, JS_CONFIG_VAL);
+	wr32(mali, js + JS_COMMAND_NEXT, 1u);
+
+	if (!wait_mask(mali, JOB_INT_RAWSTAT, irqm, 1u << slot, 500u)) {
+		g_faults++;
+		if (g_faults <= 8u)
+			printf("BEGONIA MALI: fault jc=%#llx slot=%u irq=%#x fstat=%#x\n",
+			    (unsigned long long)jc_va, slot, rd32(mali, JOB_INT_RAWSTAT), rd32(mali, AS0 + AS_FAULTSTATUS));
+	}
+	wr32(mali, JOB_INT_CLEAR, irqm);
+	g_done_seq = seq;
+	lck_mtx_unlock(&mali_mtx);
+	return seq;
+}
+
+bool
+begonia_mali_wait(uint64_t seq, __unused uint64_t timeout_ns)
+{
+	return seq <= g_done_seq;
+}
+
+void
+begonia_mali_note_client(int delta)
+{
+	if (delta > 0) {
+		(void)__atomic_add_fetch(&g_clients, 1u, __ATOMIC_RELAXED);
+	} else if (delta < 0) {
+		uint32_t cur = __atomic_load_n(&g_clients, __ATOMIC_RELAXED);
+		if (cur > 0u) {
+			(void)__atomic_sub_fetch(&g_clients, 1u, __ATOMIC_RELAXED);
+		}
+	}
+}
+
+void
+begonia_mali_note_buffer(__unused uint64_t addr, __unused uint64_t size)
+{
+	(void)__atomic_add_fetch(&g_buffers, 1u, __ATOMIC_RELAXED);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/begonia_mali_mmu.c b/bsd/dev/begonia_mali_mmu.c
new file mode 100644
index 0000000..4db78b9
--- /dev/null
+++ b/bsd/dev/begonia_mali_mmu.c
@@ -0,0 +1,415 @@
+/*
+ * Mali-G76 AArch64 Stage-1 4K GPU MMU & VA allocator for begonia (MT6785).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <libkern/libkern.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <machine/machine_routines.h>
+#include <mach/vm_param.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <vm/vm_kern_xnu.h>
+#include "sweet_board.h"
+#include "begonia_drivers.h"
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+
+#define AS0                     0x2400u
+#define AS_TRANSTAB_LO          0x00u
+#define AS_TRANSTAB_HI          0x04u
+#define AS_MEMATTR_LO           0x08u
+#define AS_MEMATTR_HI           0x0cu
+#define AS_LOCKADDR_LO          0x10u
+#define AS_LOCKADDR_HI          0x14u
+#define AS_COMMAND              0x18u
+#define AS_STATUS               0x28u
+#define AS_TRANSCFG_LO          0x30u
+#define AS_TRANSCFG_HI          0x34u
+
+/* AS_COMMAND values (Linux drivers/gpu/drm/panfrost/panfrost_regs.h) */
+#define AS_COMMAND_UPDATE       0x01u
+#define AS_COMMAND_LOCK         0x02u
+#define AS_COMMAND_FLUSH_PT     0x04u
+#define AS_COMMAND_FLUSH_MEM    0x05u
+#define AS_TRANSCFG_UNMAPPED    0x01u
+/* the smallest region AS_LOCKADDR can name: 32 KiB (log2 15) */
+#define AS_LOCK_REGION_MIN_LOG2 15u
+/* every GPU VA this allocator hands out is below 4 GiB */
+#define MALI_VA_SPAN            (1ull << 32)
+
+#define PTE_TABLE               3ull
+#define PTE_PAGE                3ull
+#define PTE_AF                  (1ull << 10)
+#define PTE_SH_INNER            (3ull << 8)
+#define PTE_AP_RW               (1ull << 6)
+#define PTE_AP_RO               (3ull << 6)
+#define PTE_ADDR_MASK           0x0000fffffffff000ull
+
+#define MALI_VA_BASE            0x10000000ull
+#define MALI_VA_LIMIT           0xf0000000ull
+#define MALI_FREE_SLOTS         256u
+#define PT_HASH_BUCKETS         1024u
+
+struct pt_rec {
+	uint64_t pa;
+	uint64_t *va;
+	struct pt_rec *next;
+};
+
+struct va_free_slot {
+	uint64_t addr;
+	uint64_t size;
+};
+
+static LCK_GRP_DECLARE(mali_mmu_grp, "begonia-mali-mmu");
+static LCK_MTX_DECLARE(mali_mmu_mtx, &mali_mmu_grp);
+
+static vm_offset_t g_mali_regs;
+static uint32_t g_mmu_va_bits = 48u;
+static vm_offset_t g_pt_slab_va, g_meta_slab_va;
+static uint64_t g_pt_slab_pa, g_pt_root_pa, *g_pt_root_va;
+static uint32_t g_pt_slab_off = PAGE_SIZE, g_meta_slab_off = PAGE_SIZE;
+static struct pt_rec *g_pt_hash[PT_HASH_BUCKETS];
+static uint64_t g_va_cursor = MALI_VA_BASE;
+static struct va_free_slot g_va_free[MALI_FREE_SLOTS];
+
+static inline uint32_t
+mmu_rd(uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(g_mali_regs + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+mmu_wr(uint32_t off, uint32_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(g_mali_regs + off) = v;
+}
+
+static bool
+mmu_wait_idle(void)
+{
+	for (uint32_t us = 0; us < 50000u; us += 10u) {
+		if ((mmu_rd(AS0 + AS_STATUS) & 1u) == 0u) {
+			return true;
+		}
+		delay(10);
+	}
+	return (mmu_rd(AS0 + AS_STATUS) & 1u) == 0u;
+}
+
+/*
+ * One MMU operation on AS0 for [start, start + size), as Linux panfrost does it
+ * (mmu_hw_do_operation_locked + lock_region): the region is locked first (a
+ * naturally aligned power of two, encoded as log2(size) - 1 in AS_LOCKADDR),
+ * then OP runs on it (FLUSH_PT / FLUSH_MEM: flush the GPU L2, then drop the
+ * TLB entries of the locked region and unlock it). The old bare UNLOCK (3)
+ * never programmed AS_LOCKADDR, so it flushed whatever region the register
+ * happened to name: stale translations of an unmapped and reused GPU VA could
+ * survive, and the GPU would keep reading and writing the freed pages.
+ */
+static bool
+mmu_lock_op(uint64_t start, uint64_t size, uint32_t op)
+{
+	uint64_t end = start + size;
+	uint64_t diff = start ^ (end - 1u);
+	uint32_t width = (diff != 0u) ? (64u - (uint32_t)__builtin_clzll(diff)) : 0u;
+
+	if (size == 0u) {
+		return true;
+	}
+	if (width < AS_LOCK_REGION_MIN_LOG2) {
+		width = AS_LOCK_REGION_MIN_LOG2;
+	}
+	width -= 1u;
+	uint64_t region = (start & ~((1ull << width) - 1u)) | width;
+
+	bool ok = mmu_wait_idle();
+	mmu_wr(AS0 + AS_LOCKADDR_LO, (uint32_t)region);
+	mmu_wr(AS0 + AS_LOCKADDR_HI, (uint32_t)(region >> 32));
+	mmu_wr(AS0 + AS_COMMAND, AS_COMMAND_LOCK);
+	ok = mmu_wait_idle() && ok;
+	mmu_wr(AS0 + AS_COMMAND, op);
+	ok = mmu_wait_idle() && ok;
+	return ok;
+}
+
+static void *
+meta_alloc(size_t sz)
+{
+	sz = (sz + 7u) & ~7u;
+	if (g_meta_slab_off + sz > PAGE_SIZE) {
+		vm_offset_t pg = 0;
+		if (kmem_alloc_contig(kernel_map, &pg, PAGE_SIZE, PAGE_MASK, 0, 0,
+		    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			return NULL;
+		}
+		g_meta_slab_va = pg;
+		g_meta_slab_off = 0;
+	}
+	void *p = (void *)(g_meta_slab_va + g_meta_slab_off);
+	g_meta_slab_off += (uint32_t)sz;
+	return p;
+}
+
+static uint64_t *
+pt_alloc_4k(uint64_t *pa_out)
+{
+	if (g_pt_slab_off + 4096u > PAGE_SIZE) {
+		vm_offset_t pg = 0;
+		if (kmem_alloc_contig(kernel_map, &pg, PAGE_SIZE, PAGE_MASK, 0, 0,
+		    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			return NULL;
+		}
+		ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)pg);
+		if (pn == 0) {
+			return NULL;
+		}
+		g_pt_slab_va = pg;
+		g_pt_slab_pa = ptoa_64(pn);
+		g_pt_slab_off = 0;
+	}
+	uint64_t *va = (uint64_t *)(g_pt_slab_va + g_pt_slab_off);
+	uint64_t pa = g_pt_slab_pa + g_pt_slab_off;
+	struct pt_rec *r = (struct pt_rec *)meta_alloc(sizeof(*r));
+	if (r == NULL) {
+		return NULL;
+	}
+	g_pt_slab_off += 4096u;
+	sweet_dma_sync_va(va, 4096u);
+	r->pa = pa;
+	r->va = va;
+	uint32_t b = (uint32_t)((pa >> 12) % PT_HASH_BUCKETS);
+	r->next = g_pt_hash[b];
+	g_pt_hash[b] = r;
+	*pa_out = pa;
+	return va;
+}
+
+static uint64_t *
+pt_find_va(uint64_t pa)
+{
+	pa &= PTE_ADDR_MASK;
+	for (struct pt_rec *r = g_pt_hash[(pa >> 12) % PT_HASH_BUCKETS]; r != NULL; r = r->next) {
+		if (r->pa == pa) {
+			return r->va;
+		}
+	}
+	return NULL;
+}
+
+static uint64_t *
+pt_walk_next(uint64_t *entry)
+{
+	uint64_t phys = 0;
+	uint64_t *child;
+
+	if (*entry & 1ull) {
+		return pt_find_va(*entry);
+	}
+	child = pt_alloc_4k(&phys);
+	if (child == NULL) {
+		return NULL;
+	}
+	*entry = phys | PTE_TABLE;
+	sweet_dma_sync_va(entry, sizeof(*entry));
+	return child;
+}
+
+void
+begonia_mali_mmu_init(vm_offset_t mali_regs, uint32_t va_bits)
+{
+	g_mali_regs = mali_regs;
+	g_mmu_va_bits = va_bits;
+}
+
+uint64_t begonia_mali_mmu_root_pa(void) { return g_pt_root_pa; }
+
+uint32_t
+begonia_mali_mmu_transcfg(void)
+{
+	uint32_t ina = (g_mmu_va_bits <= 55u) ? (55u - g_mmu_va_bits) : 7u;
+	return 6u | (ina << 6) | (1u << 24);
+}
+
+void
+begonia_mali_mmu_as0_set(vm_offset_t mali_regs, uint64_t transtab, uint32_t transcfg)
+{
+	g_mali_regs = mali_regs;
+	/* panfrost_mmu_enable: flush what the old configuration may still cache before switching */
+	(void)mmu_lock_op(0u, ~0ull, AS_COMMAND_FLUSH_MEM);
+	mmu_wr(AS0 + AS_TRANSTAB_LO, (uint32_t)transtab);
+	mmu_wr(AS0 + AS_TRANSTAB_HI, (uint32_t)(transtab >> 32));
+	mmu_wr(AS0 + AS_TRANSCFG_LO, transcfg);
+	mmu_wr(AS0 + AS_TRANSCFG_HI, 0u);
+	mmu_wr(AS0 + AS_MEMATTR_LO, 0x88888888u);
+	mmu_wr(AS0 + AS_MEMATTR_HI, 0x88888888u);
+	mmu_wr(AS0 + AS_COMMAND, AS_COMMAND_UPDATE);
+	mmu_wait_idle();
+}
+
+/*
+ * panfrost_mmu_disable: AS0 to UNMAPPED. Every access through it then faults,
+ * which ends a job that is stalled on a page fault (Mali holds the faulting
+ * access until the driver resolves it; nothing here ever would).
+ */
+void
+begonia_mali_mmu_as0_disable(vm_offset_t mali_regs)
+{
+	g_mali_regs = mali_regs;
+	(void)mmu_lock_op(0u, ~0ull, AS_COMMAND_FLUSH_MEM);
+	mmu_wr(AS0 + AS_TRANSTAB_LO, 0u);
+	mmu_wr(AS0 + AS_TRANSTAB_HI, 0u);
+	mmu_wr(AS0 + AS_MEMATTR_LO, 0u);
+	mmu_wr(AS0 + AS_MEMATTR_HI, 0u);
+	mmu_wr(AS0 + AS_TRANSCFG_LO, AS_TRANSCFG_UNMAPPED);
+	mmu_wr(AS0 + AS_TRANSCFG_HI, 0u);
+	mmu_wr(AS0 + AS_COMMAND, AS_COMMAND_UPDATE);
+	mmu_wait_idle();
+}
+
+/* After page-table edits: flush the GPU L2 and the TLB of every VA this allocator can hand out. */
+void
+begonia_mali_mmu_flush_unlocked(__unused vm_offset_t mali_regs)
+{
+	if (g_mali_regs == 0u) {
+		return;
+	}
+	if (!mmu_lock_op(0u, MALI_VA_SPAN, AS_COMMAND_FLUSH_PT)) {
+		printf("BEGONIA MALI: MMU flush timed out (AS0 status %#x)\n", mmu_rd(AS0 + AS_STATUS));
+	}
+}
+
+bool
+begonia_mali_mmu_map_unlocked(uint64_t gpu_va, uint64_t phys, bool readonly)
+{
+	uint64_t *tbl = g_pt_root_va;
+
+	if (tbl == NULL) {
+		g_pt_root_va = pt_alloc_4k(&g_pt_root_pa);
+		tbl = g_pt_root_va;
+		if (tbl == NULL) {
+			return false;
+		}
+	}
+	if (g_mmu_va_bits > 39u) {
+		if ((tbl = pt_walk_next(&tbl[(gpu_va >> 39) & 0x1ffu])) == NULL) {
+			return false;
+		}
+	}
+	if ((tbl = pt_walk_next(&tbl[(gpu_va >> 30) & 0x1ffu])) == NULL ||
+	    (tbl = pt_walk_next(&tbl[(gpu_va >> 21) & 0x1ffu])) == NULL) {
+		return false;
+	}
+	uint64_t *leaf = &tbl[(gpu_va >> 12) & 0x1ffu];
+	*leaf = (phys & PTE_ADDR_MASK) | PTE_AF | PTE_SH_INNER |
+	    (readonly ? PTE_AP_RO : PTE_AP_RW) | PTE_PAGE;
+	sweet_dma_sync_va(leaf, sizeof(*leaf));
+	return true;
+}
+
+void
+begonia_mali_mmu_unmap_unlocked(uint64_t gpu_va, uint64_t size)
+{
+	for (uint64_t off = 0; off < size; off += 4096ull) {
+		uint64_t va = gpu_va + off;
+		uint64_t *tbl = g_pt_root_va;
+		if (tbl == NULL) {
+			break;
+		}
+		if (g_mmu_va_bits > 39u) {
+			uint64_t e0 = tbl[(va >> 39) & 0x1ffu];
+			if ((e0 & 1ull) == 0u || (tbl = pt_find_va(e0)) == NULL) {
+				continue;
+			}
+		}
+		uint64_t e1 = tbl[(va >> 30) & 0x1ffu];
+		if ((e1 & 1ull) == 0u || (tbl = pt_find_va(e1)) == NULL) {
+			continue;
+		}
+		uint64_t e2 = tbl[(va >> 21) & 0x1ffu];
+		if ((e2 & 1ull) == 0u || (tbl = pt_find_va(e2)) == NULL) {
+			continue;
+		}
+		uint64_t *leaf = &tbl[(va >> 12) & 0x1ffu];
+		*leaf = 0;
+		sweet_dma_sync_va(leaf, sizeof(*leaf));
+	}
+}
+
+uint64_t
+begonia_mali_va_alloc(uint64_t size)
+{
+	uint64_t addr = 0;
+
+	size = (size + 4095ull) & ~4095ull;
+	if (size == 0u) {
+		return 0u;
+	}
+	lck_mtx_lock(&mali_mmu_mtx);
+	for (uint32_t i = 0; i < MALI_FREE_SLOTS; i++) {
+		if (g_va_free[i].size >= size) {
+			addr = g_va_free[i].addr;
+			g_va_free[i].addr += size;
+			g_va_free[i].size -= size;
+			break;
+		}
+	}
+	if (addr == 0u && g_va_cursor + size <= MALI_VA_LIMIT) {
+		addr = g_va_cursor;
+		g_va_cursor += size;
+	}
+	lck_mtx_unlock(&mali_mmu_mtx);
+	return addr;
+}
+
+void
+begonia_mali_va_free(uint64_t gpu_va, uint64_t size)
+{
+	size = (size + 4095ull) & ~4095ull;
+	if (gpu_va == 0u || size == 0u) {
+		return;
+	}
+	lck_mtx_lock(&mali_mmu_mtx);
+	for (uint32_t i = 0; i < MALI_FREE_SLOTS; i++) {
+		if (g_va_free[i].size == 0u) {
+			g_va_free[i].addr = gpu_va;
+			g_va_free[i].size = size;
+			break;
+		}
+	}
+	lck_mtx_unlock(&mali_mmu_mtx);
+}
+
+bool
+begonia_mali_map_page(uint64_t gpu_va, uint64_t phys, bool readonly)
+{
+	bool ok;
+	lck_mtx_lock(&mali_mmu_mtx);
+	ok = begonia_mali_mmu_map_unlocked(gpu_va, phys, readonly);
+	lck_mtx_unlock(&mali_mmu_mtx);
+	return ok;
+}
+
+void
+begonia_mali_unmap_range(uint64_t gpu_va, uint64_t size)
+{
+	lck_mtx_lock(&mali_mmu_mtx);
+	begonia_mali_mmu_unmap_unlocked(gpu_va, size);
+	begonia_mali_mmu_flush_unlocked(g_mali_regs);
+	lck_mtx_unlock(&mali_mmu_mtx);
+}
+
+void
+begonia_mali_mmu_flush(void)
+{
+	lck_mtx_lock(&mali_mmu_mtx);
+	begonia_mali_mmu_flush_unlocked(g_mali_regs);
+	lck_mtx_unlock(&mali_mmu_mtx);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/begonia_touch.c b/bsd/dev/begonia_touch.c
new file mode 100644
index 0000000..f02abae
--- /dev/null
+++ b/bsd/dev/begonia_touch.c
@@ -0,0 +1,393 @@
+/*
+ * Polled MT6785 SPI5 + Novatek NT36672A touchscreen driver for Redmi Note 8 Pro (begonia).
+ * Ports proven mtkloader SPI5 (0x11019000) + NVT (0x21C00) protocol to XNU HID events.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <libkern/libkern.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include "sweet_board.h"
+#include "begonia_drivers.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+
+#define BEGONIA_TOPCKGEN_PA     0x10000000u
+#define BEGONIA_INFRACFG_PA     0x10001000u
+#define BEGONIA_GPIO_PA         0x10005000u
+#define BEGONIA_SPI5_PA         0x11019000u
+
+#define TOPCK_CLK_CFG_UPDATE    0x0004u
+#define TOPCK_CLK_CFG_5_CLR     0x0078u
+#define INFRA_SW_CG2_CLR        0x00a8u
+#define INFRA_CG2_SPI5_BIT      (1u << 26)
+
+#define SPI_CFG0_REG            0x0000u
+#define SPI_CFG1_REG            0x0004u
+#define SPI_TX_DATA_REG         0x0010u
+#define SPI_RX_DATA_REG         0x0014u
+#define SPI_CMD_REG             0x0018u
+#define SPI_STATUS0_REG         0x001cu
+#define SPI_PAD_SEL_REG         0x0024u
+#define SPI_CFG2_REG            0x0028u
+
+#define SPI_CMD_ACT             (1u << 0)
+#define SPI_CMD_RESUME          (1u << 1)
+#define SPI_CMD_RST             (1u << 2)
+#define SPI_CMD_PAUSE_EN        (1u << 4)
+#define SPI_CMD_TXMSBF          (1u << 12)
+#define SPI_CMD_RXMSBF          (1u << 13)
+#define SPI_CMD_FINISH_IE       (1u << 16)
+#define SPI_CMD_PAUSE_IE        (1u << 17)
+#define SPI_FIFO_BYTES          32u
+
+#define NVT_EVENT_BUF_ADDR      0x21c00u
+#define NVT_EVENT_FWINFO        0x78u
+#define NVT_EVENT_PROJECTID     0x9au
+#define NVT_MAX_SLOTS           10u
+#define NVT_EMPTY_RELEASE       3u
+#define PANEL_W                 1080u
+#define PANEL_H                 2340u
+
+static vm_offset_t topck_base, infra_base, gpio_base, spi5_base;
+static bool touch_started;
+static int touch_chan;
+static uint32_t touch_poll_ms = 8;
+static int touch_log;
+
+static inline uint32_t
+reg_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+reg_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+}
+
+static void
+gpio_set_mode(uint32_t pin, uint32_t mode)
+{
+	uint32_t off = 0x0300u + (pin / 8u) * 0x10u;
+	uint32_t shift = (pin % 8u) * 4u;
+	uint32_t v = reg_rd(gpio_base, off);
+	v = (v & ~(0xfu << shift)) | ((mode & 0xfu) << shift);
+	reg_wr(gpio_base, off, v);
+}
+
+static void
+gpio_set_dir(uint32_t pin, bool out)
+{
+	uint32_t off = (pin / 32u) * 0x10u;
+	uint32_t bit = 1u << (pin % 32u);
+	uint32_t v = reg_rd(gpio_base, off);
+	reg_wr(gpio_base, off, out ? (v | bit) : (v & ~bit));
+}
+
+static void
+gpio_set_dout(uint32_t pin, bool val)
+{
+	uint32_t off = 0x0100u + (pin / 32u) * 0x10u;
+	uint32_t bit = 1u << (pin % 32u);
+	uint32_t v = reg_rd(gpio_base, off);
+	reg_wr(gpio_base, off, val ? (v | bit) : (v & ~bit));
+}
+
+static void
+spi5_hw_init(void)
+{
+	/* clk26m (0) and clear PDN_SPI (bit 15) on TOPCKGEN CLK_CFG_5 */
+	reg_wr(topck_base, TOPCK_CLK_CFG_5_CLR, (0x3u << 8) | (1u << 15));
+	reg_wr(topck_base, TOPCK_CLK_CFG_UPDATE, (1u << 21));
+	reg_wr(infra_base, INFRA_SW_CG2_CLR, INFRA_CG2_SPI5_BIT);
+
+	/* GPIO1=INT(in), GPIO2=RST(kept high), GPIO35..38=SPI5_A (func 5) */
+	gpio_set_mode(1u, 0u);
+	gpio_set_dir(1u, false);
+	gpio_set_dout(2u, true);
+	gpio_set_mode(2u, 0u);
+	gpio_set_dir(2u, true);
+
+	gpio_set_mode(35u, 5u);
+	gpio_set_dir(35u, true);
+	gpio_set_mode(36u, 5u);
+	gpio_set_dir(36u, true);
+	gpio_set_mode(37u, 5u);
+	gpio_set_dir(37u, false);
+	gpio_set_mode(38u, 5u);
+	gpio_set_dir(38u, true);
+
+	/* 26 MHz / 6 = ~4.33 MHz, pad-select = 0 */
+	reg_wr(spi5_base, SPI_CMD_REG, SPI_CMD_RST);
+	reg_wr(spi5_base, SPI_CMD_REG, 0u);
+	reg_wr(spi5_base, SPI_PAD_SEL_REG, 0u);
+	reg_wr(spi5_base, SPI_CFG2_REG, ((3u - 1u) << 0) | ((3u - 1u) << 16));
+	reg_wr(spi5_base, SPI_CFG0_REG, ((6u - 1u) << 0) | ((6u - 1u) << 16));
+	reg_wr(spi5_base, SPI_CFG1_REG, 5u);
+}
+
+static int
+spi5_wait_status(void)
+{
+	for (uint32_t spin = 0; spin < 250000u; spin++) {
+		if (reg_rd(spi5_base, SPI_STATUS0_REG) & 3u) {
+			return 0;
+		}
+	}
+	return -1;
+}
+
+static int
+spi5_xfer(const uint8_t *tx, uint8_t *rx, uint32_t len)
+{
+	uint32_t base_cmd = SPI_CMD_TXMSBF | SPI_CMD_RXMSBF | SPI_CMD_FINISH_IE | SPI_CMD_PAUSE_IE;
+	uint32_t off = 0;
+
+	if (len == 0u) {
+		return 0;
+	}
+	reg_wr(spi5_base, SPI_CMD_REG, SPI_CMD_RST);
+	reg_wr(spi5_base, SPI_CMD_REG, 0u);
+	(void)reg_rd(spi5_base, SPI_STATUS0_REG);
+
+	while (off < len) {
+		uint32_t chunk = len - off;
+		bool has_more, is_first;
+		uint32_t cfg1;
+
+		if (chunk > SPI_FIFO_BYTES) {
+			chunk = SPI_FIFO_BYTES;
+		}
+		has_more = (off + chunk) < len;
+		is_first = (off == 0u);
+
+		cfg1 = reg_rd(spi5_base, SPI_CFG1_REG);
+		cfg1 &= ~0x03ffff00u;
+		cfg1 |= ((chunk - 1u) << 16);
+		reg_wr(spi5_base, SPI_CFG1_REG, cfg1);
+
+		for (uint32_t i = 0; i < chunk; i += 4u) {
+			uint32_t w = 0u;
+			uint32_t rem = chunk - i;
+			if (rem > 4u) {
+				rem = 4u;
+			}
+			if (tx != NULL) {
+				for (uint32_t b = 0; b < rem; b++) {
+					w |= ((uint32_t)tx[off + i + b]) << (b * 8u);
+				}
+			}
+			reg_wr(spi5_base, SPI_TX_DATA_REG, w);
+		}
+
+		reg_wr(spi5_base, SPI_CMD_REG,
+		    base_cmd | (has_more ? SPI_CMD_PAUSE_EN : 0u) | (is_first ? SPI_CMD_ACT : SPI_CMD_RESUME));
+
+		if (spi5_wait_status() != 0) {
+			reg_wr(spi5_base, SPI_CMD_REG, SPI_CMD_RST);
+			reg_wr(spi5_base, SPI_CMD_REG, 0u);
+			return -1;
+		}
+
+		for (uint32_t i = 0; i < chunk; i += 4u) {
+			uint32_t w = reg_rd(spi5_base, SPI_RX_DATA_REG);
+			if (rx != NULL) {
+				uint32_t rem = chunk - i;
+				if (rem > 4u) {
+					rem = 4u;
+				}
+				for (uint32_t b = 0; b < rem; b++) {
+					rx[off + i + b] = (uint8_t)(w >> (b * 8u));
+				}
+			}
+		}
+		off += chunk;
+	}
+	return 0;
+}
+
+static int
+nvt_set_page(uint32_t addr)
+{
+	uint8_t tx[3] = {
+		0xffu,
+		(uint8_t)((addr >> 15) & 0xffu),
+		(uint8_t)((addr >> 7) & 0xffu),
+	};
+	return spi5_xfer(tx, NULL, 3u);
+}
+
+static int
+nvt_read_reg(uint8_t reg_addr, uint8_t *out, uint32_t data_len)
+{
+	uint8_t tx[72];
+	uint8_t rx[72];
+	uint32_t total = data_len + 2u;
+
+	if (total > sizeof(tx)) {
+		return -1;
+	}
+	bzero(tx, total);
+	tx[0] = reg_addr & 0x7fu;
+	if (spi5_xfer(tx, rx, total) != 0) {
+		return -1;
+	}
+	memcpy(out, rx + 2, data_len);
+	return 0;
+}
+
+static bool
+nvt_probe_fw(uint8_t *fw_ver, uint16_t *pid)
+{
+	uint8_t info[16];
+	uint8_t pid_buf[2];
+
+	if (nvt_set_page(NVT_EVENT_BUF_ADDR | NVT_EVENT_FWINFO) != 0 ||
+	    nvt_read_reg(NVT_EVENT_FWINFO, info, sizeof(info)) != 0) {
+		return false;
+	}
+	if ((uint8_t)(info[0] + info[1]) != 0xffu || info[0] == 0u) {
+		return false;
+	}
+	*fw_ver = info[0];
+	*pid = 0;
+	if (nvt_set_page(NVT_EVENT_BUF_ADDR | NVT_EVENT_PROJECTID) == 0 &&
+	    nvt_read_reg(NVT_EVENT_PROJECTID, pid_buf, 2u) == 0) {
+		*pid = (uint16_t)(((uint16_t)pid_buf[1] << 8) | pid_buf[0]);
+	}
+	(void)nvt_set_page(NVT_EVENT_BUF_ADDR);
+	return true;
+}
+
+static void
+touch_sleep_ms(uint32_t ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&touch_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+begonia_touch_thread(__unused void *arg, __unused wait_result_t result)
+{
+	bool active[NVT_MAX_SLOTS];
+	uint16_t lx[NVT_MAX_SLOTS], ly[NVT_MAX_SLOTS];
+	uint8_t miss[NVT_MAX_SLOTS];
+	uint8_t fw_ver = 0;
+	uint16_t pid = 0;
+	bool ready = false;
+
+	bzero(active, sizeof(active));
+	bzero(lx, sizeof(lx));
+	bzero(ly, sizeof(ly));
+	bzero(miss, sizeof(miss));
+
+	spi5_hw_init();
+	for (uint32_t t = 0; t < 10u && !ready; t++) {
+		ready = nvt_probe_fw(&fw_ver, &pid);
+		if (!ready) {
+			touch_sleep_ms(100u);
+		}
+	}
+	if (!ready) {
+		printf("BEGONIA TOUCH: NT36672A FW not active in SRAM (boot via mtkloader dualboot to load FW); waiting paused\n");
+		return;
+	}
+	printf("BEGONIA TOUCH: NT36672A ready on SPI5 (pid=%#x fw=v%u poll=%ums)\n",
+	    pid, fw_ver, touch_poll_ms);
+
+	for (;;) {
+		uint8_t pts[65];
+		if (nvt_set_page(NVT_EVENT_BUF_ADDR) == 0 && nvt_read_reg(0x00u, pts, sizeof(pts)) == 0) {
+			bool seen[NVT_MAX_SLOTS];
+			bzero(seen, sizeof(seen));
+
+			for (uint32_t i = 0; i < NVT_MAX_SLOTS; i++) {
+				uint32_t pos = i * 6u;
+				uint8_t id = pts[pos] >> 3;
+				uint8_t state = pts[pos] & 0x07u;
+				if (id < 1u || id > NVT_MAX_SLOTS) {
+					continue;
+				}
+				uint32_t slot = id - 1u;
+				uint32_t x = ((uint32_t)pts[pos + 1u] << 4) | ((uint32_t)pts[pos + 3u] >> 4);
+				uint32_t y = ((uint32_t)pts[pos + 2u] << 4) | ((uint32_t)pts[pos + 3u] & 0x0fu);
+				if ((state == 1u || state == 2u) && x < PANEL_W && y < PANEL_H) {
+					seen[slot] = true;
+					miss[slot] = 0;
+					if (!active[slot] || lx[slot] != x || ly[slot] != y) {
+						active[slot] = true;
+						lx[slot] = (uint16_t)x;
+						ly[slot] = (uint16_t)y;
+						if (touch_log) {
+							printf("BEGONIA TOUCH: slot=%u down (%u,%u)\n", slot, x, y);
+						}
+						sweet_hid_touch((int)slot, 1, (int)x, (int)y);
+					}
+				} else if (state == 3u && active[slot]) {
+					active[slot] = false;
+					miss[slot] = 0;
+					if (touch_log) {
+						printf("BEGONIA TOUCH: slot=%u up (%u,%u)\n", slot, lx[slot], ly[slot]);
+					}
+					sweet_hid_touch((int)slot, 0, (int)lx[slot], (int)ly[slot]);
+				}
+			}
+			for (uint32_t slot = 0; slot < NVT_MAX_SLOTS; slot++) {
+				if (active[slot] && !seen[slot] && ++miss[slot] >= NVT_EMPTY_RELEASE) {
+					active[slot] = false;
+					miss[slot] = 0;
+					sweet_hid_touch((int)slot, 0, (int)lx[slot], (int)ly[slot]);
+				}
+			}
+		}
+		touch_sleep_ms(touch_poll_ms);
+	}
+}
+
+void
+begonia_touch_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+
+	if (touch_started || !sweet_board_begonia()) {
+		return;
+	}
+	touch_started = true;
+	(void)PE_parse_boot_argn("begoniatouch", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("begoniatouchlog", &touch_log, sizeof(touch_log));
+	(void)PE_parse_boot_argn("begoniatouchms", &touch_poll_ms, sizeof(touch_poll_ms));
+	if (touch_poll_ms < 1u || touch_poll_ms > 20u) {
+		touch_poll_ms = 8u;
+	}
+	if (!enabled) {
+		printf("BEGONIA TOUCH: disabled (begoniatouch=0)\n");
+		return;
+	}
+	topck_base = ml_io_map(BEGONIA_TOPCKGEN_PA, 0x1000u);
+	infra_base = ml_io_map(BEGONIA_INFRACFG_PA, 0x1000u);
+	gpio_base = ml_io_map(BEGONIA_GPIO_PA, 0x1000u);
+	spi5_base = ml_io_map(BEGONIA_SPI5_PA, 0x1000u);
+	if (!topck_base || !infra_base || !gpio_base || !spi5_base) {
+		printf("BEGONIA TOUCH: ml_io_map failed\n");
+		return;
+	}
+	if (kernel_thread_start(begonia_touch_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("BEGONIA TOUCH: kernel_thread_start failed\n");
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
