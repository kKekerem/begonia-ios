+/*
+ * SweetMali: IOKit service and user client for begonia Mali-G76 MC4 (MT6785).
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOSubMemoryDescriptor.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+
+#include "SweetMaliABI.h"
+#include "SweetSurface.h"
+#include "../../../bsd/dev/sweet_board.h"
+#include "../../../bsd/dev/begonia_drivers.h"
+
+#define MALI_BUFFERS        2048u
+#define MALI_BUFFER_MAX     (256ull << 20)
+#define MALI_SUBMIT_HANDLES 4096u
+
+struct mali_gem_slot {
+	IOMemoryDescriptor *md;
+	SweetSurface *surface;
+	uint8_t *kva;
+	uint64_t gpu_va;
+	uint64_t size;
+	uint64_t last_seq;
+	bool readonly;
+};
+
+static IOLock *gMaliClientLock;
+
+/*
+ * 20 Nov 2026: what the GPU wrote into an IOSurface, read back through the kernel's write-combine alias (DRAM)
+ * right after the fragment job: 16 texels on a 4x4 grid. The first GPU-composited boot showed a black screen while
+ * every job completed; this separates "the GPU drew black" from "the framebuffer did not show what was drawn".
+ * First 12 fragment jobs that write a surface, then every 400th.
+ */
+static uint32_t gMaliSampleCount;
+
+static void
+mali_sample_surface(const struct mali_gem_slot *b, uint64_t seq)
+{
+	SweetSurface *s = b->surface;
+	if (s == NULL || b->kva == NULL || s->width == 0 || s->height == 0 || s->bytesPerRow == 0) {
+		return;
+	}
+	uint32_t n = gMaliSampleCount++;
+	if (n >= 12u && (n % 400u) != 0u) {
+		return;
+	}
+	uint32_t w = s->width, h = s->height, bpr = s->bytesPerRow;
+	uint64_t sum = 0;
+	uint32_t nonzero = 0, first = 0;
+	for (uint32_t gy = 0; gy < 4u; gy++) {
+		for (uint32_t gx = 0; gx < 4u; gx++) {
+			uint64_t off = (uint64_t)s->offset + (uint64_t)((2u * gy + 1u) * h / 8u) * bpr +
+			    (uint64_t)((2u * gx + 1u) * w / 8u) * 4u;
+			if (off + 4u > b->size) {
+				continue;
+			}
+			uint32_t px = *(volatile uint32_t *)(b->kva + off);
+			if (gy == 0u && gx == 0u) {
+				first = px;
+			}
+			sum += (px & 0xffu) + ((px >> 8) & 0xffu) + ((px >> 16) & 0xffu);
+			if ((px & 0x00ffffffu) != 0u) {
+				nonzero++;
+			}
+		}
+	}
+	IOLog("BEGONIA MALI: fragment seq %llu wrote surface %u (%ux%u fmt %#x bpr %u, gpu va %#llx): mean %llu, "
+	    "%u/16 not black, texel(1/8,1/8) %#010x [sample %u]\n", (unsigned long long)seq, (unsigned)s->id, w, h,
+	    (unsigned)s->pixelFormat, bpr, (unsigned long long)b->gpu_va, (unsigned long long)(sum / 48u), nonzero,
+	    first, n);
+}
+
+class SweetMali : public IOService {
+	OSDeclareDefaultStructors(SweetMali);
+};
+
+OSDefineMetaClassAndStructors(SweetMali, IOService);
+
+class SweetMaliUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(SweetMaliUserClient);
+
+	task_t fTask;
+	struct mali_gem_slot *fBos;
+	uint32_t fNextBo;
+	bool fClosed;
+
+	struct mali_gem_slot *boSlot(uint32_t handle);
+	void freeSlot(struct mali_gem_slot *b);
+	IOReturn mapSlot(struct mali_gem_slot *b, uint64_t from, uint64_t size,
+	    bool readonly, uint32_t *handle);
+	IOReturn createBO(struct sweet_mali_create_bo *r);
+	IOReturn surfaceBO(struct sweet_mali_surface_bo *r);
+	IOReturn submitJobs(struct sweet_mali_submit *r);
+	IOReturn copyIn(uint64_t addr, void *dst, size_t len);
+
+public:
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn clientMemoryForType(UInt32 type, IOOptionBits *options,
+	    IOMemoryDescriptor **memory) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetMaliUserClient, IOUserClient);
+
+extern "C" void SweetMaliPublish(void)
+{
+	if (!begonia_mali_ready()) {
+		return;
+	}
+	if (gMaliClientLock == NULL) {
+		gMaliClientLock = IOLockAlloc();
+	}
+	IOService *plat = IOService::getPlatform();
+	SweetMali *svc = OSTypeAlloc(SweetMali);
+	if (gMaliClientLock == NULL || plat == NULL || svc == NULL || !svc->init()) {
+		OSSafeReleaseNULL(svc);
+		return;
+	}
+	svc->setName(SWEET_MALI_SERVICE_NAME);
+	svc->setProperty(kIOUserClientClassKey, "SweetMaliUserClient");
+	if (svc->attach(plat)) {
+		svc->registerService();
+		IOLog("BEGONIA MALI: IOKit service %s published (gpu_id=%#x, va=%u-bit)\n",
+		    SWEET_MALI_SERVICE_NAME, begonia_mali_gpu_id(), begonia_mali_va_bits());
+	}
+	svc->release();
+}
+
+bool SweetMaliUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	if (!begonia_mali_ready() || owningTask == NULL) {
+		return false;
+	}
+	fTask = owningTask;
+	fBos = (struct mali_gem_slot *)IOMallocZeroData(sizeof(struct mali_gem_slot) * MALI_BUFFERS);
+	if (fBos == NULL) {
+		return false;
+	}
+	begonia_mali_note_client(1);
+	return true;
+}
+
+void SweetMaliUserClient::free(void)
+{
+	if (fBos != NULL) {
+		IOFreeData(fBos, sizeof(struct mali_gem_slot) * MALI_BUFFERS);
+		fBos = NULL;
+	}
+	IOUserClient::free();
+}
+
+struct mali_gem_slot *SweetMaliUserClient::boSlot(uint32_t handle)
+{
+	if (fBos == NULL || handle == 0u || handle > MALI_BUFFERS || fBos[handle - 1u].md == NULL) {
+		return NULL;
+	}
+	return &fBos[handle - 1u];
+}
+
+void SweetMaliUserClient::freeSlot(struct mali_gem_slot *b)
+{
+	if (b->last_seq != 0u) {
+		(void)begonia_mali_wait(b->last_seq, 2ull * NSEC_PER_SEC);
+	}
+	if (b->gpu_va != 0u && b->size != 0u) {
+		begonia_mali_unmap_range(b->gpu_va, b->size);
+		begonia_mali_va_free(b->gpu_va, b->size);
+	}
+	if (b->md != NULL) {
+		b->md->release();
+	}
+	if (b->surface != NULL) {
+		b->surface->release();
+	}
+	bzero(b, sizeof(*b));
+}
+
+IOReturn SweetMaliUserClient::clientClose(void)
+{
+	IOLockLock(gMaliClientLock);
+	if (!fClosed) {
+		fClosed = true;
+		for (uint32_t i = 0; fBos != NULL && i < MALI_BUFFERS; i++) {
+			if (fBos[i].md != NULL) {
+				freeSlot(&fBos[i]);
+			}
+		}
+		begonia_mali_note_client(-1);
+	}
+	IOLockUnlock(gMaliClientLock);
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn SweetMaliUserClient::clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory)
+{
+	IOReturn ret = kIOReturnBadArgument;
+
+	IOLockLock(gMaliClientLock);
+	struct mali_gem_slot *b = boSlot(type);
+	if (b != NULL && b->md != NULL) {
+		b->md->retain();
+		*memory = b->md;
+		*options = 0;
+		ret = kIOReturnSuccess;
+	}
+	IOLockUnlock(gMaliClientLock);
+	return ret;
+}
+
+IOReturn SweetMaliUserClient::copyIn(uint64_t addr, void *dst, size_t len)
+{
+	if (len == 0u) {
+		return kIOReturnSuccess;
+	}
+	if (addr == 0u) {
+		return kIOReturnBadArgument;
+	}
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withAddressRange((mach_vm_address_t)addr, len,
+	    kIODirectionOut, fTask);
+	if (md == NULL) {
+		return kIOReturnNoMemory;
+	}
+	IOReturn ret = md->prepare();
+	if (ret == kIOReturnSuccess) {
+		ret = md->readBytes(0, dst, len) == len ? kIOReturnSuccess : kIOReturnVMError;
+		md->complete();
+	}
+	md->release();
+	return ret;
+}
+
+IOReturn SweetMaliUserClient::mapSlot(struct mali_gem_slot *b, uint64_t from, uint64_t size,
+    bool readonly, uint32_t *handle)
+{
+	uint32_t slot_id = 0;
+
+	for (uint32_t n = 0; n < MALI_BUFFERS; n++) {
+		uint32_t i = (fNextBo + n) % MALI_BUFFERS;
+		if (fBos[i].md == NULL) {
+			slot_id = i + 1u;
+			fNextBo = i + 1u;
+			break;
+		}
+	}
+	if (slot_id == 0u) {
+		return kIOReturnNoResources;
+	}
+	uint64_t gpu_va = begonia_mali_va_alloc(size);
+	if (gpu_va == 0u) {
+		return kIOReturnNoSpace;
+	}
+	bool ok = true;
+	for (uint64_t off = 0; off < size && ok; off += 4096ull) {
+		IOByteCount seglen = 0;
+		addr64_t pa = b->md->getPhysicalSegment(from + off, &seglen, kIOMemoryMapperNone);
+		ok = (pa != 0u) && begonia_mali_map_page(gpu_va + off, pa, readonly);
+	}
+	if (!ok) {
+		begonia_mali_unmap_range(gpu_va, size);
+		begonia_mali_va_free(gpu_va, size);
+		return kIOReturnNoMemory;
+	}
+	begonia_mali_mmu_flush();
+	b->gpu_va = gpu_va;
+	b->size = size;
+	b->readonly = readonly;
+	*handle = slot_id;
+	fBos[slot_id - 1u] = *b;
+	begonia_mali_note_buffer(gpu_va, size);
+	return kIOReturnSuccess;
+}
+
+IOReturn SweetMaliUserClient::createBO(struct sweet_mali_create_bo *r)
+{
+	uint64_t size = (r->size + PAGE_SIZE - 1u) & ~(uint64_t)(PAGE_SIZE - 1u);
+	if (size == 0u || size > MALI_BUFFER_MAX) {
+		return kIOReturnBadArgument;
+	}
+	IOBufferMemoryDescriptor *mem = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryKernelUserShared | kIOMapWriteCombineCache,
+	    (vm_size_t)size, PAGE_SIZE);
+	if (mem == NULL) {
+		return kIOReturnNoMemory;
+	}
+	uint8_t *kva = (uint8_t *)mem->getBytesNoCopy();
+	if (kva == NULL) {
+		mem->release();
+		return kIOReturnNoMemory;
+	}
+	bzero(kva, (size_t)size);
+	sweet_dma_sync_va(kva, (size_t)size);
+	struct mali_gem_slot tmp;
+	bzero(&tmp, sizeof(tmp));
+	tmp.md = mem;
+	tmp.kva = kva;
+	IOReturn ret = mapSlot(&tmp, 0u, size, false, &r->handle);
+	if (ret != kIOReturnSuccess) {
+		mem->release();
+		return ret;
+	}
+	r->offset = fBos[r->handle - 1u].gpu_va;
+	return kIOReturnSuccess;
+}
+
+IOReturn SweetMaliUserClient::surfaceBO(struct sweet_mali_surface_bo *r)
+{
+	SweetSurface *s = sweet_surface_copy(r->surface_id);
+	if (s == NULL) {
+		return kIOReturnNotFound;
+	}
+	if (s->memory == NULL) {
+		s->release();
+		return kIOReturnUnsupported;
+	}
+	uint64_t size = (s->memory->getLength() + PAGE_SIZE - 1u) & ~(uint64_t)(PAGE_SIZE - 1u);
+	r->size = size;
+	r->offset = s->offset + (s->wrapped ? s->wrapDelta : 0u);
+	r->bytes_per_row = s->bytesPerRow;
+	r->width = s->width;
+	r->height = s->height;
+	r->pixel_format = s->pixelFormat;
+	uint32_t in_sync = r->flags & SWEET_MALI_SBO_IN_SYNC;
+	uint32_t out_flags = (s->wrapped ? (SWEET_MALI_SBO_READONLY | SWEET_MALI_SBO_CPU_CACHE | SWEET_MALI_SBO_WRAPPED) :
+	    (s->pooled ? SWEET_MALI_SBO_CPU_CACHE : 0u));
+	r->planes = s->planeCount;
+	r->gpu_va = 0;
+	r->flags = out_flags;
+	if (r->handle == SWEET_MALI_DESCRIBE_ONLY) {
+		r->handle = 0;
+		s->release();
+		return kIOReturnSuccess;
+	}
+	for (uint32_t i = 0; i < MALI_BUFFERS; i++) {
+		if (fBos[i].md != NULL && fBos[i].surface == s) {
+			r->handle = i + 1u;
+			r->gpu_va = fBos[i].gpu_va;
+			r->flags = out_flags | SWEET_MALI_SBO_EXISTING;
+			if (in_sync && fBos[i].kva != NULL)
+				sweet_dma_sync_va(fBos[i].kva, (size_t)fBos[i].size);
+			s->release();
+			return kIOReturnSuccess;
+		}
+	}
+	struct mali_gem_slot tmp;
+	bzero(&tmp, sizeof(tmp));
+	s->memory->retain();
+	tmp.md = s->memory;
+	tmp.surface = s;
+	uintptr_t ka = s->kernelAddress();
+	tmp.kva = ka != 0u ? (uint8_t *)(ka - (s->wrapped ? s->wrapDelta : 0u)) : NULL;
+	IOReturn ret = mapSlot(&tmp, 0u, size, s->wrapped, &r->handle);
+	if (ret != kIOReturnSuccess) {
+		s->memory->release();
+		s->release();
+		return ret;
+	}
+	if (in_sync && fBos[r->handle - 1u].kva != NULL)
+		sweet_dma_sync_va(fBos[r->handle - 1u].kva, (size_t)fBos[r->handle - 1u].size);
+	r->gpu_va = fBos[r->handle - 1u].gpu_va;
+	{
+		static uint32_t logged;
+		if (logged < 24u) {
+			logged++;
+			IOLog("BEGONIA MALI: surface %u %ux%u fmt %#x bpr %u offset %u -> gpu va %#llx size %#llx handle %u%s\n",
+			    (unsigned)s->id, (unsigned)s->width, (unsigned)s->height, (unsigned)s->pixelFormat,
+			    (unsigned)s->bytesPerRow, (unsigned)r->offset, (unsigned long long)r->gpu_va,
+			    (unsigned long long)size, r->handle, s->wrapped ? " (wrapped, read-only)" : "");
+		}
+	}
+	return kIOReturnSuccess;
+}
+
+IOReturn SweetMaliUserClient::submitJobs(struct sweet_mali_submit *r)
+{
+	if (r->jc == 0u) {
+		r->jc = begonia_mali_last_seq();
+		return kIOReturnSuccess;
+	}
+	bool fragment = (r->requirements & SWEET_MALI_JD_REQ_FS) != 0u;
+	uint64_t seq = begonia_mali_submit(r->jc, fragment);
+	if (seq == 0u) {
+		return kIOReturnError;
+	}
+	uint32_t cnt = r->bo_handle_count;
+	if (cnt > MALI_SUBMIT_HANDLES) {
+		cnt = MALI_SUBMIT_HANDLES;
+	}
+	for (uint32_t off = 0; off < cnt; off += 64u) {
+		uint32_t handles[64];
+		uint32_t n = (cnt - off) < 64u ? (cnt - off) : 64u;
+		if (copyIn(r->bo_handles + off * sizeof(uint32_t), handles, n * sizeof(uint32_t)) != kIOReturnSuccess) {
+			break;
+		}
+		for (uint32_t k = 0; k < n; k++) {
+			struct mali_gem_slot *b = boSlot(handles[k]);
+			if (b != NULL) {
+				b->last_seq = seq;
+				/* display-sized surfaces only: the compositor's framebuffers (828x1792 here) */
+				if (fragment && b->surface != NULL && !b->readonly && b->surface->width >= 600u &&
+				    b->surface->height >= 1200u) {
+					mali_sample_surface(b, seq);
+				}
+			}
+		}
+	}
+	r->jc = seq;
+	return kIOReturnSuccess;
+}
+
+IOReturn SweetMaliUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target, __unused void *reference)
+{
+	union {
+		struct sweet_mali_gem_close close;
+		struct sweet_mali_submit submit;
+		struct sweet_mali_wait_bo waitbo;
+		struct sweet_mali_create_bo create;
+		struct sweet_mali_mmap_bo mmapbo;
+		struct sweet_mali_get_param param;
+		struct sweet_mali_get_bo_offset boff;
+		struct sweet_mali_madvise madv;
+		struct sweet_mali_info info;
+		struct sweet_mali_surface_bo sbo;
+		struct sweet_mali_bo_sync sync;
+		struct sweet_mali_wait_seq wseq;
+	} req;
+	size_t sz = args->structureInputSize;
+	IOReturn ret = kIOReturnSuccess;
+
+	if (args->structureInput == NULL || sz > sizeof(req) || fBos == NULL) {
+		return kIOReturnBadArgument;
+	}
+	if (!begonia_mali_ready()) {
+		return kIOReturnNotReady;
+	}
+	bzero(&req, sizeof(req));
+	memcpy(&req, args->structureInput, sz);
+
+	if (selector == SWEET_MALI_SEL_WAIT_SEQ || selector == SWEET_MALI_SEL_WAIT_BO) {
+		uint64_t seq = req.wseq.seq;
+		int64_t tmo = req.wseq.timeout_ns;
+		if (selector == SWEET_MALI_SEL_WAIT_BO) {
+			IOLockLock(gMaliClientLock);
+			struct mali_gem_slot *b = boSlot(req.waitbo.handle);
+			if (b == NULL) {
+				IOLockUnlock(gMaliClientLock);
+				return kIOReturnNotFound;
+			}
+			seq = b->last_seq;
+			tmo = req.waitbo.timeout_ns;
+			IOLockUnlock(gMaliClientLock);
+		}
+		ret = (seq == 0u || begonia_mali_wait(seq, tmo > 0 ? (uint64_t)tmo : 0u)) ?
+		    kIOReturnSuccess : kIOReturnTimeout;
+		if (args->structureOutput != NULL && args->structureOutputSize >= sz) {
+			memcpy(args->structureOutput, &req, sz);
+			args->structureOutputSize = (uint32_t)sz;
+		}
+		return ret;
+	}
+
+	IOLockLock(gMaliClientLock);
+	switch (selector) {
+	case SWEET_MALI_SEL_GET_PARAM:
+		if (!begonia_mali_param(req.param.param, &req.param.value)) {
+			ret = kIOReturnBadArgument;
+		}
+		break;
+	case SWEET_MALI_SEL_CREATE_BO:
+		ret = createBO(&req.create);
+		break;
+	case SWEET_MALI_SEL_MMAP_BO:
+		if (boSlot(req.mmapbo.handle) == NULL) {
+			ret = kIOReturnNotFound;
+		} else {
+			req.mmapbo.offset = (uint64_t)req.mmapbo.handle << 12;
+		}
+		break;
+	case SWEET_MALI_SEL_GET_BO_OFF: {
+		struct mali_gem_slot *b = boSlot(req.boff.handle);
+		if (b == NULL) {
+			ret = kIOReturnNotFound;
+		} else {
+			req.boff.offset = b->gpu_va;
+		}
+		break;
+	}
+	case SWEET_MALI_SEL_SUBMIT:
+		ret = submitJobs(&req.submit);
+		break;
+	case SWEET_MALI_SEL_SURFACE_BO:
+		ret = surfaceBO(&req.sbo);
+		break;
+	case SWEET_MALI_SEL_BO_SYNC: {
+		struct mali_gem_slot *b = boSlot(req.sync.handle);
+		if (b == NULL) {
+			ret = kIOReturnNotFound;
+		} else if (b->kva != NULL) {
+			sweet_dma_sync_va(b->kva, (size_t)b->size);
+		}
+		break;
+	}
+	case SWEET_MALI_SEL_MADVISE:
+		req.madv.retained = 1;
+		break;
+	case SWEET_MALI_SEL_GEM_CLOSE: {
+		struct mali_gem_slot *b = boSlot(req.close.handle);
+		if (b == NULL) {
+			ret = kIOReturnNotFound;
+		} else {
+			freeSlot(b);
+		}
+		break;
+	}
+	case SWEET_MALI_SEL_INFO: {
+		uint32_t flts = begonia_mali_faults();
+		req.info.version = SWEET_MALI_ABI_VERSION;
+		req.info.abi_minor = 1;
+		req.info.flags = (begonia_mali_ready() ? SWEET_MALI_INFO_READY : 0u) |
+		    (begonia_mali_lost() ? SWEET_MALI_INFO_LOST : 0u);
+		req.info.gpu_id = begonia_mali_gpu_id();
+		req.info.va_bits = begonia_mali_va_bits();
+		req.info.faults = flts;
+		req.info.last_seq = begonia_mali_last_seq();
+		break;
+	}
+	default:
+		ret = kIOReturnUnsupported;
+		break;
+	}
+	IOLockUnlock(gMaliClientLock);
+
+	if (args->structureOutput != NULL && args->structureOutputSize >= sz) {
+		memcpy(args->structureOutput, &req, sz);
+		args->structureOutputSize = (uint32_t)sz;
+	}
+	return ret;
+}
+#endif /* SWEET */
diff --git a/iokit/Kernel/arm/SweetMaliABI.h b/iokit/Kernel/arm/SweetMaliABI.h
new file mode 100644
index 0000000..569bcc3
--- /dev/null
+++ b/iokit/Kernel/arm/SweetMaliABI.h
@@ -0,0 +1,106 @@
+/*
+ * SweetMali: IOKit ABI for ARM Mali-G76 MC4 on Redmi Note 8 Pro (begonia / MT6785).
+ * Matches Linux Panfrost DRM ioctl selectors/structs plus SweetSurface import.
+ */
+#ifndef _SWEET_MALI_ABI_H_
+#define _SWEET_MALI_ABI_H_
+
+#include <stdint.h>
+
+#define SWEET_MALI_SERVICE_NAME     "SweetMali"
+#define SWEET_MALI_ABI_VERSION      1
+
+enum sweet_mali_selector {
+	SWEET_MALI_SEL_GEM_CLOSE    = 0x09,
+	SWEET_MALI_SEL_SUBMIT       = 0x40,
+	SWEET_MALI_SEL_WAIT_BO      = 0x41,
+	SWEET_MALI_SEL_CREATE_BO    = 0x42,
+	SWEET_MALI_SEL_MMAP_BO      = 0x43,
+	SWEET_MALI_SEL_GET_PARAM    = 0x44,
+	SWEET_MALI_SEL_GET_BO_OFF   = 0x45,
+	SWEET_MALI_SEL_MADVISE      = 0x48,
+	SWEET_MALI_SEL_INFO         = 0x70,
+	SWEET_MALI_SEL_SURFACE_BO   = 0x71,
+	SWEET_MALI_SEL_BO_SYNC      = 0x72,
+	SWEET_MALI_SEL_WAIT_SEQ     = 0x7d,
+};
+
+#define SWEET_MALI_JD_REQ_FS        (1u << 0)
+#define SWEET_MALI_DESCRIBE_ONLY    0xffffffffu
+
+#define SWEET_MALI_INFO_READY       0x1u
+#define SWEET_MALI_INFO_LOST        0x2u
+
+#define SWEET_MALI_SBO_IN_SYNC      0x1u
+#define SWEET_MALI_SBO_READONLY     0x1u
+#define SWEET_MALI_SBO_CPU_CACHE    0x2u
+#define SWEET_MALI_SBO_WRAPPED      0x4u
+#define SWEET_MALI_SBO_EXISTING     0x8u
+
+struct sweet_mali_gem_close {
+	uint32_t handle, pad;
+};
+
+struct sweet_mali_submit {
+	uint64_t jc;
+	uint64_t in_syncs;
+	uint32_t in_sync_count;
+	uint32_t out_sync;
+	uint64_t bo_handles;
+	uint32_t bo_handle_count;
+	uint32_t requirements;
+};
+
+struct sweet_mali_wait_bo {
+	uint32_t handle, pad;
+	int64_t timeout_ns;
+};
+
+struct sweet_mali_create_bo {
+	uint32_t size, flags, handle, pad;
+	uint64_t offset;
+};
+
+struct sweet_mali_mmap_bo {
+	uint32_t handle, flags;
+	uint64_t offset;
+};
+
+struct sweet_mali_get_param {
+	uint32_t param, pad;
+	uint64_t value;
+};
+
+struct sweet_mali_get_bo_offset {
+	uint32_t handle, pad;
+	uint64_t offset;
+};
+
+struct sweet_mali_madvise {
+	uint32_t handle, madv, retained;
+};
+
+struct sweet_mali_info {
+	uint32_t version, abi_minor, flags, gpu_id;
+	uint32_t va_bits, faults;
+	uint64_t last_seq;
+};
+
+struct sweet_mali_surface_bo {
+	uint32_t surface_id, handle;
+	uint64_t size, gpu_va;
+	uint32_t offset, bytes_per_row;
+	uint32_t width, height, pixel_format, planes;
+	uint32_t flags, pad;
+};
+
+struct sweet_mali_bo_sync {
+	uint32_t handle, flags;
+};
+
+struct sweet_mali_wait_seq {
+	uint64_t seq;
+	int64_t timeout_ns;
+};
+
+#endif /* _SWEET_MALI_ABI_H_ */
