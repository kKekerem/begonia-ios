+#define BEGONIA_DISP_PWM0_PA   0x1100e000u
+#define BEGONIA_PWM_EN         0x00u
+#define BEGONIA_PWM_COMMIT     0x0cu
+#define BEGONIA_PWM_CON1       0x1cu
+
+bool
+AppleCLCD::begoniaPwmWrite(uint32_t high)
+{
+	if (fBlPwm == 0 || fBlPwmPeriod == 0) {
+		return false;
+	}
+	if (high > fBlPwmPeriod) {
+		high = fBlPwmPeriod;
+	}
+	volatile uint32_t *pwm = (volatile uint32_t *)fBlPwm;
+	uint32_t con1 = (fBlPwmPeriod & 0xfffu) | ((high & 0x1fffu) << 16);
+	pwm[BEGONIA_PWM_CON1 / 4] = con1;
+	pwm[BEGONIA_PWM_COMMIT / 4] = 1u;
+	pwm[BEGONIA_PWM_COMMIT / 4] = 0u;
+	uint32_t en = pwm[BEGONIA_PWM_EN / 4];
+	pwm[BEGONIA_PWM_EN / 4] = (high > 0) ? (en | 1u) : (en & ~1u);
+	return (pwm[BEGONIA_PWM_CON1 / 4] & 0x1fffffffu) == con1;
+}
+
 void
 AppleCLCD::blInit(void)
 {
+	if (sweet_board_begonia()) {
+		vm_offset_t infra = ml_io_map(0x10001000u, 0x1000u);
+		if (infra != 0) {
+			*(volatile uint32_t *)(infra + 0x0a8u) = (1u << 2);
+			__asm__ volatile("dsb sy" ::: "memory");
+		}
+		fBlPwm = ml_io_map(BEGONIA_DISP_PWM0_PA, 0x1000u);
+		if (fBlPwm == 0) {
+			IOLog("SWEET FB: begonia disp_pwm0 map failed; pixel fallback\n");
+			return;
+		}
+		volatile uint32_t *pwm = (volatile uint32_t *)fBlPwm;
+		uint32_t en = pwm[BEGONIA_PWM_EN / 4];
+		uint32_t con1 = pwm[BEGONIA_PWM_CON1 / 4];
+		uint32_t period = con1 & 0xfffu;
+		uint32_t high = (con1 >> 16) & 0x1fffu;
+		if (period == 0) {
+			IOLog("SWEET FB: begonia disp_pwm0 period=0 (en=%#x con1=%#x); pixel fallback\n", en, con1);
+			return;
+		}
+		fBlPwmPeriod = period;
+		uint32_t lvl = ((uint32_t)high * 4095u + period / 2u) / period;
+		if (lvl > 4095u) {
+			lvl = 4095u;
+		}
+		if (lvl == 0u) {
+			lvl = 1024u;
