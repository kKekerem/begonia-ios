+/*
+ * panfrost_gpu_soft_reset: SOFT_RESET, and HARD_RESET when the soft one does
+ * not report RESET_COMPLETED. The interrupt masks stay 0: nothing here takes
+ * the Mali IRQs, every wait polls the RAWSTAT registers.
+ */
+static bool
+mali_soft_reset(void)
+{
+	wr32(mali, GPU_INT_MASK, 0u);
+	wr32(mali, GPU_INT_CLEAR, GPU_IRQ_RESET_COMPLETED);
+	wr32(mali, GPU_CMD, GPU_CMD_SOFT_RESET);
+	if (!wait_mask(mali, GPU_INT_RAWSTAT, GPU_IRQ_RESET_COMPLETED, GPU_IRQ_RESET_COMPLETED, 50u)) {
+		printf("BEGONIA MALI: soft reset timed out, trying a hard reset\n");
+		wr32(mali, GPU_CMD, GPU_CMD_HARD_RESET);
+		if (!wait_mask(mali, GPU_INT_RAWSTAT, GPU_IRQ_RESET_COMPLETED, GPU_IRQ_RESET_COMPLETED, 50u)) {
+			printf("BEGONIA MALI: hard reset timed out\n");
+			return false;
+		}
+	}
+	wr32(mali, GPU_INT_CLEAR, 0xffffffffu);
+	wr32(mali, GPU_INT_MASK, 0u);
+	wr32(mali, JOB_INT_MASK, 0u);
+	wr32(mali, JOB_INT_CLEAR, 0xffffffffu);
+	wr32(mali, MMU_INT_MASK, 0u);
+	wr32(mali, MMU_INT_CLEAR, 0xffffffffu);
+	return true;
+}
+
+/*
+ * panfrost_gpu_init_quirks for G76 (hw_features_g76 has TLS_HASHING and
+ * IDVS_GROUP_SIZE). Read-modify-write as kbase does, so the reset defaults of
+ * the other bits stay. Without TLS hashing the cores index thread-local
+ * storage by thread, not by the THREAD_TLS_ALLOC slots Mesa sizes it for.
+ */
+static void
+mali_apply_quirks(void)
+{
+	uint32_t sc = rd32(mali, GPU_SHADER_CONFIG);
+	sc = (g_exp_mask & EXP_NO_TLS_HASH) ? (sc & ~SC_TLS_HASH_ENABLE) : (sc | SC_TLS_HASH_ENABLE);
+	wr32(mali, GPU_SHADER_CONFIG, sc);
+	wr32(mali, GPU_JM_CONFIG, (rd32(mali, GPU_JM_CONFIG) & ~JM_IDVS_GROUP_SIZE_MASK) |
+	    (JM_DEFAULT_IDVS_GROUP_SIZE << JM_IDVS_GROUP_SIZE_SHIFT));
+	/* the experiments below are reset defaults unless asked for (a soft reset clears them again) */
+	if (g_exp_mask & EXP_L2_LIMITS) {
+		uint32_t l2 = rd32(mali, GPU_L2_MMU_CONFIG) &
+		    ~((7u << L2_MMU_3BIT_RD_SHIFT) | (7u << L2_MMU_3BIT_WR_SHIFT));
+		wr32(mali, GPU_L2_MMU_CONFIG, l2 | (4u << L2_MMU_3BIT_RD_SHIFT) | (4u << L2_MMU_3BIT_WR_SHIFT));
+	}
+	if (g_exp_mask & EXP_COHERENCY_NONE) {
+		wr32(mali, COHERENCY_ENABLE, COHERENCY_NONE);
+	}
+	if (g_exp_mask & EXP_PWR_OVERRIDE) {
+		wr32(mali, GPU_PWR_KEY, GPU_PWR_KEY_UNLOCK);
+		wr32(mali, GPU_PWR_OVERRIDE1, 0xfffu | (0x20u << 16));
+	}
+	if (g_exp_mask & EXP_MEMATTR_NC) {
+		begonia_mali_mmu_set_memattr(0x4c4c4c4cu, 0x4c4c4c4cu);
+	} else {
+		begonia_mali_mmu_set_memattr(0x88888888u, 0x88888888u);
+	}
+}
+
+/* Words of GPU memory for the hang dump: GPU VA -> PA through AS0, a temporary device mapping. */
+static bool
+mali_peek(uint64_t gpu_va, uint32_t *out, uint32_t nwords)
+{
+	uint64_t pa = 0;
+	if (gpu_va == 0u || (gpu_va & 3u) != 0u || !begonia_mali_mmu_lookup(gpu_va, &pa)) {
+		return false;
+	}
+	uint32_t off = (uint32_t)(pa & 0xfffull);
+	if (off + nwords * 4u > 4096u) {
+		nwords = (4096u - off) / 4u;
+	}
+	/*
+	 * Through the kernel's physical aperture: no new mapping. An ml_io_map window over a managed page made
+	 * pmap_assert_free panic when the page was freed (gpu10, at shutdown); ml_io_unmap panicked too (gpu9).
+	 * The lines are cleaned+invalidated first, so the read comes from DRAM (what the GPU wrote).
+	 */
+	uint64_t va = phystokv(pa);
+	for (uint64_t a = va & ~63ull; a < va + (uint64_t)nwords * 4u; a += 64u) {
+		__asm__ volatile ("dc civac, %0" :: "r"(a) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (uint32_t i = 0; i < nwords; i++) {
+		out[i] = *(volatile uint32_t *)(va + i * 4u);
+	}
+	for (uint32_t i = nwords; i < 32u; i++) {
+		out[i] = 0xdeadbeefu;
+	}
+	return true;
+}
+
+static void
+mali_dump_mem(const char *tag, uint64_t gpu_va, uint32_t nwords)
+{
+	uint32_t w[32];
+	if (nwords > 32u) {
+		nwords = 32u;
+	}
+	if (!mali_peek(gpu_va, w, nwords)) {
+		printf("BEGONIA MALI DUMP: %s %#llx: not mapped\n", tag, (unsigned long long)gpu_va);
+		return;
+	}
+	for (uint32_t i = 0; i < nwords; i += 8u) {
+		printf("BEGONIA MALI DUMP: %s %#llx+%02x: %08x %08x %08x %08x %08x %08x %08x %08x\n",
+		    tag, (unsigned long long)gpu_va, i * 4u, w[i], w[i + 1u], w[i + 2u], w[i + 3u],
+		    w[i + 4u], w[i + 5u], w[i + 6u], w[i + 7u]);
+	}
+}
+
+/*
+ * 20 Nov 2026: the descriptors of a fragment job that COMPLETED (first 6): in the first GPU-composited boots
+ * every fragment job finished in 0 ms and left the IOSurface untouched (all texels 0, alpha too). Job header +
+ * payload, then the framebuffer descriptor (v7: parameters 64 B, padding 64 B, ZS/CRC extension, render targets
+ * 64 B each: word 1 bit 0 = write enable, words 8-9 = base, 10 = row stride) and the tiler context it points to.
+ */
+static uint32_t g_frag_dumps;
+
+static void
+mali_dump_frag(uint64_t jc_va)
+{
+	uint32_t w[32];
+	printf("BEGONIA MALI FRAG: fragment job %u done, jc %#llx\n", g_frag_dumps, (unsigned long long)jc_va);
+	mali_dump_mem("fjob", jc_va, 16u);
+	if (!mali_peek(jc_va, w, 12u)) {
+		return;
+	}
+	uint64_t fbp = (uint64_t)w[10] | ((uint64_t)w[11] << 32);
+	uint64_t fbd = fbp & ~0x3full;
+	printf("BEGONIA MALI FRAG: fbd pointer %#llx (zs/crc ext %u, %u render targets) bounds %u,%u..%u,%u\n",
+	    (unsigned long long)fbp, (unsigned)((fbp >> 1) & 1u), (unsigned)(((fbp >> 2) & 0xfu) + 1u),
+	    w[8] & 0xfffu, (w[8] >> 16) & 0xfffu, w[9] & 0xfffu, (w[9] >> 16) & 0xfffu);
+	mali_dump_mem("fbd", fbd, 32u);
+	mali_dump_mem("fbd+80", fbd + 0x80u, 32u);
+	mali_dump_mem("fbd+100", fbd + 0x100u, 32u);
+	if (mali_peek(fbd, w, 16u)) {
+		uint64_t tiler = (uint64_t)w[14] | ((uint64_t)w[15] << 32);
+		if (tiler != 0u) {
+			mali_dump_mem("tiler", tiler, 16u);
+		}
+	}
+}
+
+/*
+ * 20 Nov 2026: the vertex side of the first frames (gpu10: every fragment job had no primitive in any tile, so
+ * nothing was written back). Each slot-1 job chain is walked (Next): header (type, exception status); for an
+ * IDVS (10) or tiler (7) job its tiler pointer, draw descriptors and the first 8 positions the position shader
+ * wrote (draw word 4-5 = Position), as floats in hex. First 8 chains that hold such a job.
+ */
+static uint32_t g_vtx_dumps;
+
+static void
+mali_dump_vertex_chain(uint64_t jc_va)
+{
+	uint64_t job = jc_va;
+	bool counted = false;
+	for (uint32_t n = 0; n < 6u && job != 0u; n++) {
+		uint32_t h[32];
+		if (!mali_peek(job, h, 32u)) {
+			return;
+		}
+		uint32_t type = (h[4] >> 1) & 0x7fu;
+		if (type != 10u && type != 7u && type != 5u) {
+			job = (uint64_t)h[6] | ((uint64_t)h[7] << 32);
+			continue;
+		}
+		if (!counted) {
+			counted = true;
+			g_vtx_dumps++;
+		}
+		uint64_t tiler = (uint64_t)h[18] | ((uint64_t)h[19] << 32);
+		printf("BEGONIA MALI VTX: chain %u job %#llx type %u status %#x first_incomplete %#x tiler %#llx\n",
+		    g_vtx_dumps, (unsigned long long)job, type, h[0], h[1], (unsigned long long)tiler);
+		mali_dump_mem("vjob", job, 32u);
+		if (type == 10u || type == 7u) {
+			uint32_t d[32];
+			mali_dump_mem("vdraw", job + 128u, 32u);
+			if (type == 10u) {
+				mali_dump_mem("vdraw2", job + 256u, 32u);
+			}
+			/* IDVS: the position buffer is the FRAGMENT draw's Position (gpu11: the vertex draw's was 0) */
+			if (mali_peek(job + 128u, d, 32u)) {
+				uint64_t pos = (uint64_t)d[4] | ((uint64_t)d[5] << 32);
+				uint64_t rsd = (uint64_t)d[14] | ((uint64_t)d[15] << 32);
+				uint64_t vbufs = (uint64_t)d[20] | ((uint64_t)d[21] << 32);
+				uint64_t vars = (uint64_t)d[22] | ((uint64_t)d[23] << 32);
+				printf("BEGONIA MALI VTX: positions %#llx state %#llx varying buffers %#llx varyings %#llx\n",
+				    (unsigned long long)pos, (unsigned long long)rsd, (unsigned long long)vbufs,
+				    (unsigned long long)vars);
+				mali_dump_mem("pos", pos, 32u);
+				mali_dump_mem("rsd", rsd, 32u);
+				mali_dump_mem("vbufs", vbufs, 16u);
+				mali_dump_mem("vars", vars, 16u);
+			}
+			if (tiler != 0u) {
+				uint32_t t[32];
+				mali_dump_mem("vtiler", tiler, 16u);
+				if (mali_peek(tiler, t, 8u)) {
+					uint64_t heap = (uint64_t)t[6] | ((uint64_t)t[7] << 32);
+					mali_dump_mem("heap", heap, 8u);
+				}
+			}
+		}
+		job = (uint64_t)h[6] | ((uint64_t)h[7] << 32);
+	}
+}
+
+/* Everything the hardware says about a hung slot (called with mali_mtx held, before the reset). */
+static void
+mali_dump_hang(uint32_t slot, uint64_t jc_va)
+{
+	uint32_t js = JS_SLOT(slot);
+	uint64_t tail = rd32(mali, js + JS_TAIL_LO) | ((uint64_t)rd32(mali, js + JS_TAIL_HI) << 32);
+
+	printf("BEGONIA MALI DUMP: step %u mask %#x | gpu_status=%#x gpu_fault=%#x@%#x%08x gpu_irq=%#x job_irq=%#x js_state=%#x\n",
+	    g_exp_step, g_exp_mask, rd32(mali, GPU_STATUS), rd32(mali, GPU_FAULT_STATUS), rd32(mali, GPU_FAULT_ADDR_HI),
+	    rd32(mali, GPU_FAULT_ADDR_LO), rd32(mali, GPU_INT_RAWSTAT), rd32(mali, JOB_INT_RAWSTAT), rd32(mali, JOB_INT_JS_STATE));
+	printf("BEGONIA MALI DUMP: ready sh=%#x ti=%#x l2=%#x stack=%#x | trans sh=%#x ti=%#x l2=%#x | active sh=%#x ti=%#x l2=%#x\n",
+	    rd32(mali, SHADER_READY_LO), rd32(mali, TILER_READY_LO), rd32(mali, L2_READY_LO), rd32(mali, STACK_READY_LO),
+	    rd32(mali, SHADER_PWRTRANS_LO), rd32(mali, TILER_PWRTRANS_LO), rd32(mali, L2_PWRTRANS_LO),
+	    rd32(mali, SHADER_PWRACTIVE_LO), rd32(mali, TILER_PWRACTIVE_LO), rd32(mali, L2_PWRACTIVE_LO));
+	printf("BEGONIA MALI DUMP: shader_cfg=%#x tiler_cfg=%#x l2_mmu_cfg=%#x jm_cfg=%#x coh_feat=%#x coh_en=%#x stack_present=%#x\n",
+	    rd32(mali, GPU_SHADER_CONFIG), rd32(mali, GPU_TILER_CONFIG), rd32(mali, GPU_L2_MMU_CONFIG), rd32(mali, GPU_JM_CONFIG),
+	    rd32(mali, COHERENCY_FEATURES), rd32(mali, COHERENCY_ENABLE), rd32(mali, STACK_PRESENT_LO));
+	printf("BEGONIA MALI DUMP: js%u head=%#llx tail=%#llx aff=%#x cfg=%#x xaff=%#x status=%#x | as0 status=%#x fault=%#x memattr=%#x\n",
+	    slot, (unsigned long long)(rd32(mali, js + JS_HEAD_LO) | ((uint64_t)rd32(mali, js + JS_HEAD_HI) << 32)),
+	    (unsigned long long)tail, rd32(mali, js + JS_AFFINITY_LO), rd32(mali, js + JS_CONFIG), rd32(mali, js + JS_XAFFINITY),
+	    rd32(mali, js + JS_STATUS), rd32(mali, AS0 + AS_STATUS), rd32(mali, AS0 + AS_FAULTSTATUS), rd32(mali, AS0 + AS_MEMATTR_LO));
+	printf("BEGONIA MALI DUMP: mfg global=%#x async=%#x async1=%#x qchannel=%#x | slot done counts %u/%u\n",
+	    rd32(mfgcfg, MFG_GLOBAL_CON), rd32(mfgcfg, MFG_ASYNC_CON), rd32(mfgcfg, MFG_ASYNC_CON_1),
+	    rd32(mfgcfg, MFG_QCHANNEL_CON), g_slot_done[0], g_slot_done[1]);
+	mali_dump_mem("job", jc_va, 16u);
+	if (tail != 0u && tail != jc_va) {
+		mali_dump_mem("tail", tail, 16u);
+	}
+	if (slot == 0u) {
+		/* Bifrost fragment job: 32-byte header, then bounds (2 words), then the framebuffer pointer (flags in [5:0]) */
+		uint32_t w[32];
+		if (mali_peek(jc_va, w, 12u)) {
+			uint64_t fbd = ((uint64_t)w[10] | ((uint64_t)w[11] << 32)) & ~0x3full;
+			mali_dump_mem("fbd", fbd, 32u);
+			mali_dump_mem("fbd+80", fbd + 0x80u, 32u);
+		}
+	}
+}
+
+/* panfrost_gpu_power_on: the L2 first and ready, then the shader cores, then the tiler. */
+static bool
+mali_power_on_cores(void)
+{
+	wr32(mali, L2_PWRON_LO, g_l2_mask);
+	if (!wait_mask(mali, L2_READY_LO, g_l2_mask, g_l2_mask, 50u)) {
+		printf("BEGONIA MALI: L2 power-on timeout (ready=%#x)\n", rd32(mali, L2_READY_LO));
+		return false;
+	}
+	wr32(mali, SHADER_PWRON_LO, g_shader_mask);
+	if (!wait_mask(mali, SHADER_READY_LO, g_shader_mask, g_shader_mask, 50u)) {
+		printf("BEGONIA MALI: shader power-on timeout (ready=%#x)\n", rd32(mali, SHADER_READY_LO));
+		return false;
+	}
+	wr32(mali, TILER_PWRON_LO, g_tiler_mask);
+	if (!wait_mask(mali, TILER_READY_LO, g_tiler_mask, g_tiler_mask, 50u)) {
+		printf("BEGONIA MALI: tiler power-on timeout (ready=%#x)\n", rd32(mali, TILER_READY_LO));
+		return false;
+	}
+	return true;
+}
+
+/*
+ * panfrost_reset for a hung or faulted GPU: cancel what is queued, soft-stop
+ * what runs, soft reset, then quirks, cores and (RESTORE_AS) the AS0 page
+ * table again. The page tables themselves are in memory and survive.
+ */
+static bool
+mali_hw_restart(bool restore_as)
+{
+	g_resets++;
+	for (uint32_t s = 0; s < 16u; s++) {
+		if ((g_js_mask & (1u << s)) != 0u) {
+			wr32(mali, JS_SLOT(s) + JS_COMMAND_NEXT, JS_COMMAND_NOP);
+			wr32(mali, JS_SLOT(s) + JS_COMMAND, JS_COMMAND_SOFT_STOP);
+		}
+	}
+	(void)wait_mask(mali, JOB_INT_JS_STATE, g_js_mask | (g_js_mask << 16), 0u, 10u);
+	bool ok = mali_soft_reset();
+	if (ok) {
+		mali_apply_quirks();
+		ok = mali_power_on_cores();
+	}
+	if (ok && restore_as && begonia_mali_mmu_root_pa() != 0u) {
+		begonia_mali_mmu_as0_set(mali, begonia_mali_mmu_root_pa(), begonia_mali_mmu_transcfg());
+	}
+	return ok;
+}
+
+/*
+ * A job chain that failed (JOB_INT failed bit) or did not end within
+ * MALI_JOB_TIMEOUT_MS. Logged with what the hardware reports, then the GPU is
+ * made able to run the next job:
+ *  - an AS0 page or bus fault: Mali holds the faulting job until the driver
+ *    resolves the fault, which nothing here does; AS0 goes UNMAPPED to end
+ *    it (panfrost_mmu_disable), then the reset below brings AS0 back;
+ *  - no end at all (hang, or the stalled fault above): the reset sequence
+ *    of panfrost_reset;
+ *  - a plain failure (bad descriptor, shader exception): nothing, the slot
+ *    is idle again (panfrost_job_handle_err does not reset G76 either).
+ * Every one counts. Past MALI_LOST_FAULTS, or when a reset fails, the GPU is
+ * LOST: SWEET_MALI_INFO_LOST, no more jobs, and Chlorophyll's watchdog sends
+ * backboardd back to the CPU renderer. Called with mali_mtx held.
+ */
+static void
+mali_job_fault(uint32_t slot, uint64_t jc_va, uint32_t irq)
+{
+	uint32_t js = JS_SLOT(slot);
+	uint32_t js_status = rd32(mali, js + JS_STATUS);
+	uint32_t mmu_irq = rd32(mali, MMU_INT_RAWSTAT);
+	uint32_t as_fault = rd32(mali, AS0 + AS_FAULTSTATUS);
+	uint64_t as_addr = rd32(mali, AS0 + AS_FAULTADDRESS_LO) |
+	    ((uint64_t)rd32(mali, AS0 + AS_FAULTADDRESS_HI) << 32);
+	uint64_t head = rd32(mali, js + JS_HEAD_LO) | ((uint64_t)rd32(mali, js + JS_HEAD_HI) << 32);
+	uint32_t gpu_fault = rd32(mali, GPU_FAULT_STATUS);
+	bool timeout = (irq & (1u << (slot + 16u))) == 0u;
+	bool mmu = (mmu_irq & MMU_IRQ_AS0) != 0u;
+
+	g_faults++;
+	if (g_faults <= 8u || g_exp_adapt || (g_faults % 64u) == 0u) {
+		printf("BEGONIA MALI: job %s: slot=%u jc=%#llx head=%#llx js_status=%#x irq=%#x "
+		    "mmu_irq=%#x as_fault=%#x addr=%#llx gpu_fault=%#x (fault %u, step %u mask %#x)\n",
+		    timeout ? "timeout" : "failed", slot, (unsigned long long)jc_va,
+		    (unsigned long long)head, js_status, irq, mmu_irq, as_fault,
+		    (unsigned long long)as_addr, gpu_fault, g_faults, g_exp_step, g_exp_mask);
+	}
+	if (g_dumps < MALI_DUMP_MAX || (g_exp_adapt && g_exp_step_faults == 0u)) {
+		g_dumps++;
+		mali_dump_hang(slot, jc_va);
+	}
+	if (mmu) {
+		begonia_mali_mmu_as0_disable(mali);
+	}
+	if (g_exp_adapt && ++g_exp_step_faults >= 2u && g_exp_step + 1u < EXP_STEPS) {
+		g_exp_step++;
+		g_exp_step_faults = 0u;
+		g_exp_mask = g_exp_order[g_exp_step];
+		printf("BEGONIA MALI: experiment step %u/%u: mask %#x\n", g_exp_step, EXP_STEPS - 1u, g_exp_mask);
+	}
+	if ((timeout || mmu) && !g_lost) {
+		if (mali_hw_restart(true)) {
+			printf("BEGONIA MALI: GPU reset after the fault (reset %u)\n", g_resets);
+		} else {
+			g_lost = true;
+			printf("BEGONIA MALI: GPU reset failed: reporting the GPU LOST\n");
+		}
+	}
+	if (g_faults > g_lost_faults && !g_lost) {
+		g_lost = true;
+		printf("BEGONIA MALI: %u faults: reporting the GPU LOST\n", g_faults);
+	}
+}
+
+static bool
+run_selftest_job(vm_offset_t kva, uint64_t gpu_va, uint32_t magic, const char *tag)
+{
+	volatile uint32_t *job = (volatile uint32_t *)kva;
+	volatile uint32_t *dst = (volatile uint32_t *)(kva + 0x800u);
+	uint32_t js = JS_SLOT(1);
+
+	bzero((void *)kva, PAGE_SIZE);
+	job[4] = (2u << 1) | 1u | (1u << 16);
+	job[8] = (uint32_t)(gpu_va + 0x800u);
+	job[9] = (uint32_t)((gpu_va + 0x800u) >> 32);
+	job[10] = 6u;
+	job[12] = magic;
+	sweet_dma_sync_va((void *)kva, PAGE_SIZE);
+
+	wr32(mali, JOB_INT_MASK, 0u);
+	wr32(mali, JOB_INT_CLEAR, 0xffffffffu);
+	wr32(mali, js + JS_HEAD_NEXT_LO, (uint32_t)gpu_va);
+	wr32(mali, js + JS_HEAD_NEXT_HI, (uint32_t)(gpu_va >> 32));
+	wr32(mali, js + JS_AFFINITY_NEXT_LO, g_shader_mask);
+	wr32(mali, js + JS_AFFINITY_NEXT_HI, 0u);
+	wr32(mali, js + JS_CONFIG_NEXT, JS_CONFIG_VAL);
+	wr32(mali, js + JS_COMMAND_NEXT, 1u);
+
+	(void)wait_mask(mali, JOB_INT_RAWSTAT, (1u << 1) | (1u << 17), 1u << 1, 100u);
+	sweet_dma_sync_va((void *)kva, PAGE_SIZE);
+	bool ok = (*dst == magic);
+	printf("BEGONIA MALI: selftest (%s) irq=%#x fault=%#x word=%#x (%s)\n",
+	    tag, rd32(mali, JOB_INT_RAWSTAT), rd32(mali, AS0 + AS_FAULTSTATUS),
+	    *dst, ok ? "PASS" : "FAIL");
+	wr32(mali, JOB_INT_CLEAR, 0xffffffffu);
+	return ok;
+}
+
+static void
+begonia_mali_bringup(void)
+{
+	vm_offset_t test_kva = 0;
+
+	topck = ml_io_map(TOPCKGEN_PA, 0x1000u);
+	infra = ml_io_map(INFRACFG_PA, 0x1000u);
+	spm = ml_io_map(SPM_PA, 0x1000u);
+	apmixed = ml_io_map(APMIXED_PA, 0x1000u);
+	mfgcfg = ml_io_map(MFGCFG_PA, 0x1000u);
+	mali = ml_io_map(MALI_PA, 0x10000u);
+	if (!topck || !infra || !spm || !apmixed || !mfgcfg || !mali) {
+		printf("BEGONIA MALI: ml_io_map failed\n");
+		return;
+	}
+	if (!power_pmic_rails()) {
+		printf("BEGONIA MALI: PMIC rail bringup failed\n");
+		return;
+	}
+	setup_clocks();
+	g_stage = 1;
+
+	if ((rd32(spm, SPM_POWERON_CONFIG_EN) & 1u) == 0u) {
+		wr32(spm, SPM_POWERON_CONFIG_EN, (SPM_PROJECT_CODE << 16) | 1u);
+	}
+	if (!mtcmos_on(0x328u, 1u << 4, 0u, 0u, false) ||
+	    !mtcmos_on(0x32cu, 1u << 7, 0u, 0u, true) ||
+	    !mtcmos_on(0x330u, 1u << 20, 1u << 8, 1u << 12, false) ||
+	    !mtcmos_on(0x334u, 1u << 22, 1u << 8, 1u << 12, false) ||
+	    !mtcmos_on(0x338u, 1u << 23, 1u << 8, 1u << 12, false) ||
+	    !mtcmos_on(0x350u, 1u << 13, 1u << 8, 1u << 12, false)) {
+		printf("BEGONIA MALI: MFG MTCMOS failed\n");
+		return;
+	}
+	wr32(mfgcfg, MFG_CG_CLR, 1u);
+	wr32(mfgcfg, MFG_GLOBAL_CON, rd32(mfgcfg, MFG_GLOBAL_CON) & ~((1u << 8) | (1u << 10)));
+	wr32(mfgcfg, MFG_ASYNC_CON, rd32(mfgcfg, MFG_ASYNC_CON) | (1u << 23) | (1u << 25));
+	wr32(mfgcfg, MFG_ASYNC_CON_1, rd32(mfgcfg, MFG_ASYNC_CON_1) | 1u);
+	wr32(mfgcfg, MFG_TIMESTAMP_EN, 1u);
+	delay(10);
+	g_stage = 2;
+
+	g_gpu_id = rd32(mali, GPU_ID);
+	if (g_gpu_id == 0u || g_gpu_id == 0xffffffffu) {
+		printf("BEGONIA MALI: bad GPU_ID=%#x\n", g_gpu_id);
+		return;
+	}
+	if (!mali_soft_reset()) {
+		return;
+	}
+
+	g_l2_mask = rd32(mali, L2_PRESENT_LO);
+	g_tiler_mask = rd32(mali, TILER_PRESENT_LO);
+	g_shader_mask = rd32(mali, SHADER_PRESENT_LO);
+	g_js_mask = rd32(mali, GPU_JS_PRESENT) & 0xffffu;
+	g_va_bits = rd32(mali, GPU_MMU_FEATURES) & 0xffu;
+	if (g_va_bits < 33u || g_va_bits > 48u) {
+		g_va_bits = 48u;
+	}
+	begonia_mali_mmu_init(mali, g_va_bits);
+
+	mali_apply_quirks();
+	if (!mali_power_on_cores()) {
+		printf("BEGONIA MALI: core power-on timeout\n");
+		return;
+	}
+	g_stage = 3;
+	printf("BEGONIA MALI: GPU_ID=%#x (%u MHz) shaders=%#x tiler=%#x l2=%#x va=%u\n",
+	    g_gpu_id, g_freq_khz / 1000u, g_shader_mask, g_tiler_mask, g_l2_mask, g_va_bits);
+
+	if (kmem_alloc_contig(kernel_map, &test_kva, PAGE_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return;
+	}
+	ppnum_t test_pn = pmap_find_phys(kernel_pmap, (addr64_t)test_kva);
+	uint64_t test_pa = ptoa_64(test_pn);
+	begonia_mali_mmu_as0_set(mali, 0ull, 2u);
+	if (!run_selftest_job(test_kva, test_pa, 0xc0ffee01u, "identity")) {
+		/*
+		 * Identity translation is a debug mode that neither Linux panfrost nor
+		 * kbase ever uses: its failure says nothing about the page-table path
+		 * real jobs take. Reset whatever the test left running and go on.
+		 */
+		printf("BEGONIA MALI: identity selftest failed; trying the page-table path anyway\n");
+		if (!mali_hw_restart(false)) {
+			printf("BEGONIA MALI: reset after the identity selftest failed (test page kept)\n");
+			return;
+		}
+	}
+	g_stage = 4;
+
+	bool mapped = begonia_mali_map_page(0x00100000ull, test_pa, false);
+	if (mapped) {
+		begonia_mali_mmu_as0_set(mali, begonia_mali_mmu_root_pa(), begonia_mali_mmu_transcfg());
+		mapped = run_selftest_job(test_kva, 0x00100000ull, 0xc0ffee02u, "page-table");
+		begonia_mali_unmap_range(0x00100000ull, 4096ull);
+	}
+	if (!mapped) {
+		/* a test job may still be running: stop the GPU before its page goes back to the VM */
+		if (!mali_hw_restart(true)) {
+			printf("BEGONIA MALI: GPU reset failed after the selftest (test page kept)\n");
+			return;
+		}
+		kmem_free(kernel_map, test_kva, PAGE_SIZE);
+		return;
+	}
+	kmem_free(kernel_map, test_kva, PAGE_SIZE);
+	g_stage = 5;
+	g_ready = true;
+	SweetMaliPublish();
+	g_stage = 6;
+}
+
+static void
+begonia_mali_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	begonia_mali_bringup();
+	printf("BEGONIA MALI: bring-up done: stage %u/6, %s\n", g_stage, g_ready ? "GPU ready" : "no GPU");
+	/* returning ends the thread (Call_continuation -> thread_terminate) */
+}
+
+void
+begonia_mali_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+
+	if (g_started || !sweet_board_begonia()) {
+		return;
+	}
+	g_started = true;
+	(void)PE_parse_boot_argn("begoniamali", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("BEGONIA MALI: disabled (begoniamali=0)\n");
+		return;
+	}
+	(void)PE_parse_boot_argn("begoniamalix", &g_exp_mask, sizeof(g_exp_mask));
+	(void)PE_parse_boot_argn("begoniamaliadapt", &g_exp_adapt, sizeof(g_exp_adapt));
+	(void)PE_parse_boot_argn("begoniamalito", &g_job_timeout_ms, sizeof(g_job_timeout_ms));
+	(void)PE_parse_boot_argn("begoniamalimhz", &g_req_mhz, sizeof(g_req_mhz));
+	if (g_job_timeout_ms < 100u || g_job_timeout_ms > 10000u) {
+		g_job_timeout_ms = MALI_JOB_TIMEOUT_MS;
+	}
+	if (g_req_mhz != 0u && (g_req_mhz < 375u || g_req_mhz > 620u)) {
+		printf("BEGONIA MALI: begoniamalimhz=%u outside 375..620, clock left as LK set it\n", g_req_mhz);
+		g_req_mhz = 0u;
+	}
+	g_exp_mask &= EXP_ALL;
+	if (g_exp_adapt) {
+		g_exp_mask = 0u;
+		g_lost_faults = 96u;
+	}
+	if (g_exp_mask || g_exp_adapt || g_req_mhz || g_job_timeout_ms != MALI_JOB_TIMEOUT_MS) {
+		printf("BEGONIA MALI: experiments: mask %#x, adapt %u (LOST after %u faults), job timeout %u ms, clock %u MHz\n",
+		    g_exp_mask, g_exp_adapt, g_lost_faults, g_job_timeout_ms, g_req_mhz);
+	}
+	/*
+	 * In its own kernel thread: begonia_platform_hw_init() runs inside
+	 * IOFindBSDRoot, and a GPU that never answers (MFG power, PLL, a stalled
+	 * register read) must not keep the root from being mounted. Users of the
+	 * GPU wait for the SweetMali service / begonia_mali_ready().
+	 */
+	if (kernel_thread_start(begonia_mali_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		printf("BEGONIA MALI: bring-up started in a kernel thread\n");
+	} else {
+		printf("BEGONIA MALI: kernel_thread_start failed, bringing the GPU up inline\n");
+		begonia_mali_bringup();
+	}
+}
+
+bool begonia_mali_ready(void) { return g_ready; }
+bool begonia_mali_lost(void) { return g_lost || g_faults > g_lost_faults; }
+uint32_t begonia_mali_gpu_id(void) { return g_gpu_id; }
+uint32_t begonia_mali_va_bits(void) { return g_va_bits; }
+uint64_t begonia_mali_last_seq(void) { return g_done_seq; }
+uint32_t begonia_mali_faults(void) { return g_faults; }
+
+bool
+begonia_mali_param(uint32_t which, uint64_t *value)
+{
+	if (!g_ready || value == NULL) {
+		return false;
+	}
+	if (which >= 18u && which <= 21u) {
+		*value = rd32(mali, GPU_TEX_FEATURES(which - 18u));
+		return true;
+	}
+	if (which >= 22u && which <= 37u) {
+		*value = rd32(mali, GPU_JS_FEATURES(which - 22u));
+		return true;
+	}
+	static const uint16_t reg_map[18] = {
+		0, 0, 0, 0, 0, STACK_PRESENT_LO, GPU_AS_PRESENT, GPU_JS_PRESENT,
+		GPU_L2_FEATURES, GPU_CORE_FEATURES, GPU_TILER_FEATURES, GPU_MEM_FEATURES,
+		GPU_MMU_FEATURES, GPU_THREAD_FEATURES, GPU_THREAD_MAX_THREADS,
+		GPU_THREAD_MAX_WG_SIZE, GPU_THREAD_MAX_BARRIER, COHERENCY_FEATURES,
+	};
+	if (which == 0u) { *value = g_gpu_id >> 16; return true; }
+	if (which == 1u) { *value = g_gpu_id & 0xffffu; return true; }
+	if (which == 2u) { *value = g_shader_mask; return true; }
+	if (which == 3u) { *value = g_tiler_mask; return true; }
+	if (which == 4u) { *value = g_l2_mask; return true; }
+	if (which < 18u) { *value = rd32(mali, reg_map[which]); return true; }
+	if (which == 38u) { *value = 1u; return true; }
+	if (which == 39u) { *value = rd32(mali, GPU_THREAD_TLS_ALLOC); return true; }
+	if (which == 40u) { *value = rd32(mali, GPU_AFBC_FEATURES); return true; }
+	if (which == 41u) { uint64_t t; __asm__ volatile("mrs %0, cntvct_el0" : "=r"(t)); *value = t; return true; }
+	if (which == 42u) { uint64_t f; __asm__ volatile("mrs %0, cntfrq_el0" : "=r"(f)); *value = f; return true; }
+	return false;
+}
+
+uint64_t
+begonia_mali_submit(uint64_t jc_va, bool fragment)
+{
+	uint32_t slot = fragment ? 0u : 1u;
+	uint32_t js = JS_SLOT(slot);
+	uint32_t done = 1u << slot;
+	uint32_t irqm = done | (1u << (slot + 16u));
+	uint32_t irq = 0u;
+	uint64_t seq;
+
+	if (!g_ready || jc_va == 0u) {
+		return 0u;
+	}
+	lck_mtx_lock(&mali_mtx);
+	if (g_lost) {
+		lck_mtx_unlock(&mali_mtx);
+		return 0u;
+	}
+	g_submits++;
+	seq = ++g_seq;
+	wr32(mali, JOB_INT_CLEAR, irqm);
+	if (!wait_mask(mali, js + JS_COMMAND_NEXT, 0xffu, 0u, 50u)) {
+		printf("BEGONIA MALI: slot %u still busy (JS_STATE=%#x): resetting\n", slot, rd32(mali, JOB_INT_JS_STATE));
+		if (!mali_hw_restart(true)) {
+			g_lost = true;
+			printf("BEGONIA MALI: GPU reset failed: reporting the GPU LOST\n");
+			lck_mtx_unlock(&mali_mtx);
+			return 0u;
+		}
+	}
+	uint32_t affinity = (g_exp_mask & EXP_ONE_CORE) ? (g_shader_mask & (~g_shader_mask + 1u)) : g_shader_mask;
+	uint32_t cfg = JS_CONFIG_VAL;
+	if (g_exp_mask & EXP_CHAIN_FLAG) {
+		if (g_chain_flag[slot]) {
+			cfg |= JS_CONFIG_JOB_CHAIN_FLAG;
+		}
+		g_chain_flag[slot] = !g_chain_flag[slot];
+	}
+	wr32(mali, js + JS_HEAD_NEXT_LO, (uint32_t)jc_va);
+	wr32(mali, js + JS_HEAD_NEXT_HI, (uint32_t)(jc_va >> 32));
+	wr32(mali, js + JS_AFFINITY_NEXT_LO, affinity);
+	wr32(mali, js + JS_AFFINITY_NEXT_HI, 0u);
+	wr32(mali, js + JS_CONFIG_NEXT, cfg);
+	uint64_t t_start = mach_absolute_time();
+	wr32(mali, js + JS_COMMAND_NEXT, JS_COMMAND_START);
+
+	/* done or failed, whichever comes first: a failed chain used to cost the whole timeout */
+	uint32_t timeout_ms = (g_exp_mask & EXP_LONG_TIMEOUT) ? MALI_LONG_TIMEOUT_MS : g_job_timeout_ms;
+	for (uint32_t us = 0; us < timeout_ms * 1000u; us += 10u) {
+		irq = rd32(mali, JOB_INT_RAWSTAT) & irqm;
+		if (irq != 0u) {
+			break;
+		}
+		delay(10);
+	}
+	if (irq == 0u) {
+		irq = rd32(mali, JOB_INT_RAWSTAT) & irqm;
+	}
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t_start, &ns);
+	uint32_t ms = (uint32_t)(ns / 1000000ull);
+	if (irq != done) {
+		mali_job_fault(slot, jc_va, irq);
+	} else {
+		if (slot == 0u && g_frag_dumps < 6u) {
+			g_frag_dumps++;
+			mali_dump_frag(jc_va);
+		}
+		if (slot == 1u && g_vtx_dumps < 8u) {
+			mali_dump_vertex_chain(jc_va);
+		}
+		if (g_slot_done[slot]++ == 0u) {
+			printf("BEGONIA MALI: first slot %u job done in %u ms (jc %#llx, %u faults so far, step %u mask %#x)\n",
+			    slot, ms, (unsigned long long)jc_va, g_faults, g_exp_step, g_exp_mask);
+		}
+		if (ms > g_slot_max_ms[slot] && ms >= 50u) {
+			g_slot_max_ms[slot] = ms;
+			printf("BEGONIA MALI: slot %u job took %u ms (new max, job %u on the slot)\n", slot, ms, g_slot_done[slot]);
+		}
+		if (slot == 0u && g_exp_adapt && g_exp_done_logged != g_exp_step) {
+			g_exp_done_logged = g_exp_step;
+			printf("BEGONIA MALI: experiment step %u (mask %#x): fragment job DONE (jc %#llx)\n",
+			    g_exp_step, g_exp_mask, (unsigned long long)jc_va);
+		}
+	}
+	wr32(mali, JOB_INT_CLEAR, irqm);
+	g_done_seq = seq;
+	lck_mtx_unlock(&mali_mtx);
+	return seq;
+}
+
+bool
+begonia_mali_wait(uint64_t seq, __unused uint64_t timeout_ns)
+{
+	return seq <= g_done_seq;
+}
+
+void
+begonia_mali_note_client(int delta)
+{
+	if (delta > 0) {
+		(void)__atomic_add_fetch(&g_clients, 1u, __ATOMIC_RELAXED);
+	} else if (delta < 0) {
+		uint32_t cur = __atomic_load_n(&g_clients, __ATOMIC_RELAXED);
+		if (cur > 0u) {
+			(void)__atomic_sub_fetch(&g_clients, 1u, __ATOMIC_RELAXED);
+		}
+	}
+}
+
+void
+begonia_mali_note_buffer(__unused uint64_t addr, __unused uint64_t size)
+{
+	(void)__atomic_add_fetch(&g_buffers, 1u, __ATOMIC_RELAXED);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/begonia_mali_mmu.c b/bsd/dev/begonia_mali_mmu.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/begonia_mali_mmu.c
@@ -0,0 +1,460 @@
+/*
+ * Mali-G76 AArch64 Stage-1 4K GPU MMU & VA allocator for begonia (MT6785).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <libkern/libkern.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <machine/machine_routines.h>
+#include <mach/vm_param.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <vm/vm_kern_xnu.h>
+#include "sweet_board.h"
+#include "begonia_drivers.h"
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+
+#define AS0                     0x2400u
+#define AS_TRANSTAB_LO          0x00u
+#define AS_TRANSTAB_HI          0x04u
+#define AS_MEMATTR_LO           0x08u
+#define AS_MEMATTR_HI           0x0cu
+#define AS_LOCKADDR_LO          0x10u
+#define AS_LOCKADDR_HI          0x14u
+#define AS_COMMAND              0x18u
+#define AS_STATUS               0x28u
+#define AS_TRANSCFG_LO          0x30u
+#define AS_TRANSCFG_HI          0x34u
+
+/* AS_COMMAND values (Linux drivers/gpu/drm/panfrost/panfrost_regs.h) */
+#define AS_COMMAND_UPDATE       0x01u
+#define AS_COMMAND_LOCK         0x02u
+#define AS_COMMAND_FLUSH_PT     0x04u
+#define AS_COMMAND_FLUSH_MEM    0x05u
+#define AS_TRANSCFG_UNMAPPED    0x01u
+/* the smallest region AS_LOCKADDR can name: 32 KiB (log2 15) */
+#define AS_LOCK_REGION_MIN_LOG2 15u
+/* every GPU VA this allocator hands out is below 4 GiB */
+#define MALI_VA_SPAN            (1ull << 32)
+
+#define PTE_TABLE               3ull
+#define PTE_PAGE                3ull
+#define PTE_AF                  (1ull << 10)
+#define PTE_SH_INNER            (3ull << 8)
+#define PTE_AP_RW               (1ull << 6)
+#define PTE_AP_RO               (3ull << 6)
+#define PTE_ADDR_MASK           0x0000fffffffff000ull
+
+#define MALI_VA_BASE            0x10000000ull
+#define MALI_VA_LIMIT           0xf0000000ull
+#define MALI_FREE_SLOTS         256u
+#define PT_HASH_BUCKETS         1024u
+
+struct pt_rec {
+	uint64_t pa;
+	uint64_t *va;
+	struct pt_rec *next;
+};
+
+struct va_free_slot {
+	uint64_t addr;
+	uint64_t size;
+};
+
+static LCK_GRP_DECLARE(mali_mmu_grp, "begonia-mali-mmu");
+static LCK_MTX_DECLARE(mali_mmu_mtx, &mali_mmu_grp);
+
+static vm_offset_t g_mali_regs;
+static uint32_t g_mmu_va_bits = 48u;
+static vm_offset_t g_pt_slab_va, g_meta_slab_va;
+static uint64_t g_pt_slab_pa, g_pt_root_pa, *g_pt_root_va;
+static uint32_t g_pt_slab_off = PAGE_SIZE, g_meta_slab_off = PAGE_SIZE;
+static struct pt_rec *g_pt_hash[PT_HASH_BUCKETS];
+static uint64_t g_va_cursor = MALI_VA_BASE;
+static struct va_free_slot g_va_free[MALI_FREE_SLOTS];
+/* AS0 MEMATTR: 0x88 = write-back, Midgard-inner shareability, implementation-defined allocation (kbase default) */
+static uint32_t g_memattr_lo = 0x88888888u, g_memattr_hi = 0x88888888u;
+
+static inline uint32_t
+mmu_rd(uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(g_mali_regs + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+mmu_wr(uint32_t off, uint32_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(g_mali_regs + off) = v;
+}
+
+static bool
+mmu_wait_idle(void)
+{
+	for (uint32_t us = 0; us < 50000u; us += 10u) {
+		if ((mmu_rd(AS0 + AS_STATUS) & 1u) == 0u) {
+			return true;
+		}
+		delay(10);
+	}
+	return (mmu_rd(AS0 + AS_STATUS) & 1u) == 0u;
+}
+
+/*
+ * One MMU operation on AS0 for [start, start + size), as Linux panfrost does it
+ * (mmu_hw_do_operation_locked + lock_region): the region is locked first (a
+ * naturally aligned power of two, encoded as log2(size) - 1 in AS_LOCKADDR),
+ * then OP runs on it (FLUSH_PT / FLUSH_MEM: flush the GPU L2, then drop the
+ * TLB entries of the locked region and unlock it). The old bare UNLOCK (3)
+ * never programmed AS_LOCKADDR, so it flushed whatever region the register
+ * happened to name: stale translations of an unmapped and reused GPU VA could
+ * survive, and the GPU would keep reading and writing the freed pages.
+ */
+static bool
+mmu_lock_op(uint64_t start, uint64_t size, uint32_t op)
+{
+	uint64_t end = start + size;
+	uint64_t diff = start ^ (end - 1u);
+	uint32_t width = (diff != 0u) ? (64u - (uint32_t)__builtin_clzll(diff)) : 0u;
+
+	if (size == 0u) {
+		return true;
+	}
+	if (width < AS_LOCK_REGION_MIN_LOG2) {
+		width = AS_LOCK_REGION_MIN_LOG2;
+	}
+	width -= 1u;
+	uint64_t region = (start & ~((1ull << width) - 1u)) | width;
+
+	bool ok = mmu_wait_idle();
+	mmu_wr(AS0 + AS_LOCKADDR_LO, (uint32_t)region);
+	mmu_wr(AS0 + AS_LOCKADDR_HI, (uint32_t)(region >> 32));
+	mmu_wr(AS0 + AS_COMMAND, AS_COMMAND_LOCK);
+	ok = mmu_wait_idle() && ok;
+	mmu_wr(AS0 + AS_COMMAND, op);
+	ok = mmu_wait_idle() && ok;
+	return ok;
+}
+
+static void *
+meta_alloc(size_t sz)
+{
+	sz = (sz + 7u) & ~7u;
+	if (g_meta_slab_off + sz > PAGE_SIZE) {
+		vm_offset_t pg = 0;
+		if (kmem_alloc_contig(kernel_map, &pg, PAGE_SIZE, PAGE_MASK, 0, 0,
+		    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			return NULL;
+		}
+		g_meta_slab_va = pg;
+		g_meta_slab_off = 0;
+	}
+	void *p = (void *)(g_meta_slab_va + g_meta_slab_off);
+	g_meta_slab_off += (uint32_t)sz;
+	return p;
+}
+
+static uint64_t *
+pt_alloc_4k(uint64_t *pa_out)
+{
+	if (g_pt_slab_off + 4096u > PAGE_SIZE) {
+		vm_offset_t pg = 0;
+		if (kmem_alloc_contig(kernel_map, &pg, PAGE_SIZE, PAGE_MASK, 0, 0,
+		    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			return NULL;
+		}
+		ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)pg);
+		if (pn == 0) {
+			return NULL;
+		}
+		g_pt_slab_va = pg;
+		g_pt_slab_pa = ptoa_64(pn);
+		g_pt_slab_off = 0;
+	}
+	uint64_t *va = (uint64_t *)(g_pt_slab_va + g_pt_slab_off);
+	uint64_t pa = g_pt_slab_pa + g_pt_slab_off;
+	struct pt_rec *r = (struct pt_rec *)meta_alloc(sizeof(*r));
+	if (r == NULL) {
+		return NULL;
+	}
+	g_pt_slab_off += 4096u;
+	sweet_dma_sync_va(va, 4096u);
+	r->pa = pa;
+	r->va = va;
+	uint32_t b = (uint32_t)((pa >> 12) % PT_HASH_BUCKETS);
+	r->next = g_pt_hash[b];
+	g_pt_hash[b] = r;
+	*pa_out = pa;
+	return va;
+}
+
+static uint64_t *
+pt_find_va(uint64_t pa)
+{
+	pa &= PTE_ADDR_MASK;
+	for (struct pt_rec *r = g_pt_hash[(pa >> 12) % PT_HASH_BUCKETS]; r != NULL; r = r->next) {
+		if (r->pa == pa) {
+			return r->va;
+		}
+	}
+	return NULL;
+}
+
+static uint64_t *
+pt_walk_next(uint64_t *entry)
+{
+	uint64_t phys = 0;
+	uint64_t *child;
+
+	if (*entry & 1ull) {
+		return pt_find_va(*entry);
+	}
+	child = pt_alloc_4k(&phys);
+	if (child == NULL) {
+		return NULL;
+	}
+	*entry = phys | PTE_TABLE;
+	sweet_dma_sync_va(entry, sizeof(*entry));
+	return child;
+}
+
+void
+begonia_mali_mmu_init(vm_offset_t mali_regs, uint32_t va_bits)
+{
+	g_mali_regs = mali_regs;
+	g_mmu_va_bits = va_bits;
+}
+
+uint64_t begonia_mali_mmu_root_pa(void) { return g_pt_root_pa; }
+
+uint32_t
+begonia_mali_mmu_transcfg(void)
+{
+	uint32_t ina = (g_mmu_va_bits <= 55u) ? (55u - g_mmu_va_bits) : 7u;
+	return 6u | (ina << 6) | (1u << 24);
+}
+
+void
+begonia_mali_mmu_as0_set(vm_offset_t mali_regs, uint64_t transtab, uint32_t transcfg)
+{
+	lck_mtx_lock(&mali_mmu_mtx);
+	g_mali_regs = mali_regs;
+	/* panfrost_mmu_enable: flush what the old configuration may still cache before switching */
+	(void)mmu_lock_op(0u, ~0ull, AS_COMMAND_FLUSH_MEM);
+	mmu_wr(AS0 + AS_TRANSTAB_LO, (uint32_t)transtab);
+	mmu_wr(AS0 + AS_TRANSTAB_HI, (uint32_t)(transtab >> 32));
+	mmu_wr(AS0 + AS_TRANSCFG_LO, transcfg);
+	mmu_wr(AS0 + AS_TRANSCFG_HI, 0u);
+	mmu_wr(AS0 + AS_MEMATTR_LO, g_memattr_lo);
+	mmu_wr(AS0 + AS_MEMATTR_HI, g_memattr_hi);
+	mmu_wr(AS0 + AS_COMMAND, AS_COMMAND_UPDATE);
+	mmu_wait_idle();
+	lck_mtx_unlock(&mali_mmu_mtx);
+}
+
+/* 20 Nov 2026 bring-up experiments: the AS0 MEMATTR the next begonia_mali_mmu_as0_set() programs. */
+void
+begonia_mali_mmu_set_memattr(uint32_t lo, uint32_t hi)
+{
+	g_memattr_lo = lo;
+	g_memattr_hi = hi;
+}
+
+/* GPU VA -> PA through the AS0 tables (no allocation), for hang dumps. */
+bool
+begonia_mali_mmu_lookup(uint64_t gpu_va, uint64_t *pa)
+{
+	bool ok = false;
+
+	lck_mtx_lock(&mali_mmu_mtx);
+	uint64_t *tbl = g_pt_root_va;
+	if (tbl != NULL && g_mmu_va_bits > 39u) {
+		uint64_t e0 = tbl[(gpu_va >> 39) & 0x1ffu];
+		tbl = (e0 & 1ull) ? pt_find_va(e0) : NULL;
+	}
+	if (tbl != NULL) {
+		uint64_t e1 = tbl[(gpu_va >> 30) & 0x1ffu];
+		tbl = (e1 & 1ull) ? pt_find_va(e1) : NULL;
+	}
+	if (tbl != NULL) {
+		uint64_t e2 = tbl[(gpu_va >> 21) & 0x1ffu];
+		tbl = (e2 & 1ull) ? pt_find_va(e2) : NULL;
+	}
+	if (tbl != NULL) {
+		uint64_t e3 = tbl[(gpu_va >> 12) & 0x1ffu];
+		if ((e3 & 3ull) == PTE_PAGE) {
+			*pa = (e3 & PTE_ADDR_MASK) | (gpu_va & 0xfffull);
+			ok = true;
+		}
+	}
+	lck_mtx_unlock(&mali_mmu_mtx);
+	return ok;
+}
+
+/*
+ * panfrost_mmu_disable: AS0 to UNMAPPED. Every access through it then faults,
+ * which ends a job that is stalled on a page fault (Mali holds the faulting
+ * access until the driver resolves it; nothing here ever would).
+ */
+void
+begonia_mali_mmu_as0_disable(vm_offset_t mali_regs)
+{
+	lck_mtx_lock(&mali_mmu_mtx);
+	g_mali_regs = mali_regs;
+	(void)mmu_lock_op(0u, ~0ull, AS_COMMAND_FLUSH_MEM);
+	mmu_wr(AS0 + AS_TRANSTAB_LO, 0u);
+	mmu_wr(AS0 + AS_TRANSTAB_HI, 0u);
+	mmu_wr(AS0 + AS_MEMATTR_LO, 0u);
+	mmu_wr(AS0 + AS_MEMATTR_HI, 0u);
+	mmu_wr(AS0 + AS_TRANSCFG_LO, AS_TRANSCFG_UNMAPPED);
+	mmu_wr(AS0 + AS_TRANSCFG_HI, 0u);
+	mmu_wr(AS0 + AS_COMMAND, AS_COMMAND_UPDATE);
+	mmu_wait_idle();
+	lck_mtx_unlock(&mali_mmu_mtx);
+}
+
+/* After page-table edits: flush the GPU L2 and the TLB of every VA this allocator can hand out. */
+void
+begonia_mali_mmu_flush_unlocked(__unused vm_offset_t mali_regs)
+{
+	if (g_mali_regs == 0u) {
+		return;
+	}
+	if (!mmu_lock_op(0u, MALI_VA_SPAN, AS_COMMAND_FLUSH_PT)) {
+		printf("BEGONIA MALI: MMU flush timed out (AS0 status %#x)\n", mmu_rd(AS0 + AS_STATUS));
+	}
+}
+
+bool
+begonia_mali_mmu_map_unlocked(uint64_t gpu_va, uint64_t phys, bool readonly)
+{
+	uint64_t *tbl = g_pt_root_va;
+
+	if (tbl == NULL) {
+		g_pt_root_va = pt_alloc_4k(&g_pt_root_pa);
+		tbl = g_pt_root_va;
+		if (tbl == NULL) {
+			return false;
+		}
+	}
+	if (g_mmu_va_bits > 39u) {
+		if ((tbl = pt_walk_next(&tbl[(gpu_va >> 39) & 0x1ffu])) == NULL) {
+			return false;
+		}
+	}
+	if ((tbl = pt_walk_next(&tbl[(gpu_va >> 30) & 0x1ffu])) == NULL ||
+	    (tbl = pt_walk_next(&tbl[(gpu_va >> 21) & 0x1ffu])) == NULL) {
+		return false;
+	}
+	uint64_t *leaf = &tbl[(gpu_va >> 12) & 0x1ffu];
+	*leaf = (phys & PTE_ADDR_MASK) | PTE_AF | PTE_SH_INNER |
+	    (readonly ? PTE_AP_RO : PTE_AP_RW) | PTE_PAGE;
+	sweet_dma_sync_va(leaf, sizeof(*leaf));
+	return true;
+}
+
+void
+begonia_mali_mmu_unmap_unlocked(uint64_t gpu_va, uint64_t size)
+{
+	for (uint64_t off = 0; off < size; off += 4096ull) {
+		uint64_t va = gpu_va + off;
+		uint64_t *tbl = g_pt_root_va;
+		if (tbl == NULL) {
+			break;
+		}
+		if (g_mmu_va_bits > 39u) {
+			uint64_t e0 = tbl[(va >> 39) & 0x1ffu];
+			if ((e0 & 1ull) == 0u || (tbl = pt_find_va(e0)) == NULL) {
+				continue;
+			}
+		}
+		uint64_t e1 = tbl[(va >> 30) & 0x1ffu];
+		if ((e1 & 1ull) == 0u || (tbl = pt_find_va(e1)) == NULL) {
+			continue;
+		}
+		uint64_t e2 = tbl[(va >> 21) & 0x1ffu];
+		if ((e2 & 1ull) == 0u || (tbl = pt_find_va(e2)) == NULL) {
+			continue;
+		}
+		uint64_t *leaf = &tbl[(va >> 12) & 0x1ffu];
+		*leaf = 0;
+		sweet_dma_sync_va(leaf, sizeof(*leaf));
+	}
+}
+
+uint64_t
+begonia_mali_va_alloc(uint64_t size)
+{
+	uint64_t addr = 0;
+
+	size = (size + 4095ull) & ~4095ull;
+	if (size == 0u) {
+		return 0u;
+	}
+	lck_mtx_lock(&mali_mmu_mtx);
+	for (uint32_t i = 0; i < MALI_FREE_SLOTS; i++) {
+		if (g_va_free[i].size >= size) {
+			addr = g_va_free[i].addr;
+			g_va_free[i].addr += size;
+			g_va_free[i].size -= size;
+			break;
+		}
+	}
+	if (addr == 0u && g_va_cursor + size <= MALI_VA_LIMIT) {
+		addr = g_va_cursor;
+		g_va_cursor += size;
+	}
+	lck_mtx_unlock(&mali_mmu_mtx);
+	return addr;
+}
+
+void
+begonia_mali_va_free(uint64_t gpu_va, uint64_t size)
+{
+	size = (size + 4095ull) & ~4095ull;
+	if (gpu_va == 0u || size == 0u) {
+		return;
+	}
+	lck_mtx_lock(&mali_mmu_mtx);
+	for (uint32_t i = 0; i < MALI_FREE_SLOTS; i++) {
+		if (g_va_free[i].size == 0u) {
+			g_va_free[i].addr = gpu_va;
+			g_va_free[i].size = size;
+			break;
+		}
+	}
+	lck_mtx_unlock(&mali_mmu_mtx);
+}
+
+bool
+begonia_mali_map_page(uint64_t gpu_va, uint64_t phys, bool readonly)
+{
+	bool ok;
+	lck_mtx_lock(&mali_mmu_mtx);
+	ok = begonia_mali_mmu_map_unlocked(gpu_va, phys, readonly);
+	lck_mtx_unlock(&mali_mmu_mtx);
+	return ok;
+}
+
+void
+begonia_mali_unmap_range(uint64_t gpu_va, uint64_t size)
+{
+	lck_mtx_lock(&mali_mmu_mtx);
+	begonia_mali_mmu_unmap_unlocked(gpu_va, size);
+	begonia_mali_mmu_flush_unlocked(g_mali_regs);
+	lck_mtx_unlock(&mali_mmu_mtx);
+}
+
+void
+begonia_mali_mmu_flush(void)
+{
+	lck_mtx_lock(&mali_mmu_mtx);
+	begonia_mali_mmu_flush_unlocked(g_mali_regs);
+	lck_mtx_unlock(&mali_mmu_mtx);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/begonia_touch.c b/bsd/dev/begonia_touch.c
new file mode 100644
index 0000000..f02abae
--- /dev/null
+++ b/bsd/dev/begonia_touch.c
@@ -0,0 +1,393 @@
+/*
+ * Polled MT6785 SPI5 + Novatek NT36672A touchscreen driver for Redmi Note 8 Pro (begonia).
+ * Ports proven mtkloader SPI5 (0x11019000) + NVT (0x21C00) protocol to XNU HID events.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <libkern/libkern.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include "sweet_board.h"
+#include "begonia_drivers.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+
+#define BEGONIA_TOPCKGEN_PA     0x10000000u
+#define BEGONIA_INFRACFG_PA     0x10001000u
+#define BEGONIA_GPIO_PA         0x10005000u
+#define BEGONIA_SPI5_PA         0x11019000u
+
+#define TOPCK_CLK_CFG_UPDATE    0x0004u
+#define TOPCK_CLK_CFG_5_CLR     0x0078u
+#define INFRA_SW_CG2_CLR        0x00a8u
+#define INFRA_CG2_SPI5_BIT      (1u << 26)
+
+#define SPI_CFG0_REG            0x0000u
+#define SPI_CFG1_REG            0x0004u
+#define SPI_TX_DATA_REG         0x0010u
+#define SPI_RX_DATA_REG         0x0014u
+#define SPI_CMD_REG             0x0018u
+#define SPI_STATUS0_REG         0x001cu
+#define SPI_PAD_SEL_REG         0x0024u
+#define SPI_CFG2_REG            0x0028u
+
+#define SPI_CMD_ACT             (1u << 0)
+#define SPI_CMD_RESUME          (1u << 1)
+#define SPI_CMD_RST             (1u << 2)
+#define SPI_CMD_PAUSE_EN        (1u << 4)
+#define SPI_CMD_TXMSBF          (1u << 12)
+#define SPI_CMD_RXMSBF          (1u << 13)
+#define SPI_CMD_FINISH_IE       (1u << 16)
+#define SPI_CMD_PAUSE_IE        (1u << 17)
+#define SPI_FIFO_BYTES          32u
+
+#define NVT_EVENT_BUF_ADDR      0x21c00u
+#define NVT_EVENT_FWINFO        0x78u
+#define NVT_EVENT_PROJECTID     0x9au
+#define NVT_MAX_SLOTS           10u
+#define NVT_EMPTY_RELEASE       3u
+#define PANEL_W                 1080u
+#define PANEL_H                 2340u
+
+static vm_offset_t topck_base, infra_base, gpio_base, spi5_base;
+static bool touch_started;
+static int touch_chan;
+static uint32_t touch_poll_ms = 8;
+static int touch_log;
+
+static inline uint32_t
+reg_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+reg_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+}
+
+static void
+gpio_set_mode(uint32_t pin, uint32_t mode)
+{
+	uint32_t off = 0x0300u + (pin / 8u) * 0x10u;
+	uint32_t shift = (pin % 8u) * 4u;
+	uint32_t v = reg_rd(gpio_base, off);
+	v = (v & ~(0xfu << shift)) | ((mode & 0xfu) << shift);
+	reg_wr(gpio_base, off, v);
+}
+
+static void
+gpio_set_dir(uint32_t pin, bool out)
+{
+	uint32_t off = (pin / 32u) * 0x10u;
+	uint32_t bit = 1u << (pin % 32u);
+	uint32_t v = reg_rd(gpio_base, off);
+	reg_wr(gpio_base, off, out ? (v | bit) : (v & ~bit));
+}
+
+static void
+gpio_set_dout(uint32_t pin, bool val)
+{
+	uint32_t off = 0x0100u + (pin / 32u) * 0x10u;
+	uint32_t bit = 1u << (pin % 32u);
+	uint32_t v = reg_rd(gpio_base, off);
+	reg_wr(gpio_base, off, val ? (v | bit) : (v & ~bit));
+}
+
+static void
+spi5_hw_init(void)
+{
+	/* clk26m (0) and clear PDN_SPI (bit 15) on TOPCKGEN CLK_CFG_5 */
+	reg_wr(topck_base, TOPCK_CLK_CFG_5_CLR, (0x3u << 8) | (1u << 15));
+	reg_wr(topck_base, TOPCK_CLK_CFG_UPDATE, (1u << 21));
+	reg_wr(infra_base, INFRA_SW_CG2_CLR, INFRA_CG2_SPI5_BIT);
+
+	/* GPIO1=INT(in), GPIO2=RST(kept high), GPIO35..38=SPI5_A (func 5) */
+	gpio_set_mode(1u, 0u);
+	gpio_set_dir(1u, false);
+	gpio_set_dout(2u, true);
+	gpio_set_mode(2u, 0u);
+	gpio_set_dir(2u, true);
+
+	gpio_set_mode(35u, 5u);
+	gpio_set_dir(35u, true);
+	gpio_set_mode(36u, 5u);
+	gpio_set_dir(36u, true);
+	gpio_set_mode(37u, 5u);
+	gpio_set_dir(37u, false);
+	gpio_set_mode(38u, 5u);
+	gpio_set_dir(38u, true);
+
+	/* 26 MHz / 6 = ~4.33 MHz, pad-select = 0 */
+	reg_wr(spi5_base, SPI_CMD_REG, SPI_CMD_RST);
+	reg_wr(spi5_base, SPI_CMD_REG, 0u);
+	reg_wr(spi5_base, SPI_PAD_SEL_REG, 0u);
+	reg_wr(spi5_base, SPI_CFG2_REG, ((3u - 1u) << 0) | ((3u - 1u) << 16));
+	reg_wr(spi5_base, SPI_CFG0_REG, ((6u - 1u) << 0) | ((6u - 1u) << 16));
+	reg_wr(spi5_base, SPI_CFG1_REG, 5u);
+}
+
+static int
+spi5_wait_status(void)
+{
+	for (uint32_t spin = 0; spin < 250000u; spin++) {
+		if (reg_rd(spi5_base, SPI_STATUS0_REG) & 3u) {
+			return 0;
+		}
+	}
+	return -1;
+}
+
+static int
+spi5_xfer(const uint8_t *tx, uint8_t *rx, uint32_t len)
+{
+	uint32_t base_cmd = SPI_CMD_TXMSBF | SPI_CMD_RXMSBF | SPI_CMD_FINISH_IE | SPI_CMD_PAUSE_IE;
+	uint32_t off = 0;
+
+	if (len == 0u) {
+		return 0;
+	}
+	reg_wr(spi5_base, SPI_CMD_REG, SPI_CMD_RST);
+	reg_wr(spi5_base, SPI_CMD_REG, 0u);
+	(void)reg_rd(spi5_base, SPI_STATUS0_REG);
+
+	while (off < len) {
+		uint32_t chunk = len - off;
+		bool has_more, is_first;
+		uint32_t cfg1;
+
+		if (chunk > SPI_FIFO_BYTES) {
+			chunk = SPI_FIFO_BYTES;
+		}
+		has_more = (off + chunk) < len;
+		is_first = (off == 0u);
+
+		cfg1 = reg_rd(spi5_base, SPI_CFG1_REG);
+		cfg1 &= ~0x03ffff00u;
+		cfg1 |= ((chunk - 1u) << 16);
+		reg_wr(spi5_base, SPI_CFG1_REG, cfg1);
+
+		for (uint32_t i = 0; i < chunk; i += 4u) {
+			uint32_t w = 0u;
+			uint32_t rem = chunk - i;
+			if (rem > 4u) {
+				rem = 4u;
+			}
+			if (tx != NULL) {
+				for (uint32_t b = 0; b < rem; b++) {
+					w |= ((uint32_t)tx[off + i + b]) << (b * 8u);
+				}
+			}
+			reg_wr(spi5_base, SPI_TX_DATA_REG, w);
+		}
+
+		reg_wr(spi5_base, SPI_CMD_REG,
+		    base_cmd | (has_more ? SPI_CMD_PAUSE_EN : 0u) | (is_first ? SPI_CMD_ACT : SPI_CMD_RESUME));
+
+		if (spi5_wait_status() != 0) {
+			reg_wr(spi5_base, SPI_CMD_REG, SPI_CMD_RST);
+			reg_wr(spi5_base, SPI_CMD_REG, 0u);
+			return -1;
+		}
+
+		for (uint32_t i = 0; i < chunk; i += 4u) {
+			uint32_t w = reg_rd(spi5_base, SPI_RX_DATA_REG);
+			if (rx != NULL) {
+				uint32_t rem = chunk - i;
+				if (rem > 4u) {
+					rem = 4u;
+				}
+				for (uint32_t b = 0; b < rem; b++) {
+					rx[off + i + b] = (uint8_t)(w >> (b * 8u));
+				}
+			}
+		}
+		off += chunk;
+	}
+	return 0;
+}
+
+static int
+nvt_set_page(uint32_t addr)
+{
+	uint8_t tx[3] = {
+		0xffu,
+		(uint8_t)((addr >> 15) & 0xffu),
+		(uint8_t)((addr >> 7) & 0xffu),
+	};
+	return spi5_xfer(tx, NULL, 3u);
+}
+
+static int
+nvt_read_reg(uint8_t reg_addr, uint8_t *out, uint32_t data_len)
+{
+	uint8_t tx[72];
+	uint8_t rx[72];
+	uint32_t total = data_len + 2u;
+
+	if (total > sizeof(tx)) {
+		return -1;
+	}
+	bzero(tx, total);
+	tx[0] = reg_addr & 0x7fu;
+	if (spi5_xfer(tx, rx, total) != 0) {
+		return -1;
+	}
+	memcpy(out, rx + 2, data_len);
+	return 0;
+}
+
+static bool
+nvt_probe_fw(uint8_t *fw_ver, uint16_t *pid)
+{
+	uint8_t info[16];
+	uint8_t pid_buf[2];
+
+	if (nvt_set_page(NVT_EVENT_BUF_ADDR | NVT_EVENT_FWINFO) != 0 ||
+	    nvt_read_reg(NVT_EVENT_FWINFO, info, sizeof(info)) != 0) {
+		return false;
+	}
+	if ((uint8_t)(info[0] + info[1]) != 0xffu || info[0] == 0u) {
+		return false;
+	}
+	*fw_ver = info[0];
+	*pid = 0;
+	if (nvt_set_page(NVT_EVENT_BUF_ADDR | NVT_EVENT_PROJECTID) == 0 &&
+	    nvt_read_reg(NVT_EVENT_PROJECTID, pid_buf, 2u) == 0) {
+		*pid = (uint16_t)(((uint16_t)pid_buf[1] << 8) | pid_buf[0]);
+	}
+	(void)nvt_set_page(NVT_EVENT_BUF_ADDR);
+	return true;
+}
+
+static void
+touch_sleep_ms(uint32_t ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&touch_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+begonia_touch_thread(__unused void *arg, __unused wait_result_t result)
+{
+	bool active[NVT_MAX_SLOTS];
+	uint16_t lx[NVT_MAX_SLOTS], ly[NVT_MAX_SLOTS];
+	uint8_t miss[NVT_MAX_SLOTS];
+	uint8_t fw_ver = 0;
+	uint16_t pid = 0;
+	bool ready = false;
+
+	bzero(active, sizeof(active));
+	bzero(lx, sizeof(lx));
+	bzero(ly, sizeof(ly));
+	bzero(miss, sizeof(miss));
+
+	spi5_hw_init();
+	for (uint32_t t = 0; t < 10u && !ready; t++) {
+		ready = nvt_probe_fw(&fw_ver, &pid);
+		if (!ready) {
+			touch_sleep_ms(100u);
+		}
+	}
+	if (!ready) {
+		printf("BEGONIA TOUCH: NT36672A FW not active in SRAM (boot via mtkloader dualboot to load FW); waiting paused\n");
+		return;
+	}
+	printf("BEGONIA TOUCH: NT36672A ready on SPI5 (pid=%#x fw=v%u poll=%ums)\n",
+	    pid, fw_ver, touch_poll_ms);
+
+	for (;;) {
+		uint8_t pts[65];
+		if (nvt_set_page(NVT_EVENT_BUF_ADDR) == 0 && nvt_read_reg(0x00u, pts, sizeof(pts)) == 0) {
+			bool seen[NVT_MAX_SLOTS];
+			bzero(seen, sizeof(seen));
+
+			for (uint32_t i = 0; i < NVT_MAX_SLOTS; i++) {
+				uint32_t pos = i * 6u;
+				uint8_t id = pts[pos] >> 3;
+				uint8_t state = pts[pos] & 0x07u;
+				if (id < 1u || id > NVT_MAX_SLOTS) {
+					continue;
+				}
+				uint32_t slot = id - 1u;
+				uint32_t x = ((uint32_t)pts[pos + 1u] << 4) | ((uint32_t)pts[pos + 3u] >> 4);
+				uint32_t y = ((uint32_t)pts[pos + 2u] << 4) | ((uint32_t)pts[pos + 3u] & 0x0fu);
+				if ((state == 1u || state == 2u) && x < PANEL_W && y < PANEL_H) {
+					seen[slot] = true;
+					miss[slot] = 0;
+					if (!active[slot] || lx[slot] != x || ly[slot] != y) {
+						active[slot] = true;
+						lx[slot] = (uint16_t)x;
+						ly[slot] = (uint16_t)y;
+						if (touch_log) {
+							printf("BEGONIA TOUCH: slot=%u down (%u,%u)\n", slot, x, y);
+						}
+						sweet_hid_touch((int)slot, 1, (int)x, (int)y);
+					}
+				} else if (state == 3u && active[slot]) {
+					active[slot] = false;
+					miss[slot] = 0;
+					if (touch_log) {
+						printf("BEGONIA TOUCH: slot=%u up (%u,%u)\n", slot, lx[slot], ly[slot]);
+					}
+					sweet_hid_touch((int)slot, 0, (int)lx[slot], (int)ly[slot]);
+				}
+			}
+			for (uint32_t slot = 0; slot < NVT_MAX_SLOTS; slot++) {
+				if (active[slot] && !seen[slot] && ++miss[slot] >= NVT_EMPTY_RELEASE) {
+					active[slot] = false;
+					miss[slot] = 0;
+					sweet_hid_touch((int)slot, 0, (int)lx[slot], (int)ly[slot]);
+				}
+			}
+		}
+		touch_sleep_ms(touch_poll_ms);
+	}
+}
+
+void
+begonia_touch_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+
+	if (touch_started || !sweet_board_begonia()) {
+		return;
+	}
+	touch_started = true;
+	(void)PE_parse_boot_argn("begoniatouch", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("begoniatouchlog", &touch_log, sizeof(touch_log));
+	(void)PE_parse_boot_argn("begoniatouchms", &touch_poll_ms, sizeof(touch_poll_ms));
+	if (touch_poll_ms < 1u || touch_poll_ms > 20u) {
+		touch_poll_ms = 8u;
+	}
+	if (!enabled) {
+		printf("BEGONIA TOUCH: disabled (begoniatouch=0)\n");
+		return;
+	}
+	topck_base = ml_io_map(BEGONIA_TOPCKGEN_PA, 0x1000u);
+	infra_base = ml_io_map(BEGONIA_INFRACFG_PA, 0x1000u);
+	gpio_base = ml_io_map(BEGONIA_GPIO_PA, 0x1000u);
+	spi5_base = ml_io_map(BEGONIA_SPI5_PA, 0x1000u);
+	if (!topck_base || !infra_base || !gpio_base || !spi5_base) {
+		printf("BEGONIA TOUCH: ml_io_map failed\n");
+		return;
+	}
+	if (kernel_thread_start(begonia_touch_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("BEGONIA TOUCH: kernel_thread_start failed\n");
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
